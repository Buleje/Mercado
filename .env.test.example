# ─────────────────────────────────────────────────────────────────
# .env.test.example — Variables para tests E2E (Playwright)
# Copia a .env.test y rellena con tus valores reales.
# NUNCA commitear .env.test (está en .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── DB ───────────────────────────────────────────────────────────
# Misma DATABASE_URL del .env local (Supabase o PostgreSQL local).
# El seed script usa esta variable para conectarse.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ── App URL (Playwright baseURL) ─────────────────────────────────
# Dev server local. Playwright lo usa como base de todas las rutas.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ── Admin QA (tenant main) ───────────────────────────────────────
# Usuario admin del tenant "main". Ya existe si corriste create-qa-admin-raw.mjs.
E2E_ADMIN_USER=qaadmin
E2E_ADMIN_PASSWORD=Qa-admin-1234

# ── Tenant slugs ─────────────────────────────────────────────────
# Tenant A: el tenant principal del dev local.
E2E_TENANT_A_SLUG=main
# Tenant B: segundo tenant para tests de aislamiento multi-tenant.
E2E_TENANT_B_SLUG=mi-pollo
# Vendor slug para storefront del marketplace.
# Obtener: slug de cualquier vendor activo en /marketplace.
E2E_VENDOR_SLUG=demo

# ── Tenant ID (UUID de "main") ───────────────────────────────────
# Obtener tras correr el seed: node scripts/e2e/seed-e2e.mjs
# El script imprime: "TENANT_ID=<uuid>"
E2E_TENANT_ID=<obtener-de-seed>

# ── Cliente E2E ──────────────────────────────────────────────────
# Cliente de prueba creado por el seed script.
E2E_CUSTOMER_PHONE=987654321
# DNI del cliente (para tests de compliance/export Ley 29733).
E2E_CUSTOMER_DNI=12345678
# Token JWT opcional — si no existe, los tests harán login via API.
# Obtener: POST /api/customers/login con E2E_CUSTOMER_PHONE → cookie value.
E2E_CUSTOMER_TOKEN=<obtener-tras-login>

# ── Cliente RTBF (descartable) ────────────────────────────────────
# DNI distinto al de exportación — este cliente SE BORRA en el test 4
# del spec privacidad-rtbf-l29733.spec.ts. El seed lo recrea cada run.
E2E_RTBF_CUSTOMER_DNI=99999999

# ── Repartidor E2E ────────────────────────────────────────────────
# Creado por el seed script como AdminUser con role="repartidor".
E2E_DELIVERY_USER=delivery_e2e
E2E_DELIVERY_PASSWORD=Delivery-2026-E2E
# ID de la orden asignada al repartidor — el seed la imprime al final.
# Obtener: node scripts/e2e/seed-e2e.mjs → "DELIVERY_ORDER_ID=<id>"
E2E_DELIVERY_ORDER_ID=<obtener-de-seed>

# ── WhatsApp / Twilio ─────────────────────────────────────────────
# Debe coincidir con TWILIO_AUTH_TOKEN del .env del servidor.
# En CI: usar un token de prueba o el mismo del entorno CI.
# Los tests de firma HMAC-SHA1 fallaran si este valor no coincide con el del server.
E2E_TWILIO_AUTH_TOKEN=<copiar-de-TWILIO_AUTH_TOKEN-del-.env>

# Token de verificación Meta WhatsApp webhook.
# Debe coincidir con WHATSAPP_VERIFY_TOKEN del .env del servidor.
E2E_WHATSAPP_VERIFY_TOKEN=<copiar-de-WHATSAPP_VERIFY_TOKEN-del-.env>
