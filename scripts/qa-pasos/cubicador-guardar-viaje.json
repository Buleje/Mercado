  {
   "eval": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].find(x=>x.innerText.includes('Agregar al directorio'));return d?{nombre:[...d.querySelectorAll('input')].map(i=>i.value).find(v=>v)||null,rolOn:[...d.querySelectorAll('button[aria-pressed=true]')].map(b=>b.textContent.trim())}:'sin alta'})()"
  },
  {
   "tecla": "Escape"
  },
  {
   "esperar": 600
  },
  {
   "eval": "(async()=>{const r=await fetch('/api/admin/forestal/cubicaciones',{credentials:'include'});const j=await r.json();const qa=(j.cubicaciones||[]).filter(c=>c.nombre==='QA viaje 28-10');const tok=document.cookie.split('; ').find(c=>c.startsWith('csrf-token='))?.split('=')[1];const out=[];for(const c of qa){const d=await fetch('/api/admin/forestal/cubicaciones?id='+encodeURIComponent(c.id),{method:'DELETE',credentials:'include',headers:{'x-csrf-token':decodeURIComponent(tok||'')}});out.push(d.status)}return {borradas:out}})()"
  }
 ]
}