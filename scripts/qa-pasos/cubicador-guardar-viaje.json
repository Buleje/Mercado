   "eval": "(()=>{Object.keys(localStorage).filter(k=>k.startsWith('buleje-cubicacion-main')).forEach(k=>localStorage.removeItem(k));const P=(id,c,e,a,l,esp)=>({id,cantidad:c,espesor:e,ancho:a,largo:l,uEspesor:'pulg',uAncho:'pulg',uLargo:'pies',especie:esp,pieTablar:e*a*l*c/12,m3:e*a*l*c/12/424});const k='buleje-cubicacion-main';localStorage.setItem(k,JSON.stringify([P('t1',40,2,8,10,'Tornillo'),P('t2',20,2,4,4,'Tornillo'),P('c1',30,2,6,10,'Cumala'),P('c2',10,1,6,4,'Cumala')]));localStorage.setItem(k+'-modo-precio','manual');localStorage.setItem(k+'-precio','2');localStorage.setItem(k+'-precios-especie',JSON.stringify({tornillo:'2.5'}));localStorage.setItem(k+'-precios-especie-tipo',JSON.stringify({'tornillo|Corta':'1.5'}));location.reload();return 'sembrado'})()"
  },
  {
