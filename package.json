    "next-sitemap": "^4.2.3",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.3",
    "react-window": "^1.8.10",
    "recharts": "^3.8.0",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
