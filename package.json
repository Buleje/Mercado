{
  "name": "buleje",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/predev-cache-guard.mjs",
    "dev": "next dev --turbopack",
    "dev:fast": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node scripts/kill-dev-port.mjs & del /f /q .next\\dev\\lock 2>nul & next dev --turbopack",
    "dev:nuke": "node scripts/kill-dev-port.mjs & rmdir /s /q .next 2>nul & next dev --turbopack",
    "dev:kill": "node scripts/kill-dev-port.mjs",
    "dev:warm": "node scripts/warm-dev-routes.mjs",
    "dev:zombies": "node scripts/dev-guardian.mjs",
    "dev:zombies:dry": "cross-env DRY_RUN=1 node scripts/dev-guardian.mjs",
    "dev:monitor": "node scripts/dev-monitor.mjs",
    "dev:duplicates": "node scripts/find-duplicates.mjs",
    "dev:dangers": "node scripts/list-danger-zones.mjs",
    "dev:dangers:check": "node scripts/check-zone-skills.mjs",
    "dev:health": "node scripts/dev-health.mjs",
    "dev:health:fast": "cross-env SKIP_TESTS=1 node scripts/dev-health.mjs",
    "health:check": "node scripts/check-prod-health.mjs",
    "db:sanity": "tsx scripts/db-sanity.ts",
    "db:drift": "node -r dotenv/config scripts/check-schema-drift.mjs dotenv_config_path=.env.local",
    "dev:lucide:audit": "node scripts/audit-lucide-imports.mjs",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "lint:design": "tsx scripts/lint-design-tokens.ts",
    "lint:design:warn": "tsx scripts/lint-design-tokens.ts --warn",
    "lint:design:staged": "tsx scripts/lint-design-tokens.ts --staged",
    "lint:design:fix": "tsx scripts/migrate-decorative-colors.ts",
    "lint:design:fix:apply": "tsx scripts/migrate-decorative-colors.ts --apply",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "vitest run __tests__/security/",
    "test:load": "k6 run k6/superadmin.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:migrate": "prisma migrate dev",
    "db:cleanup-fake-tenants": "tsx scripts/cleanup-fake-tenants.ts",
    "cap:init": "npx cap init \"Buleje\" pe.buleje.app --web-dir out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "app:build": "next build && npx cap sync",
    "app:build:android": "next build && npx cap sync android && npx cap open android",
    "prepare": "husky",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --only-changed --exit-zero-on-changes",
    "queue:workers": "tsx lib/queue/workers.ts",
    "sentry:setup-alerts": "tsx scripts/setup-sentry-alerts.ts",
    "redis:health": "node -e \"fetch('http://localhost:3000/api/admin/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Dev server not running — inicia con: npm run dev'))\"",
    "audit:tenant": "node scripts/audit-tenant-isolation.mjs",
    "audit:cross-tenant": "node scripts/audit-cross-tenant.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/openai": "^3.0.52",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/geolocation": "^8.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
