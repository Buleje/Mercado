{
  "name": "buleje",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "taskkill //F //IM node.exe 2>nul & del /f /q .next\\dev\\lock 2>nul & next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "k6 run k6/superadmin.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:migrate": "prisma migrate dev",
    "cap:init": "npx cap init \"Buleje\" pe.buleje.app --web-dir out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "app:build": "next build && npx cap sync",
    "prepare": "husky"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ericblade/quagga2": "^1.12.1",
    "@lottiefiles/dotlottie-react": "^0.18.6",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/nextjs": "^10.43.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tiptap/extension-color": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.11",
    "@types/react-window": "^1.8.8",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "geist": "^1.7.0",
    "gsap": "^3.14.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.577.0",
