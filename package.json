    "webpack": "^5.105.4"
  },
  "lint-staged": {
    "components/{admin,store,ui-system,customer}/**/*.{ts,tsx}": [
      "tsx scripts/lint-design-tokens.ts"
    ],
    "app/t/**/*.{ts,tsx}": [
      "tsx scripts/lint-design-tokens.ts"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 0.5%",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
