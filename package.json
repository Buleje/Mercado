{
  "name": "buleje",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "taskkill //F //IM node.exe 2>nul & del /f /q .next\\dev\\lock 2>nul & next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "k6 run k6/superadmin.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:migrate": "prisma migrate dev",
    "db:cleanup-fake-tenants": "tsx scripts/cleanup-fake-tenants.ts",
    "cap:init": "npx cap init \"Buleje\" pe.buleje.app --web-dir out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "app:build": "next build && npx cap sync",
    "prepare": "husky",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "queue:workers": "tsx lib/queue/workers.ts",
    "sentry:setup-alerts": "tsx scripts/setup-sentry-alerts.ts",
    "redis:health": "node -e \"fetch('http://localhost:3000/api/admin/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(()=>console.log('Dev server not running — inicia con: npm run dev'))\""
  },
