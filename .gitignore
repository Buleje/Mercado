# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.preview

# vercel
.vercel

# Agent skills (per-machine install via `skills add ...`)
.agents/
.windsurf/skills/
skills-lock.json

# Session handoff files: human-readable session notes that may include
# transient secrets, API keys o tokens al hacer copy-paste de logs.
# Mantener fuera del repo aunque hagamos un commit accidental.
*HANDOFF*.md
SESSION_HANDOFF*.md

# Claude Code — trackeamos .claude/ (agents, skills, hooks, settings.json)
# porque forman parte del plugin bodega-claude-pack (ver .claude-plugin/plugin.json).
# Ignoramos solo artefactos locales per-machine:
/.claude/worktrees/
/.claude/.last-stop-checkpoint.json
/.claude/.last-session-id
/.claude/**/.tmp/
/.claude/skills/*/\.tmp/
# Runtime metrics y handoffs — local per-session only
/.claude/metrics/
/.claude/session_handoff.md
/.husky/.last-test-run.log
/.husky/.last-test-run.FAILED
/.husky/.showcase-auto-pending
# Symlinks heredados del layout viejo (.agents/) quedan ignorados por la línea .agents/ arriba
/.claude/skills/supabase
/.claude/skills/supabase-postgres-best-practices
# Per-session state and learning data (regenerated per session/machine)
/.claude/.state/
/.claude/learning/
/.claude/session-state.json
/.claude/agent-memory/
/.claude/cache/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/.watchdog.log
/.claude/.watchdog.pid
/.claude/.mem-guard.log

# Phase 3 runtime artifacts (never commit)
/backups/db/*.sql
/backups/db/*.sql.gz
/logs/sentry-loop/*.json
!/logs/sentry-loop/dedup-registry.json
/reports/finops/*.md
/docs/showcase/**/
/.worktrees/

# MCP server node_modules
/tools/mcp-bodega/node_modules/
/tools/mcp-bodega/dist/
/tools/mcp-bodega/.env

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Local runtime data (real customer/order/product JSON — never commit)
/local-data/

# Backup files
*.bak
*.bak.*

# Playwright
/.playwright-output/
/test-results/
/playwright-report/

# Debug/test scripts
test-prisma.mjs

# Build & dev output logs (large, not useful in repo)
dev-output.txt
build-output.txt

.vercel

# Storybook static build output (regenerated by `npm run storybook:build`)
/storybook-static/

# Local Claude Code worktrees (per-machine, not shared)
/.claude/worktrees/

# Debug screenshots (use docs/ if a screenshot needs to live in the repo)
/shot-*.png
/screenshot-*.png
# Exploration screenshots at root (Playwright artifacts during dev — never commit)
/*.png
/*.jpg
/*.jpeg
/*.pdf
# Scratch de sesión en la raíz (mediciones, snaps sueltos, one-liners de debug)
/_*.mjs
/.*.mjs
/snap-*.mjs
# Playwright MCP working directory (exploration artifacts)
/.playwright-mcp/
# Snapshots de accesibilidad volcados a mano durante debug con Playwright
/snap*.md
# Directorios de scratch de sesión (fixtures de subida, corridas de prueba)
/.scratch-*/
# Scripts de un solo uso: se escriben para una corrida y no se vuelven a correr
/*.tmp.ts
/scripts/tmp-*.ts
# Vitest JSON reports (local per-session debugging)
/vitest-result*.json
/vitest-full.json
/vitest-auth.json
/vitest-proxy.json
/vitest-tenant*.json
/v-*.json
# Superpowers brainstorm drafts (per-session, not shared)
/.superpowers/brainstorm/

build-task003.log

# Local Twilio dev SQLite
/data/twilio.db

# Ad-hoc QA scripts (per-session, not shared)
/scripts/.qa-*.mjs
/scripts/.qa-output/
/scripts/.inspect-page.mjs

# tsc debounce lock (per-machine runtime)
/.claude/.tsc-debounce.lock
/.claude/.screenshot-debounce.lock

# Local MCP server config (per-machine)
/.mcp.json

# Personal notes (root-level scratchpads)
/notas-*.txt

.env*.local
lint-compact.txt
lint-output.txt
tsc-errors.log
check-tenants.sql
# reports/ = artefactos transitorios de verificación (screenshots, audits, snaps de
# scripts/visual-verify-*.mjs y scripts/audit-*.mjs). Se regeneran corriendo el script;
# no se versionan. La única excepción son los baselines de regresión visual.
# Lo ya trackeado antes de esta regla sigue trackeado (git ignora .gitignore para el índice).
reports/**
!reports/visual-baselines/
!reports/visual-baselines/**

# Claude Code session metrics — JSON regenerado en cada agente run.
.claude/agent-metrics.json

# Lighthouse Chrome temp dirs (Windows path leaked into WSL)
C:*lighthouse.*
lighthouse.*

# Runtime data JSONs (analytics, clicks) — generados por endpoints en disco,
# no son código. Schemas y seeds iniciales sí se versionan.
lib/data/marketplace-category-clicks.json
lib/data/*-runtime.json
lib/data/store-extras.json

# RLS credentials (passwords reales — nunca commitear)
docs/security/rls-credentials-*.md
!docs/security/rls-credentials-TEMPLATE.md

# Vercel env backups (contienen secrets — NUNCA commitear)
docs/security/vercel-env-backups/

# Skill telemetry (runtime, no commitear)
.claude/.skill-usage.jsonl
.claude/.skill-usage.jsonl.1

# Claude Code — artefactos runtime/zombie (audit 2026-06-02)
/.claude/_archive-swarm/
/.claude/hub-metrics/
/.claude/agents-dashboard/
/.claude/learnings/
/.claude/agent-memory/
/.claude/evolution-log.json
/.claude/a2a-state.json
/.claude/*.bak
/.claude/skills/**/*.bak
/.claude/hooks/**/*.bak

# Backups de .next que dejan los nukes/restarts de dev (no son fuente).
/.next.old*
/.next.*-bak
/.next.bak*
# .claude anidados dentro de app/ no son del plugin root (cruft de agentes).
app/**/.claude/
scripts/.backup-base64-images.json
scripts/dev-helpers/_measure-nav-heights.mjs

# ── Artefactos del sandbox / accidentes (2026-06-24) ─────────────────────────
# Mounts read-only que el sandbox de Claude Code deja en el working tree (no se
# pueden borrar desde dentro del sandbox). Se ignoran para que no se commiteen:
#  • ${CLAUDE_PROJECT_DIR}/ = dir con nombre de variable sin expandir (.env→/dev/null)
#  • dotfiles 0-byte en la raíz = bind-mounts (los reales viven en $HOME, no acá)
${CLAUDE_PROJECT_DIR}/
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.ripgreprc
/.gitconfig
/.idea
# Backup de prune de settings (.bak-prune no lo cubría /.claude/*.bak).
/.claude/*.bak-*

# credenciales temporales IBKR (se shredean tras el setup)
.ibkr-stdin
.ibkr-creds.env

# log runtime de qdrant local
.qdrant-runtime.log

# attachments de vitest browser mode (diffs de VRT fallidos)
.vitest-attachments/

# Config del agente de sync de escritorio (ADR-307): contiene la API key
tools/buleje-sync/buleje-sync.config.json
.tmp-qa/

# Capturas del hook post-edit-ui-screenshot (regenerables, ~1 GB/mes)
reports/visual-verify/
