# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.preview

# vercel
.vercel

# Agent skills (per-machine install via `skills add ...`)
.agents/
.windsurf/skills/
skills-lock.json

# Claude Code — trackeamos .claude/ (agents, skills, hooks, settings.json)
# porque forman parte del plugin bodega-claude-pack (ver .claude-plugin/plugin.json).
# Ignoramos solo artefactos locales per-machine:
/.claude/worktrees/
/.claude/.last-stop-checkpoint.json
/.claude/.last-session-id
/.claude/**/.tmp/
/.claude/skills/*/\.tmp/
# Runtime metrics y handoffs — local per-session only
/.claude/metrics/
/.claude/session_handoff.md
/.husky/.last-test-run.log
/.husky/.last-test-run.FAILED
/.husky/.showcase-auto-pending
# Symlinks heredados del layout viejo (.agents/) quedan ignorados por la línea .agents/ arriba
/.claude/skills/supabase
/.claude/skills/supabase-postgres-best-practices
# Per-session state and learning data (regenerated per session/machine)
/.claude/.state/
/.claude/learning/
/.claude/session-state.json
/.claude/agent-memory/
/.claude/cache/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Phase 3 runtime artifacts (never commit)
/backups/db/*.sql
/backups/db/*.sql.gz
/logs/sentry-loop/*.json
!/logs/sentry-loop/dedup-registry.json
/reports/finops/*.md
/docs/showcase/**/
/.worktrees/

# MCP server node_modules
/tools/mcp-bodega/node_modules/
/tools/mcp-bodega/dist/
/tools/mcp-bodega/.env

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Local runtime data (real customer/order/product JSON — never commit)
/local-data/

# Backup files
*.bak
*.bak.*

# Playwright
/.playwright-output/
/test-results/
/playwright-report/

# Debug/test scripts
test-prisma.mjs

# Build & dev output logs (large, not useful in repo)
dev-output.txt
build-output.txt

.vercel

# Storybook static build output (regenerated by `npm run storybook:build`)
/storybook-static/

# Local Claude Code worktrees (per-machine, not shared)
/.claude/worktrees/

# Debug screenshots (use docs/ if a screenshot needs to live in the repo)
/shot-*.png
/screenshot-*.png
# Exploration screenshots at root (Playwright artifacts during dev — never commit)
/*.png
/*.jpg
/*.jpeg
# Playwright MCP working directory (exploration artifacts)
/.playwright-mcp/
# Vitest JSON reports (local per-session debugging)
/vitest-result*.json
/vitest-full.json
/vitest-auth.json
/vitest-proxy.json
/vitest-tenant*.json
/v-*.json
# Superpowers brainstorm drafts (per-session, not shared)
/.superpowers/brainstorm/

build-task003.log

.env*.local
lint-compact.txt
lint-output.txt
tsc-errors.log
check-tenants.sql
reports/smoke-test/
reports/baseline/2026-04-17-ds-sprint-c/lint-design-tokens-pre.txt
