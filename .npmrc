legacy-peer-deps=true

# === Velocidad de install ===
fund=false
audit=false
update-notifier=false
progress=false
loglevel=warn
prefer-offline=true

# === Paralelismo (10 jobs, deja 2 cores al host de 12) ===
jobs=10

# === Engine strict — respeta engines de package.json ===
engine-strict=true

# === Cache compartido (evita re-descargas entre worktrees) ===
cache=/home/usuario/.npm-cache
