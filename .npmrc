legacy-peer-deps=true

# === Velocidad de install ===
fund=false
audit=false
update-notifier=false
progress=false
loglevel=warn
prefer-offline=true

# === Paralelismo (10 jobs, deja 2 cores al host de 12) ===
jobs=10

# === Engine strict — respeta engines de package.json ===
engine-strict=true

# Nota: el cache compartido entre worktrees se setea por usuario en
# ~/.npmrc (variable absoluta como /home/usuario/.npm-cache no portable
# a CI runners de GitHub Actions). Si querés mantenerlo local, agrega
# `cache=$HOME/.npm-cache` a tu ~/.npmrc — no a este archivo del repo.
