# ==============================================
# 🔐 ENVIRONMENT VARIABLES - BODEGA SAN MARTÍN
# ==============================================
# Copia este archivo a .env.local y completa los valores

# ----------------------------------------------
# 📊 BASE DE DATOS (Supabase PostgreSQL)
# ----------------------------------------------
# Obtén tu URL de conexión en: https://app.supabase.com/project/_/settings/database
# Formato: postgresql://postgres:[PASSWORD]@[HOST]/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/database"

# ----------------------------------------------
# 🔑 SUPABASE (Cliente público)
# ----------------------------------------------
# Obtén tus keys en: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ----------------------------------------------
# 🔒 AUTENTICACIÓN (JWT Secret)
# ----------------------------------------------
# Genera con: openssl rand -base64 32
# CRÍTICO: Cambia este valor en producción
AUTH_SECRET="CHANGE-THIS-TO-A-RANDOM-SECRET-32-CHARS-MIN"

# ----------------------------------------------
# 📧 EMAIL (SMTP - Opcional)
# ----------------------------------------------
# Para Gmail: https://support.google.com/accounts/answer/185833
# Usa "App Passwords" en configuración de seguridad
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password-de-16-caracteres"
NOTIFY_EMAIL="notificaciones@bodegasanmartin.com"

# ----------------------------------------------
# 🔔 PUSH NOTIFICATIONS (Opcional)
# ----------------------------------------------
# Genera VAPID keys con: npx web-push generate-vapid-keys
VAPID_EMAIL="mailto:contacto@bodegasanmartin.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# ----------------------------------------------
# 💬 WHATSAPP API (Opcional)
# ----------------------------------------------
# Para integración de notificaciones automáticas vía WhatsApp
WHATSAPP_API_URL="https://graph.facebook.com/v17.0/YOUR_PHONE_ID/messages"
WHATSAPP_API_TOKEN="tu-api-token-de-whatsapp-business"

# ----------------------------------------------
# 📊 ANALYTICS (Opcional pero recomendado)
# ----------------------------------------------
# Google Analytics 4 - https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager - https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity - https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ----------------------------------------------
# 🌐 BASE URL
# ----------------------------------------------
# URL base de la aplicación (para emails, WhatsApp, etc.)
# DESARROLLO:
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# PRODUCCIÓN: Cambiar a tu dominio
SITE_URL=https://www.bodegasanmartin.pe

# ----------------------------------------------
# 🚀 OTRAS CONFIGURACIONES
# ----------------------------------------------
# Entorno (Next.js lo detecta automáticamente)
# NODE_ENV="development" | "production" | "test"

# Desactiva telemetry de Next.js (opcional)
# NEXT_TELEMETRY_DISABLED=1

# Logging level (opcional)
# LOG_LEVEL="info" | "debug" | "warn" | "error"

# ----------------------------------------------
# 🔑 AUTENTICACIÓN ADMIN
# ----------------------------------------------
# Contraseña del panel admin (bcrypt hash o plain según lib/session.ts)
ADMIN_PASSWORD="tu-password-admin-seguro"

# ----------------------------------------------
# ⏰ CRON JOBS (webhook replay, alertas, etc.)
# ----------------------------------------------
# Genera con: openssl rand -hex 32
# Usado en: /api/billing/webhook-replay, /api/cron/*
CRON_SECRET="tu-cron-secret-seguro-32-chars-min"

# ----------------------------------------------
# 💳 STRIPE (pagos y suscripciones)
# ----------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ----------------------------------------------
# 🐛 SENTRY (monitoreo de errores — opcional)
# ----------------------------------------------
# Obtén el DSN en: https://sentry.io/settings/PROJECT/keys/
NEXT_PUBLIC_SENTRY_DSN="https://xxx@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="tu-org-slug"
SENTRY_PROJECT="bodega-san-martin"

# ----------------------------------------------
# 🧾 SUNAT / NUBEFACT (facturación electrónica)
# ----------------------------------------------
# PSE (Proveedor de Servicios Electrónicos): Nubefact — https://www.nubefact.com
# Obtén tu token en: https://app.nubefact.com/configuracion/token
# URL formato: https://api.nubefact.com/api/v1/{RUC}/comprobantes
SUNAT_API_URL="https://api.nubefact.com/api/v1/TU_RUC/comprobantes"
SUNAT_API_TOKEN="tu-token-de-nubefact"
# Datos del emisor (aparecen en el comprobante)
SUNAT_RUC="20000000000"
SUNAT_RAZON_SOCIAL="BODEGA SAN MARTIN"
SUNAT_DIRECCION="Jr. San Martin 123, Pucallpa, Ucayali"

# ----------------------------------------------
# 🤖 LLM / IA (Groq + Vercel AI Gateway)
# ----------------------------------------------
# Groq directo (legacy — usar solo si AI_GATEWAY_API_KEY no está definido):
# Obtén tu key en: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
#
# Vercel AI Gateway (recomendado 2026-04-08):
# - En deploys de Vercel, VERCEL_OIDC_TOKEN se inyecta automáticamente (no hacer nada)
# - En dev local, `vercel env pull .env.local --yes` lo escribe con ~12h de vida
# - Alternativa: API key explícita desde https://vercel.com/dashboard/ai-gateway
# Si AI_GATEWAY_API_KEY está definida, tiene prioridad sobre OIDC.
# AI_GATEWAY_API_KEY="vai_..."
# Modelos sugeridos (routing por tipo de tarea):
#  - Chat con cliente / streaming: "groq/llama-3.3-70b-versatile"
#  - Análisis / razonamiento: "anthropic/claude-sonnet-4-5"
#  - Descripciones / embeddings: "openai/text-embedding-3-small"

# ----------------------------------------------
# 📦 WHATSAPP BUSINESS CLOUD API (Meta)
# ----------------------------------------------
# Panel de configuración: https://developers.facebook.com/apps/
# Token permanente de system user (no el temporal de 24h):
WHATSAPP_API_TOKEN="EAAG..."
# Phone number ID que Meta te asigna al registrar el número business:
WHATSAPP_PHONE_NUMBER_ID="123456789"
# App Secret para verificar la firma HMAC de los webhooks:
WHATSAPP_APP_SECRET="xxxxx"
# Verify token (string random que vos inventás — se usa en la URL del webhook):
WHATSAPP_VERIFY_TOKEN="your-random-verify-token-here"
# Business account ID (para subir templates y catálogo vía Graph API):
WHATSAPP_BUSINESS_ACCOUNT_ID="987654321"

# ----------------------------------------------
# 💳 STRIPE + STRIPE CONNECT (marketplace bilateral)
# ----------------------------------------------
# Obtén las keys en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret (para verificar eventos):
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect (para payouts a las bodegas del marketplace):
STRIPE_CONNECT_CLIENT_ID="ca_..."

# ----------------------------------------------
# 💰 MERCADOPAGO (pagos Perú + subscriptions)
# ----------------------------------------------
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"

# ----------------------------------------------
# 🆔 RENIEC (validación DNI Perú)
# ----------------------------------------------
# Provider: API Peru (o similar). Verificar el fallback en lib/reniec.ts
RENIEC_API_URL="https://api.apis.net.pe/v2/reniec/dni"
RENIEC_API_TOKEN="tu-token"

# ----------------------------------------------
# 🚚 DELIVERY / MAPAS (opcional)
# ----------------------------------------------
# Google Maps Platform (geocoding + distance matrix) — si se activa features de mapas server-side
GOOGLE_MAPS_API_KEY=""

# ----------------------------------------------
# 🔔 PUSH NOTIFICATIONS (VAPID para Web Push)
# ----------------------------------------------
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BN..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:contacto@buleje.pe"

# ----------------------------------------------
# ⚡ REDIS (cache híbrido — opcional, fallback a memoria local)
# ----------------------------------------------
# Si no está definido, lib/cache.ts usa MemoryStore del proceso.
# En producción conviene activarlo (Upstash Redis es barato y sin infra).
REDIS_URL=""

# ----------------------------------------------
# 🕐 CRON SECRET (validar webhooks de Vercel Cron)
# ----------------------------------------------
# Cualquier string random de 32+ caracteres. Los cron handlers verifican
# Authorization: Bearer ${CRON_SECRET} para rechazar llamadas externas.
CRON_SECRET="change-me-to-random-32-char-string"

# ----------------------------------------------
# 📊 ANALYTICS (opcional)
# ----------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_GTM_ID=""

# ----------------------------------------------
# 🧪 TESTS E2E (solo CI / local — NUNCA en producción)
# ----------------------------------------------
# Contraseña del admin usada en los tests Playwright autenticados.
# Si no está definida, los tests de admin se saltarán automáticamente (test.skip).
E2E_ADMIN_PASSWORD="tu-password-admin-igual-que-ADMIN_PASSWORD"

# ==============================================
# 📝 NOTA — env vars del Plan Maestro 24 semanas (Sprint 2+):
# ==============================================
