{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm ci",
  "functions": {
    "app/api/**": {
      "maxDuration": 30
    },
    "app/api/cron/churn-score/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/agent-tasks/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/demand-forecast/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/marketplace-stockout-predictions/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/marketplace-anomaly-detection/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/credit-score-recalc/route.ts": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/dlq-retry",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/stock-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/birthday-coupons",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 21 * * *"
    },
    {
