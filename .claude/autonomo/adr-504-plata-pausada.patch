+// ── La plata de UNA guía = N° + permiso (ADR-504 paso 2) ──────────────────────
+
+const ESTADOS_SIN_INGRESO = ["anulado", "rechazado"] as const;
+
+/** Un ingreso con ese N°, visto como guía: N° + permiso (y cómo nombrarlo en la pantalla). */
+export interface GuiaDelNumero extends GuiaRef {
+  /** El ingreso (`WoodEntry.id`): con éstos la pantalla abre la guía («Asignar permiso»). */
+  id: string;
+  gtfNumber: string;
+  contratoId: string | null;
+  /** Código del permiso (`null` = sin permiso). */
+  permiso: string | null;
+  titular: string | null;
+}
+
+/**
+ * Los ingresos que pueden ser ESA guía (cola del N° + `puedeSerLaMismaGtf`, la
+ * regla de los frenos de plata), con su permiso. Los vivos; si no queda
+ * ninguno vivo, los anulados (una guía anulada se lee igual).
+ */
+export async function guiasDelNumero(
+  db: Pick<Prisma.TransactionClient, "woodEntry">,
+  tenantId: string,
+  gtf: string | null | undefined,
+): Promise<GuiaDelNumero[]> {
+  if (!tenantId) throw new Error("tenantId is required");
+  const numero = (gtf ?? "").trim();
+  const filtro = filtroMismaGuia(numero);
+  if (!filtro) return [];
+  const filas = await db.woodEntry.findMany({
+    where: { tenantId, gtfNumber: filtro, deletedAt: null },
+    select: {
+      id: true,
+      gtfNumber: true,
+      contratoId: true,
+      status: true,
+      providerName: true,
+      contrato: { select: { tenantId: true, codigo: true, titularNombre: true } },
+    },
+    take: 2000,
+  });
+  const mias = filas.filter((f) => f.gtfNumber != null && (f.gtfNumber.trim() === numero || puedeSerLaMismaGtf(f.gtfNumber, numero)));
+  const vivas = mias.filter((f) => !(ESTADOS_SIN_INGRESO as readonly string[]).includes(f.status));
+  return (vivas.length > 0 ? vivas : mias).map((f) => {
+    /* El código y el titular del permiso sólo si es de ESTE negocio: van a la
+       respuesta (candidatas del 409) y un FK cruzado no debe filtrar datos ajenos. */
+    const contrato = f.contrato?.tenantId === tenantId ? f.contrato : null;
+    return {
+      id: f.id,
+      gtfNumber: (f.gtfNumber ?? "").trim(),
+      contratoId: f.contratoId ?? null,
+      permiso: contrato?.codigo ?? null,
+      titular: contrato?.titularNombre ?? f.providerName ?? null,
+    };
+  });
+}
+
+/** ¿Alguna guía con ese N° (la vara de los frenos) es de ese permiso? Los frenos sólo acotan por permiso si es así. */
+export async function existeGuiaDelPermiso(
+  db: Pick<Prisma.TransactionClient, "woodEntry">,
+  tenantId: string,
+  gtf: string | null | undefined,
+  contratoId: string,
+): Promise<boolean> {
+  if (!tenantId) throw new Error("tenantId is required");
+  return (await guiasDelNumero(db, tenantId, gtf)).some((g) => g.contratoId === contratoId);
+}
