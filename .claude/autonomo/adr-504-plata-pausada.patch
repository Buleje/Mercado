+/** Una guía sin permiso que frena la plata: su N° como está en el libro y sus ingresos (para abrirla y declararle el permiso). */
+export interface GuiaSinPermisoQueFrena {
+  gtfNumber: string;
+  woodEntryIds: string[];
+  titular: string | null;
+}
+
+/** Agrupa por N° exacto los ingresos sin permiso que frenan (los con permiso no entran). */
+export function guiasSinPermisoQueFrenan(guias: readonly GuiaDelNumero[]): GuiaSinPermisoQueFrena[] {
+  const porNumero = new Map<string, GuiaSinPermisoQueFrena>();
+  for (const g of guias) {
+    if (g.contratoId != null) continue;
+    const previa = porNumero.get(g.gtfNumber);
+    if (previa) {
+      if (!previa.woodEntryIds.includes(g.id)) previa.woodEntryIds.push(g.id);
+      previa.titular ??= g.titular;
+    } else {
+      porNumero.set(g.gtfNumber, { gtfNumber: g.gtfNumber, woodEntryIds: [g.id], titular: g.titular });
+    }
+  }
+  return [...porNumero.values()];
+}
+
+/**
+ * Mientras viva el índice viejo (UN abono `madera` por N°, sin permiso — se
+ * borra en el paso 3 de ADR-504), la misma guía de OTRO permiso no puede
+ * anotarse en la cuenta: la base lo rechaza. Mensaje claro en vez de un 500.
+ */
+export class PlataEnOtroPermisoError extends Error {
+  readonly codigo = "GUIA_EN_OTRO_PERMISO" as const;
+  readonly status = 409 as const;
+  constructor(readonly gtfNumber: string) {
+    super(
+      `La guía N° ${gtfNumber.trim()} ya tiene su madera anotada en la cuenta con otro permiso. Todavía no se pueden anotar dos guías con el mismo N°: quita la anotación de la otra o anota ésta sin la cuenta.`,
+    );
+    this.name = "PlataEnOtroPermisoError";
+  }
+}
+
+/**
+ * La respuesta HTTP de los tres «no» de la guía por permiso (ADR-504), igual en
+ * todas las rutas de plata: 409 con el código y, si es ambigua, las candidatas
+ * para que la pantalla pregunte de qué permiso es. `null` = no es de éstos.
+ */
+export function respuestaGuiaPorPermiso(e: unknown): { status: 409; body: RespuestaGuiaPorPermiso } | null {
+  if (e instanceof GuiaAmbiguaError) {
+    return { status: 409, body: { error: "GUIA_AMBIGUA", message: e.message, candidatas: e.candidatas } };
+  }
+  if (e instanceof GuiaSinPermisoFrenaError) {
+    /* La guía que frena, para que «Asignar permiso» la abra: su N° y sus ingresos
+       (la primera; `guias` trae todas si el N° corto calza en dos series). */
+    const primera = e.guiasSinPermiso[0];
+    return {
+      status: 409,
+      body: {
+        error: e.codigo,
+        message: e.message,
+        gtfNumber: primera?.gtfNumber ?? e.gtfNumber,
+        woodEntryIds: primera?.woodEntryIds ?? [],
+        guias: e.guiasSinPermiso,
+      },
+    };
+  }
+  if (e instanceof PlataEnOtroPermisoError) {
+    return { status: 409, body: { error: e.codigo, message: e.message } };
+  }
+  return null;
+}
+
+/** El cuerpo del 409 de `respuestaGuiaPorPermiso`. */
+export interface RespuestaGuiaPorPermiso {
+  error: string;
+  message: string;
+  /** `GUIA_AMBIGUA`: las guías entre las que elegir el permiso. */
+  candidatas?: unknown[];
+  /** `GUIA_SIN_PERMISO_FRENA`: el N° de la guía sin permiso que frena… */
+  gtfNumber?: string;
+  /** …sus ingresos… */
+  woodEntryIds?: string[];
+  /** …y todas, si son más de una. */
+  guias?: GuiaSinPermisoQueFrena[];
+}
+
+/** ¿Es el «ya existe» de la base (P2002)? Sin importar el cliente de Prisma: este archivo sólo usa sus tipos. */
+export function esChoqueDeUnico(e: unknown): boolean {
+  return typeof e === "object" && e != null && (e as { code?: unknown }).code === "P2002";
+}
+
+/**
+ * La guía cuya plata se toca, con la regla estricta de ADR-504
+ * (`decidirPlataDeGuia`): N° solo con dos permisos → `GuiaAmbiguaError` (409
+ * con las candidatas); una guía SIN permiso con ese N° → al escribir
+ * `GuiaSinPermisoFrenaError`, al leer `frenadaPor`. Dentro de la tx del que
+ * escribe, bajo el candado de la guía.
+ */
+export async function resolverPlataDeGuia(
+  db: Pick<Prisma.TransactionClient, "woodEntry">,
+  tenantId: string,
+  ref: GuiaRef,
+  uso: "leer" | "escribir",
+): Promise<PlataDeGuia> {
+  if (!tenantId) throw new Error("tenantId is required");
+  const gtf = (ref.gtfNumber ?? "").trim();
+  const crudo = ref.contratoId?.trim() || null;
+  const guias = await guiasDelNumero(db, tenantId, gtf);
+  if (crudo === SIN_PERMISO) return plataDeLaGuiaSinPermiso(gtf, guias);
+  const pedido = crudo;
+  const d = decidirPlataDeGuia({ gtfNumber: gtf, contratoId: pedido }, guias);
+  if (d.estado === "ambigua") throw new GuiaAmbiguaError(gtf, d.candidatas, mensajeGuiaAmbigua(gtf, d.candidatas));
+  if (d.estado === "bloquea-por-guia-sin-permiso") {
+    if (uso === "escribir") throw new GuiaSinPermisoFrenaError(gtf, d.guias);
+    return { gtfNumber: gtf, contratoId: pedido, unica: false, frenadaPor: d.guias };
+  }
+  const permisos = new Set(guias.map((g) => g.contratoId ?? ""));
+  const unica = permisos.size === 0 || (permisos.size === 1 && (guias[0]?.contratoId ?? null) === d.contratoId);
+  return { gtfNumber: gtf, contratoId: d.contratoId, unica, frenadaPor: null };
+}
+
+/**
+ * «∅» pedido a propósito (la ventana «¿De qué permiso?», opción «sin permiso»):
+ * la guía SIN permiso con ese N°, aunque el N° esté también en otro permiso.
+ * Ella no se frena a sí misma; sus frenos de doble pago siguen en las
+ * primitivas (`cubicacionQuePagoLaGuia` con permiso `null` mira todo el N°; el
+ * índice viejo, un solo abono por N°). Sin guía sin permiso con ese N° y con
+ * otras → 409 `GUIA_AMBIGUA` (la ventana quedó vieja: que elija de nuevo);
+ * dos sin permiso de series distintas → también ambigua.
+ */
+function plataDeLaGuiaSinPermiso(gtf: string, guias: GuiaDelNumero[]): PlataDeGuia {
+  const sinPermiso = guias.filter((g) => g.contratoId == null);
+  if (sinPermiso.length === 0 && guias.length > 0) {
+    const candidatas = [...new Map(guias.map((g) => [`${g.gtfNumber}|${g.contratoId}`, g])).values()];
+    const cuales = candidatas.map((g) => g.permiso ?? g.titular ?? "otro permiso").join(" · ");
+    throw new GuiaAmbiguaError(gtf, candidatas, `La guía N° ${gtf} ya no está sin permiso (${cuales}). Elige su permiso.`);
+  }
+  const d = decidirPlataDeGuia({ gtfNumber: gtf, contratoId: null }, sinPermiso);
+  if (d.estado === "ambigua") throw new GuiaAmbiguaError(gtf, d.candidatas, mensajeGuiaAmbigua(gtf, d.candidatas));
+  const unica = guias.every((g) => g.contratoId == null);
+  return { gtfNumber: gtf, contratoId: null, unica, frenadaPor: null };
+}
+
+/**
+ * Cómo volver a pedir la MISMA guía después de escribir (releer la plata):
+ * su permiso, o «∅» si es la sin permiso de un N° que también está en otro
+ * permiso (`null` ahí sería «elige» → 409 sobre algo ya guardado).
+ */
+export function pedidoDePlata(p: PlataDeGuia): string | null {
+  return p.contratoId ?? (p.unica ? null : SIN_PERMISO);
+}
+
+/** Cómo nombrar la guía a las primitivas de la cuenta y al freno: el N° si es la única (como siempre), N° + permiso si no. */
+export function refDePlata(p: PlataDeGuia): string | GuiaRef {
+  return p.unica ? p.gtfNumber : { gtfNumber: p.gtfNumber, contratoId: p.contratoId };
+}
+
+/** El `where` extra de las filas de plata de la guía (asientos, abono, fletes, gastos): nada si es la única, su permiso si no. */
+export function filtroPermisoDePlata(p: PlataDeGuia): { contratoId?: string | null } {
+  return p.unica ? {} : { contratoId: p.contratoId };
+}
