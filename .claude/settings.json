      "Bash(TRUNCATE*)",
      "Bash(vercel remove*)",
      "Bash(vercel rollback --yes*)",
      "Bash(supabase db reset*)",
      "Read(${CLAUDE_PROJECT_DIR}/.env)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.preview)",
      "Write(${CLAUDE_PROJECT_DIR}/.env)",
      "Write(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Write(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Bash(chmod -R 777*)",
      "Bash(chmod 777 /*)",
      "Bash(env)"
    ]
  }
}
