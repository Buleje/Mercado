{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Settings locales del proyecto Buleje. Activados 2026-04-08 tras el plan maestro FLUJO_PRO_v6 nivel 3 (ver docs/adr/017-claude-code-agent-architecture-v3.md — pendiente). Este archivo ES versionado en git para que viaje con el repo. Los hooks personales globales del usuario viven en ~/.claude/settings.json y se heredan automáticamente.",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BSM_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
    "BSM_HOOKS_DEBUG": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "",
    "OTEL_SERVICE_NAME": "bodega-san-martin-claude"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/danger-zone.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-enterprise-gate.mjs",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-db-snapshot.mjs",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-slo-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-lint.mjs",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-learn.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-deploy-sentinel.mjs",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checkpoint.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-alert-sound.mjs",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "_comment_autonomy": "2026-04-09 (v2) — Brandon refinó el mandato: cierre con 3 tablas fijas (antes/despues, hecho, mejoras+agentes). Autonomía v2 arranca siguiente iniciativa automatico sin esperar si. Instalación de libs/MCPs/skills/agentes directa. Commit + push directo si tests verdes. Ver memoria feedback_autonomous_chief.md seccion 6.2.",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(tsx *)",
      "Bash(ts-node *)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(sleep *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(psql *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose ps*)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(curl -s http*)",
      "Bash(curl -sS http*)",
      "Read(${CLAUDE_PROJECT_DIR}/**)",
      "Write(${CLAUDE_PROJECT_DIR}/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/**)",
      "MultiEdit(${CLAUDE_PROJECT_DIR}/**)",
      "Glob(*)",
      "Grep(*)",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Agent(*)",
      "Skill(*)",
      "WebFetch(*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git clean -fdx*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(DROP DATABASE*)",
      "Bash(DROP SCHEMA*)",
      "Bash(TRUNCATE*)",
      "Bash(vercel remove*)",
      "Bash(vercel rollback --yes*)",
      "Bash(supabase db reset*)",
      "Read(${CLAUDE_PROJECT_DIR}/.env)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.preview)",
      "Write(${CLAUDE_PROJECT_DIR}/.env)",
      "Write(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Write(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env.production)"
    ]
  }
}