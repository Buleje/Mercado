{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Settings locales del proyecto Bodega San Martín. Activados 2026-04-08 tras el plan maestro FLUJO_PRO_v6 nivel 3 (ver docs/adr/017-claude-code-agent-architecture-v3.md — pendiente). Este archivo ES versionado en git para que viaje con el repo. Los hooks personales globales del usuario viven en ~/.claude/settings.json y se heredan automáticamente.",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_MODE": "in-process",
    "BSM_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
    "BSM_HOOKS_DEBUG": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/danger-zone.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-lint.mjs",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-context.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checkpoint.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint*)",
      "Bash(npx prisma*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Read(${CLAUDE_PROJECT_DIR}/**)",
      "Write(${CLAUDE_PROJECT_DIR}/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(git push --force origin master*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git clean -fdx*)",
      "Read(${CLAUDE_PROJECT_DIR}/.env)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.local)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.production)",
      "Read(${CLAUDE_PROJECT_DIR}/.env.preview)",
      "Write(${CLAUDE_PROJECT_DIR}/.env*)",
      "Edit(${CLAUDE_PROJECT_DIR}/.env*)"
    ]
  }
}
