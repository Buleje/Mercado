      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_tabs",
      "mcp__desktop-control__screenshot",
      "mcp__desktop-control__screen_info",
      "mcp__desktop-control__mouse_position",
      "mcp__desktop-control__mouse_click",
      "mcp__desktop-control__mouse_move",
      "mcp__desktop-control__mouse_scroll",
      "mcp__desktop-control__keyboard_press",
      "mcp__desktop-control__keyboard_type",
      "mcp__desktop-control__keyboard_combo",
      "mcp__desktop-control__wait",
      "mcp__postgres__query",
      "mcp__github__get_file_contents",
      "mcp__github__list_pull_requests",
      "mcp__github__get_pull_request",
      "mcp__github__list_commits",
      "mcp__github__list_issues",
      "mcp__github__search_code",
      "mcp__github__get_pull_request_files",
      "mcp__github__get_pull_request_status",
      "mcp__github__get_issue",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_migrations",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__get_logs",
      "mcp__claude_ai_Supabase__get_advisors",
      "mcp__claude_ai_Supabase__get_project",
      "mcp__claude_ai_Supabase__get_project_url",
      "mcp__claude_ai_Supabase__search_docs",
      "mcp__claude_ai_Vercel__list_deployments",
      "mcp__claude_ai_Vercel__get_deployment",
      "mcp__claude_ai_Vercel__get_deployment_build_logs",
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__claude_ai_Vercel__list_projects",
      "mcp__claude_ai_Vercel__get_project",
      "mcp__claude_ai_Sentry__find_issues",
      "mcp__claude_ai_Sentry__search_issues",
      "mcp__claude_ai_Sentry__search_events",
      "mcp__claude_ai_Sentry__find_organizations",
      "mcp__claude_ai_Sentry__find_projects",
      "mcp__claude_ai_Sentry__get_sentry_resource",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Read(${CLAUDE_PROJECT_DIR}/**)",
      "Write(${CLAUDE_PROJECT_DIR}/**)",
      "Edit(${CLAUDE_PROJECT_DIR}/**)",
      "MultiEdit(${CLAUDE_PROJECT_DIR}/**)",
      "Glob(*)",
      "Grep(*)",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Agent(*)",
      "Skill(*)",
      "WebSearch",
      "Bash(env | grep NEXT_PUBLIC*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:supabase.co)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:vercel.app)",
      "WebFetch(domain:vercel-status.com)",
      "WebFetch(domain:sentry.io)",
      "WebFetch(domain:posthog.com)",
      "WebFetch(domain:stripe.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:prisma.io)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:localhost)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -f /*)",
      "Bash(rm /*)",
      "Bash(sudo rm *)",
      "Bash(sudo dd *)",
      "Bash(sudo mkfs*)",
      "Bash(sudo wipefs*)",
      "Bash(sudo fdisk*)",
      "Bash(sudo parted*)",
      "Bash(sudo chmod -R 777*)",
      "Bash(sudo chown -R *)",
      "Bash(sudo su*)",
      "Bash(sudo -i*)",
      "Bash(sudo -s*)",
      "Bash(sudo bash*)",
      "Bash(sudo sh *)",
      "Bash(sudo visudo*)",
      "Bash(sudo passwd*)",
      "Bash(sudo userdel*)",
      "Bash(sudo deluser*)",
      "Bash(sudo shutdown*)",
      "Bash(sudo reboot*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
