      "Bash(git reset --hard origin/main*)",
      "Bash(git clean -fdx*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
