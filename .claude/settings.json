{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Settings locales del proyecto Buleje. Activados 2026-04-08 tras el plan maestro FLUJO_PRO_v6 nivel 3 (ver docs/adr/017-claude-code-agent-architecture-v3.md — pendiente). Este archivo ES versionado en git para que viaje con el repo. Los hooks personales globales del usuario viven en ~/.claude/settings.json y se heredan automáticamente.",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BSM_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}",
    "BSM_HOOKS_DEBUG": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "",
    "OTEL_SERVICE_NAME": "bodega-san-martin-claude",
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "20000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/danger-zone.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-enterprise-gate.mjs",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-db-snapshot.mjs",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-slo-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/hex-code-guard.mjs",
            "timeout": 3,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-lint.mjs",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-tsc.mjs",
            "timeout": 120,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-learn.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-typography-lint.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-ui-screenshot.mjs",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-deploy-sentinel.mjs",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-context.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-autonomy.mjs",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-autonomy.mjs",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/user-prompt-adr-injector.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-compact-handoff.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-cost-log.mjs",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checkpoint.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-skill-suggester.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "_comment_autonomy": "2026-04-09 (v2) — Brandon refinó el mandato: cierre con 3 tablas fijas (antes/despues, hecho, mejoras+agentes). Autonomía v2 arranca siguiente iniciativa automatico sin esperar si. Instalación de libs/MCPs/skills/agentes directa. Commit + push directo si tests verdes. Ver memoria feedback_autonomous_chief.md seccion 6.2.",
