{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".claude/**",
    "scripts/**",
    "playground/**",
    "design-system/**",
    "stories/**",
    "**/*.stories.{ts,tsx}",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "tests/**",
    "__tests__/**",
    "e2e/**",
    "lib/generated/**",
    "packages/design-system/.storybook/**",
    "instrumentation*.ts"
  ],
  "ignoreDependencies": [
    "@prisma/client",
    "@capacitor/core",
    "@capacitor/geolocation",
    "@playwright/mcp"
  ],
  "ignoreBinaries": [
    "cap",
    "k6",
    "del"
  ]
}
