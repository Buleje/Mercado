// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (SaaS multi-tenancy) ────────────────────────
model Tenant {
  id                     String    @id @default(cuid())
  slug                   String    @unique // subdomain: e.g. "bodega-san-martin"
  name                   String // E.g. "Buleje"
  plan                   String    @default("free") // free | pro | business
  type                   String    @default("store") // store | supplier | delivery
  active                 Boolean   @default(true)
  customDomain           String? // Optional custom domain: "www.mitienda.com"
  ownerEmail             String?
  ownerPhone             String?
  trialEndsAt            DateTime?
  // ── Branding white-label ─────────────────────────────
  logoUrl                String? // URL del logo (Vercel Blob o CDN)
  faviconUrl             String? // URL del favicon
  lat                    Float? // Ubicación de la tienda (mapa superadmin, 2026-06-14)
  lng                    Float?
  primaryColor           String    @default("#00B4A6") // Color principal del negocio
  secondaryColor         String    @default("#f4a261") // Color secundario
  // ── Referidos entre tiendas ──────────────────────────
  referralCode           String?   @unique // Código único para invitar otras tiendas
  referredBy             String? // slug del tenant que invitó a este
  // ── Stripe billing ──────────────────────────────────
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  // ── Nicho de negocio ─────────────────────────────────
  industry               Industry  @default(bodega)
  // ── Mercado Pago billing ─────────────────────────────
  mpCustomerId           String? // ID de customer en Mercado Pago
  mpSubscriptionId       String? // ID de suscripción MP (si aplica)
  mpPaymentMethod        String? // Método de pago: "yape", "bcp", "efectivo", etc.
  // ── Email verification ───────────────────────────────
  emailVerified          Boolean   @default(false)
  emailVerifyToken       String?   @unique
  emailVerifyExpires     DateTime?
  // ── Delivery network (Brandon mayo 2026 v7) ──────────
  // Si true, los pedidos del tenant se ofrecen a la red de repartidores
  // Buleje (DeliveryPartner cross-tenant) y la tienda aparece en /delivery-app.
  // Si false (default), solo el delivery propio del negocio atiende los pedidos
  // — no se crean DeliveryOffer para terceros, ni la tienda aparece en el mapa
  // ni en hot-zones del rider.
  useThirdPartyDelivery  Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  dailySummaries         DailySummary[]
  fiados                 Fiado[]
  turnos                 Turno[]
  recetas                Receta[]
  produccionLotes        ProduccionLote[]
  prestamos              Prestamo[]
  cotizaciones           Cotizacion[]
  guiasRemision          GuiaRemision[]
  notasCredito           NotaCredito[]
  notifications          Notification[]
  conteosFisicos         ConteoFisico[]
  treasuryCuentas        TreasuryCuenta[]
  treasuryMovimientos    TreasuryMovimiento[]
  treasuryTransferencias TreasuryTransferencia[]
  adelantos              Adelanto[]
  adelantoBeneficiarios  AdelantoBeneficiario[]
  adelantosRecurrentes   AdelantoRecurrente[]
  stores                 Store[]
  featureFlags           TenantFeatureFlag[]
  storePage              TenantStorePage?
  pageProductOverrides   TenantPageProductOverride[]
  pagePromotions         TenantPagePromotion[]
  pageVisits             TenantPageVisit[]
  pageHeroes             PageHero[]
  wholesaleOrders        WholesaleOrder[]            @relation("WholesaleOrderTenant")

  @@index([slug])
  @@index([active])
  @@index([stripeCustomerId])
  @@index([industry])
}

// ─── Products ───────────────────────────────────────────
model Product {
  id            Int       @id @default(autoincrement())
  name          String
  category      String
  price         Decimal   @db.Decimal(12, 2)
  costPrice     Decimal?  @db.Decimal(12, 2)
  image         String    @default("")
  description   String?
  unit          String    @default("unidad")
  badge         String?
  barcode       String?
  stock         Int?
  stockMin      Int?
  stockMax      Int?
  active        Boolean   @default(true)
  tenantId      String
  deletedAt     DateTime? // soft-delete — null means active
  expiresAt     DateTime? // nearest expiry date of available stock
  shelfLifeDays Int? // default shelf-life in days for auto-calc

  // ── Tipo de catálogo: producto físico vs servicio (ADR pendiente) ──
  // "product" (default) = ítem con stock/barcode/vencimiento.
  // "service" = sin stock; usa durationLabel/pricingUnit/notes.
  type          String   @default("product")
  // ── Distribución preparada vs empaquetada (ADR-131, Brandon 2026-06-12) ──
  // false (default) = EMPAQUETADA → se muestra en el Inicio (catálogo cruza-
  //   tiendas, producto-first) Y en la ficha de la tienda.
  // true = PREPARADA (hecha al momento: comida) → SOLO en la ficha de la tienda
  //   (modelo tienda-first, 1 pedido por cocina). NO aparece en el Inicio.
  isPrepared    Boolean  @default(false)
  // ── Producto completo ──
  brand         String? // marca / fabricante
  sku           String? // código interno del negocio (distinto del barcode)
  taxType       String?  @default("gravado") // gravado | exonerado | inafecto (IGV)
  weightKg      Float? // peso para delivery/logística
  dimensions    String? // medidas libres, ej "30x20x10 cm" o "2m³"
  // ── Servicio ──
  durationLabel String? // duración estimada, ej "2 horas", "1 día"
  pricingUnit   String? // unidad de cobro: fijo | hora | m3 | unidad | dia
  notes         String? // requisitos / notas para el cliente

  orderItems          OrderItem[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  inventoryMovements  InventoryMovement[]
  priceHistory        PriceHistory[]
  transfers           Transfer[]
  locations           Location[]
  batches             Batch[]
  recetasComoProducto Receta[]               @relation("RecetaProducto")
  ingredienteEn       RecetaIngrediente[]    @relation("IngredienteProducto")
  storeProducts       StoreProduct[]
  forecastLogs        ForecastLog[]
  images              ProductImage[]
  variants            ProductVariant[]
  modifierGroups      ProductModifierGroup[]
  analytics           ProductAnalytics[]
  metaTitle           String?
  metaDescription     String?
  metaKeywordsJson    String?
  ogImage             String?

  stockoutPredictions StockoutPrediction[]
  sponsoredBoosts     SponsoredBoost[]
  pageOverrides       TenantPageProductOverride[]

  // ── Dropshipping (ADR-298) — aditivo, default off ─────────────────
  isDropship         Boolean @default(false) // el proveedor despacha directo al cliente
  dropshipSupplierId String? // FK lógica a Supplier.id (proveedor que cumple)
  supplierSku        String? // SKU del producto en el proveedor
  supplierUrl        String? // link del producto en el proveedor

  // CLEANUP P2: redundante con @@index([tenantId, active]) y @@index([tenantId, category, active]) abajo
  // @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, category, active])
  @@index([barcode])
  @@index([tenantId, isDropship])
}

// ─── Dropshipping fulfillment (ADR-298) ──────────────────
// Un registro por PROVEEDOR por ORDEN. Cuando entra un pedido pagado en una
// tienda con dropshipEnabled, se agrupan los ítems dropship por proveedor y se
// crea este fulfillment. El proveedor despacha directo al cliente.
model DropshipFulfillment {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String
  supplierId String? // Supplier.id (null si el producto no tenía proveedor asignado)
  status     String   @default("pending") // pending|forwarded|confirmed|shipped|delivered|cancelled
  itemsJson  String // snapshot: [{ productId, name, qty, unitCost, supplierSku }]
  costTotal  Decimal? @db.Decimal(12, 2) // suma de costos al proveedor

  // Snapshot de envío (dirección del cliente al momento del pedido)
  shipName      String?
  shipPhone     String?
  shipLocation  String?
  shipReference String?

  // Tracking / referencia del proveedor
  supplierOrderRef String?
  carrier          String?
  trackingNumber   String?
  trackingUrl      String?
  notifiedAt       DateTime? // cuándo se avisó al proveedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([orderId])
  @@index([tenantId, supplierId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  tenantId  String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
  @@index([productId, position])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  priceModifier  Decimal  @default(0) @db.Decimal(12, 2)
  stock          Int?
  attributesJson String?
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([tenantId])
  @@index([sku])
}

// ─── Product Modifiers (universal options) ───────────────────────
// Diferente a ProductVariant: estos son grupos de opciones de personalizacion
// (cremas, presa, talla, sabor, topping, extras) que NO afectan el inventario
// del producto base. Permiten configurar al cliente como recibir su pedido.
//
// Aplicable a cualquier categoria: polleria, ropa, farmacia, restaurante, etc.

model ProductModifierGroup {
  id          String                  @id @default(cuid())
  productId   Int
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  description String?
  required    Boolean                 @default(false)
  minSelect   Int                     @default(0)
  maxSelect   Int                     @default(1)
  position    Int                     @default(0)
  isActive    Boolean                 @default(true)
  tenantId    String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  options     ProductModifierOption[]

  @@index([productId])
  @@index([tenantId])
}

model ProductModifierOption {
  id         String               @id @default(cuid())
  groupId    String
  group      ProductModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal              @default(0) @db.Decimal(12, 2)
  position   Int                  @default(0)
  isDefault  Boolean              @default(false)
  isActive   Boolean              @default(true)
  imageUrl   String?
  tenantId   String
  createdAt  DateTime             @default(now())

  @@index([groupId])
  @@index([tenantId])
}

// ─── Variant Catalog (Superadmin global, expand-only) ─────────────────────────
// Repositorio global de plantillas de variaciones que el superadmin mantiene
// (ej: "Cremas para pollo", "Presas", "Toppings de pizza"). Los tenants pueden
// importar plantillas a sus productos vía POST /api/admin/products/[id]/import-from-catalog
// que clona el template + options en ProductModifierGroup + ProductModifierOption.
// NO multi-tenant — es global del SaaS.
model VariantCatalogTemplate {
  id          String                 @id @default(cuid())
  category    String // "Pollería" | "Pizzería" | "Heladería" | etc.
  name        String // "Cremas para pollo" | "Presas" | "Toppings"
  description String?
  required    Boolean                @default(false)
  minSelect   Int                    @default(0)
  maxSelect   Int                    @default(1)
  position    Int                    @default(0)
  isPublished Boolean                @default(true)
  options     VariantCatalogOption[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([category])
  @@index([isPublished])
}

model VariantCatalogOption {
  id         String                 @id @default(cuid())
  templateId String
  template   VariantCatalogTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String // "Crema huancaína", "Pierna", "Pecho"
  imageUrl   String?
  priceDelta Decimal                @default(0) @db.Decimal(12, 2)
  position   Int                    @default(0)
  isDefault  Boolean                @default(false)
  createdAt  DateTime               @default(now())

  @@index([templateId])
}

// ─── Batches: see "Inventory Batches (Lotes)" section below (line ~969)

// ─── Customers ──────────────────────────────────────────
model Customer {
  // TD-040 Phase 1 EXPAND (2026-05-09): new surrogate PK.
  // phone gets temporary global @unique (same as original @id constraint) so existing
  // FK relations (references: [phone]) remain valid during this sprint.
  // Phase 2: backfill customerId in child models; switch relations to references: [id].
  // Phase 3 (contract): drop @unique on phone; @@unique([tenantId, phone]) becomes sole constraint.
  id                String    @id @default(cuid())
  phone             String    @unique // temporary global unique; see TD-040 Phase 3 to relax to @@unique([tenantId,phone])
  name              String
  location          String    @default("")
  reference         String    @default("")
  activeLocationId  String?
  aiNotes           String?
  aiNotesDate       DateTime?
  birthday          DateTime?
  loyaltyPoints     Int       @default(0)
  loyaltyTier       String    @default("bronce")
  totalSpent        Decimal   @default(0) @db.Decimal(12, 2)
  notifOrderUpdates Boolean   @default(true)
  notifPromotions   Boolean   @default(true)
  notifRestock      Boolean   @default(false)
  privateNotes      String?
  referralCode      String?   @unique
  referredBy        String?
  creditBalance     Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit       Decimal   @default(0) // 0 = sin límite @db.Decimal(12, 2)
  tags              String? // JSON array: ["mayorista", "restaurante", "vecino"]

  // ── Identificación ──
  tipoPersona   String? // "natural" | "juridica"
  tipoDocumento String? // "DNI" | "RUC" | "CE" | "PASAPORTE"
  documento     String? // número de documento
  razonSocial   String? // si es jurídica
  estado        String? @default("activo") // activo | inactivo | bloqueado

  // ── Contacto ──
  whatsappSecundario String?
  email              String?

  // ── Ubicación ──
  departamento String?
  provincia    String?
  distrito     String?
  direccion    String?
  lat          Float?
  lng          Float?

  // ── Comercial ──
  categoria        String? // "mayorista" | "minorista" | "restaurante" | "tienda"
  canal            String? // "presencial" | "delivery" | "whatsapp" | "web"
  listaPrecio      String? // "general" | "mayorista" | "especial"
  vendedorAsignado String?

  // ── Fiado Digital ──
  diasCredito     Int?     @default(0)
  alertasWhatsapp Boolean? @default(true)

  // ── Adicionales ──
  fechaNacimiento DateTime? @db.Date
  genero          String? // "M" | "F" | "otro"
  comoLlego       String? // "referido" | "redes" | "local" | "otro"
  observaciones   String?

  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations           SavedLocation[]
  orders              Order[]
  sales               Sale[]
  savedCarts          SavedCart[]
  notifications       CustomerNotification[]
  fiados              Fiado[]
  prestamos           Prestamo[]
  cotizaciones        Cotizacion[]
  loyaltyTransactions LoyaltyTransaction[]

  // @@unique([tenantId, phone]) -- TARGET for Phase 3 contract; phone @unique is the interim scaffold
  @@index([phone]) // legacy queries still filter by phone (replaces former @@index([tenantId, phone]))
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// ─── Loyalty Ledger (ADR-024 — TD-030) ──────────────────
// Append-only ledger for every change to Customer.loyaltyPoints.
// Customer.loyaltyPoints stays as a denormalized materialized balance whose
// only legal mutation path is `lib/db/loyalty.db.ts#addTransaction` inside
// a `$transaction([insert, increment])` block. See docs/adr/024.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String // FK to Customer.phone (Customer's @id is `phone`)
  tenantId   String
  amount     Int // positive = credit, negative = debit; never 0
  reason     String // "purchase" | "promotion" | "redemption" | "manual" | "referral" | "expiry" | "adjustment" | "backfill"
  metadata   Json? // free-form: { orderId, promoId, idempotencyKey, ... }
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [phone], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)], map: "idx_loyalty_tx_customer_created_desc")
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_loyalty_tx_tenant_created_desc")
  @@index([tenantId, reason])
}

// ─── Saved Carts (persistent across devices) ────────────
model SavedCart {
  id            String   @id @default(cuid())
  customerPhone String
  customerId    String? // TD-040 Phase 1 EXPAND: will hold Customer.id after Phase 2 backfill
  tenantId      String
  itemsJson     String // JSON array of cart items
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@unique([customerPhone, tenantId])
  @@index([tenantId])
}

model SavedLocation {
  id            String   @id @default(cuid())
  location      String
  reference     String   @default("")
  customerPhone String
  customerId    String? // TD-040 Phase 1 EXPAND: will hold Customer.id after Phase 2 backfill
  customer      Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([customerPhone])
}

// ─── Orders ─────────────────────────────────────────────
enum OrderStatus {
  pendiente
  confirmado
  preparando
  en_camino
  entregado
  cancelado
}

model Order {
  id                  String      @id
  customerName        String
  customerPhone       String?
  customerLocation    String      @default("")
  customerReference   String      @default("")
  total               Decimal     @db.Decimal(12, 2)
  status              OrderStatus @default(pendiente)
  notes               String?
  paymentMethod       String?
  yapeOperationNumber String?
  deuda               Boolean?
  appliedCouponCode   String?
  couponDiscount      Decimal?    @db.Decimal(12, 2)
  appliedPromoId      String?
  discountAmount      Decimal?    @db.Decimal(12, 2)
  totalCogs           Decimal?    @db.Decimal(12, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenantId            String
  source              String      @default("direct") // direct | marketplace | wholesale
  deletedAt           DateTime? // soft-delete — null means active
  idempotencyKey      String?     @unique // prevents duplicate order creation
  riderName           String? // repartidor asignado al pedido
  cancelReason        String? // motivo de cancelación
  cancelledAt         DateTime? // cuándo se canceló

  // Multi-vendor WhatsApp checkout: agrupa órdenes que comparten una PaymentApproval (Yape)
  paymentApprovalId String?
  // TD-040 Phase 1 EXPAND: parallel Customer.id FK; backfill in Phase 2 via phone+tenantId join
  customerId        String?

  // ─── Bloque D1 — Delivery vivo (marketplace) ────────────────
  deliveryStatus      String? // preparing|ready|picked_up|in_transit|nearby|delivered|failed|cancelled
  driverId            String?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  pickupLat           Float?
  pickupLng           Float?
  dropoffLat          Float?
  dropoffLng          Float?

  // Fase A4: pedido hecho dentro de una Junta del Barrio (link lógico a Junta.id).
  juntaId             String?

  items               OrderItem[]
  customer            Customer?            @relation(fields: [customerPhone], references: [phone], onDelete: SetNull)
  statusHistory       OrderStatusHistory[]
  guiasRemision       GuiaRemision[]
  notasCredito        NotaCredito[]
  deliveryAssignment  DeliveryAssignment?
  deliveryOffers      DeliveryOffer[]
  deliveryTracking    DeliveryTracking[]
  deliveryRouteStops  DeliveryRouteStop[]
  conversationThreads ConversationThread[]

  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
  // CLEANUP P2: redundante con @@index([tenantId, status, createdAt]) y @@index([tenantId, createdAt]) abajo
  // @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerPhone])
  @@index([tenantId, deliveryStatus], name: "Order_deliveryStatus_idx")
  @@index([driverId], name: "Order_driverId_idx")
  @@index([paymentApprovalId], name: "Order_paymentApprovalId_idx")
  @@index([juntaId], name: "Order_juntaId_idx")
  // Audit #3 (Brandon 2026-05-30): KPIs públicos del marketplace (activity feed,
  // live stats, top hoy, popularity 30d) filtran por source + deletedAt + createdAt.
  @@index([source, deletedAt, createdAt])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       String
  productId     Int?
  name          String
  price         Decimal  @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2)
  quantity      Int
  unit          String
  image         String   @default("")
  modifiersJson Json? // selected ProductModifierOption snapshots {groupId,name,optionId,optionName,priceDelta}

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ─── Reviews ────────────────────────────────────────────
model Review {
  id             String    @id
  name           String
  location       String    @default("")
  text           String
  rating         Int
  phone          String?
  productId      Int? // null = general store review; set for product-specific reviews
  storeId        String? // null = reseña de tienda del sistema; set for marketplace store reviews
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status         String    @default("approved") // pending | approved | rejected | hidden
  tenantId       String
  date           DateTime  @default(now())
  deletedAt      DateTime? // soft-delete — null means active
  adminReply     String?
  adminReplyDate DateTime?
  qualityRating  Int?
  priceRating    Int?
  deliveryRating Int?
  photosJson     String?
  verified       Boolean   @default(false)
  helpfulCount   Int       @default(0)

  // ─── Bloque D3 — Reviews verificadas del marketplace ────────
  orderId          String? // FK a Order: si existe, la review es "verified"
  verifiedAt       DateTime? // cuándo se verificó el link con el Order
  helpfulUpvotes   Int          @default(0)
  helpfulDownvotes Int          @default(0)
  votes            ReviewVote[]

  @@index([status])
  // CLEANUP P2: redundante con @@index([tenantId, verified]) abajo
  // @@index([tenantId])
  @@index([productId])
  @@index([storeId])
  @@index([storeId, status, date(sort: Desc)], name: "Review_storeId_status_date_idx")
  @@index([productId, status, date(sort: Desc)], name: "Review_productId_status_date_idx")
  @@index([tenantId, verified], name: "Review_tenantId_verified_idx")
  @@index([orderId])
  // PERF wave-2: customers.db.ts getByProduct — {status:"approved", productId≠null, tenantId, deletedAt:null}
  @@index([tenantId, productId, status, deletedAt], name: "Review_tenantId_productId_status_deletedAt_idx")
}

// ─── Bloque D3 — ReviewVote (dedupe de votos helpful) ──────
// Un buyer solo puede votar una review una vez. El tipo de voto puede
// cambiarse (upvote ↔ downvote) pero no duplicarse.

model ReviewVote {
  id            String   @id
  tenantId      String
  reviewId      String
  customerPhone String
  voteType      String // upvote | downvote
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, customerPhone], name: "ReviewVote_review_customer_unique")
  @@index([tenantId])
  @@index([reviewId])
  @@index([customerPhone])
}

// ─── Settings ───────────────────────────────────────────
model Settings {
  id                 Int     @id @default(autoincrement())
  tenantId           String  @unique
  mode               String  @default("checkout")
  businessName       String?
  businessPhone      String?
  businessAddress    String?
  logoUrl            String?
  description        String?
  hours              String?
  deliveryZone       String?
  yapeEnabled        Boolean @default(false)
  yapeImage          String?
  yapeName           String?
  yapePhone          String?
  cashEnabled        Boolean @default(true)
  navLinksJson       String?
  businessLat        Float?
  businessLon        Float?
  adminPassword      String?
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  adminBypassLogin   Boolean @default(false)
  comboTemplatesJson String?
  featureFlagsJson   String? // JSON object: { [FeatureFlag]: boolean }

  // ── Datos del negocio (Mejora M1-M10) ──
  razonSocial     String?
  ruc             String?
  businessEmail   String?
  currency        String? @default("PEN")
  timezone        String? @default("America/Lima")
  businessType    String? // bodega | minimarket | tienda | restaurante
  regimenTributario String? // nrus | rer | rmt | general (SUNAT) — obligaciones tributarias
  socialLinksJson String? // JSON: { facebook?, instagram?, tiktok? }

  // ── Apariencia (Mejora M79-M86) — fix: persist colors/slogan ──
  primaryColor   String? @default("#2d6a4f")
  secondaryColor String? @default("#f4a261")
  slogan         String?

  // ── Sistema (Mejora M21-M28) ──
  dateFormat      String? @default("DD/MM/YYYY")
  timeFormat      String? @default("24h")
  decimals        Int?    @default(2)
  taxRate         Decimal? @default(18) @db.Decimal(5, 2)
  fiscalYearStart Int?    @default(1) // month 1-12

  // ── Ventas y comprobantes (Mejora M29-M38) ──
  invoiceSeriesJson    String? // JSON: { factura: "F001", boleta: "B001", ncFactura: "FC01", ncBoleta: "BC01" }
  invoiceStartJson     String? // JSON: { F001: 1, B001: 1, ... }
  enabledDocTypes      String? @default("factura,boleta,ticket")
  roundingMode         String? @default("none") // none | 0.10 | 0.50
  maxDiscountPercent   Float?  @default(100)
  discountRequiresAuth Boolean @default(false)
  invoiceFooterText    String?
  sunatRuc             String?
  sunatDenominacion    String?
  sunatDireccion       String?

  // ── Inventario (Mejora M39-M46) ──
  defaultUnit        String? @default("unidad")
  globalMinStock     Int?    @default(5)
  stockAlertChannels String? @default("dashboard") // dashboard,email,whatsapp,push
  adjustReasonsJson  String? // JSON array: ["Merma","Robo","Vencimiento","Error de conteo","Donación"]
  fefoEnabled        Boolean @default(true)
  fefoAlertDays      Int?    @default(15)
  inventoryCountFreq String? @default("monthly") // weekly | monthly | quarterly

  // ── Caja y pagos (Mejora M47-M54) ──
  cashOpeningAmount Decimal? @default(100) @db.Decimal(12, 2)
  cashAlertMax      Decimal? @default(500) @db.Decimal(12, 2)
  returnPolicyDays  Int?     @default(7)
  returnMaxNoAuth   Decimal? @default(50) @db.Decimal(12, 2)
  autoCloseTime     String? // e.g. "22:00"

  // ── Delivery (Mejora M55-M62) ──
  deliveryZonesJson String? // JSON array: [{ name, fee, estimatedMin }]
  freeDeliveryMin   Decimal? @default(0) @db.Decimal(12, 2)
  deliveryMaxRadius Float?   @default(10)
  deliveryHoursJson String? // JSON: { morning, afternoon, evening }
  ridersJson        String? // JSON array: [{ name, phone, zone }]

  // ── Notificaciones (Mejora M63-M70) ──
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpPass            String?
  smtpFrom            String?
  whatsappApiToken    String?
  whatsappBusinessNum String?
  whatsappWebhookUrl  String?
  notifChannelsJson   String? // JSON: { newOrder: true, orderReady: true, abandonedCart: false }
  reorderReminderDays Int?

  // ── Integraciones (Mejora M71-M78) ──
  plinEnabled        Boolean @default(false)
  plinImage          String?
  plinName           String?
  plinPhone          String?
  sunatProvider      String? // nubefact | efact | none
  sunatApiKey        String?
  googleAnalyticsId  String?
  googleTagManagerId String?

  // ── Auditoría (Mejora M87-M92) ──
  logRetentionDays Int?    @default(90)
  logActions       String? @default("sales,edits,access") // what to log

  // ── Respaldo (Mejora M93-M98) ──
  backupSchedule String?   @default("none") // none | daily | weekly
  lastBackupAt   DateTime?

  // ── Suscripción (Mejora M99-M104) ──
  planName           String?   @default("free")
  planExpiresAt      DateTime?
  maxProducts        Int?      @default(500)
  maxUsers           Int?      @default(3)
  maxBranches        Int?      @default(1)
  enabledModulesJson String? // JSON array: ["inventario","facturacion","ia"]

  // ── Métodos de pago adicionales ──
  transferEnabled       Boolean @default(false)
  transferBankName      String?
  transferAccountNum    String?
  transferAccountHolder String?

  // ── Plantilla de tienda ──
  productCategoriesJson String? // JSON array: ["Abarrotes","Bebidas",...] — pre-cargado desde plantilla en onboarding

  // ── StoreCustomizer ──
  storeThemeJson String? // JSON: StoreCustomizer theme data

  // ── Loyalty rules (audit team H022 fix 2026-05-06) ──
  // Antes vivían en localStorage del admin (se perdían al limpiar caché +
  // no se sincronizaban entre dispositivos). Ahora persistidas en DB.
  // Expand puro nullable — zero-downtime, sin backfill required.
  loyaltyRulesJson   String? // JSON: { pointsPerSol, minOrderAmount, multiplier, ... }
  loyaltyRewardsJson String? // JSON: array de rewards { id, label, costPoints, description, active }

  // ── Dropshipping (ADR-298) — flag per-tenant, default off ──
  dropshipEnabled Boolean @default(false) // activa el fulfillment automático al proveedor
}

// ─── Declaraciones tributarias (tracker SUNAT) ──────────
// Estado de cada declaración mensual/anual por tenant: pendiente | presentada |
// pagada, con monto y fechas. Único por (tenant, periodo, tipo).
model DeclaracionTributaria {
  id                String    @id @default(cuid())
  tenantId          String
  periodo           String // "YYYY-MM" (o "YYYY" para anual)
  tipo              String // igv-renta | plame | renta-anual
  estado            String    @default("pendiente") // pendiente | presentada | pagada
  montoDeclarado    Decimal?  @db.Decimal(12, 2)
  fechaPresentacion DateTime?
  fechaPago         DateTime?
  notas             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, periodo, tipo])
  @@index([tenantId])
}

// ─── Suppliers ──────────────────────────────────────────
model Supplier {
  id      String  @id
  name    String
  ruc     String?
  phone   String?
  email   String?
  address String?
  notes   String?

  // ── Identificación ──
  tipoPersona   String? // "natural" | "juridica"
  tipoDocumento String? // "DNI" | "RUC" | "CE" | "PASAPORTE"
  documento     String? // número de documento
  razonSocial   String? // nombre formal si es jurídica
  estado        String? @default("activo") // activo | inactivo

  // ── Contacto ──
  whatsappSecundario String?
  personaContacto    String?

  // ── Ubicación ──
  departamento String?
  provincia    String?
  distrito     String?
  direccion    String?

  // ── Comercial ──
  categoria      String? // "mayorista" | "fabricante" | "distribuidor" | "importador"
  condicionPago  String? // "contado" | "credito_7" | "credito_15" | "credito_30"
  diasCredito    Int?    @default(0)
  cuentaBancaria String?
  banco          String?

  // ── Adicionales ──
  observaciones String?

  // ── Self-signup & approval workflow (ADR item #15) ──
  // NB: Suppliers son cross-tenant en el marketplace; los registros creados via
  // self-signup usan tenantId = "__platform__" hasta ser aprobados y asignados.
  contactName     String?
  appliedAt       DateTime? @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  tenantId  String
  createdAt DateTime @default(now())

  purchases   PurchaseOrder[]
  payables    Payable[]
  evaluations SupplierEvaluation[]
  portal      SupplierPortal?

  @@index([tenantId])
  @@index([estado])
  @@index([ruc])
}

// ─── Purchase Orders ────────────────────────────────────
enum PurchaseStatus {
  pendiente
  recibido
  parcial
  cancelado
  auto_generated // Creado por AI Demand Forecasting — requiere aprobación del admin
}

model PurchaseOrder {
  id            String         @id
  supplierId    String
  supplierName  String
  total         Decimal        @db.Decimal(12, 2)
  status        PurchaseStatus @default(pendiente)
  notes         String?
  paymentMethod String?
  deliveryDate  DateTime?
  discount      Decimal?       @default(0) @db.Decimal(12, 2)
  tenantId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items    PurchaseItem[]
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  // CLEANUP P2: redundante con @@index([tenantId, status]) abajo
  // @@index([tenantId])
  // TD-020 / ADR-017 — aplicado en prod 2026-04-09 via scripts/apply-ola1-indices.ts
  @@index([tenantId, status], map: "PurchaseOrder_tenantId_status_idx")
}

model PurchaseItem {
  id              Int     @id @default(autoincrement())
  purchaseOrderId String
  productId       Int
  name            String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  unit            String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// ─── Sales (POS) ────────────────────────────────────────
model Sale {
  id            String   @id
  total         Decimal  @db.Decimal(12, 2)
  totalCogs     Decimal? @db.Decimal(12, 2)
  payment       String   @default("efectivo")
  amountPaid    Decimal  @default(0) @db.Decimal(12, 2)
  change        Decimal  @default(0) @db.Decimal(12, 2)
  customerPhone String?
  customerId    String? // TD-040 Phase 1 EXPAND: will hold Customer.id after Phase 2 backfill
  cashierId     String?
  tenantId      String
  createdAt     DateTime @default(now())

  // Mejora 1: Tipo de comprobante
  comprobanteTipo   String? @default("ticket")
  comprobanteRuc    String?
  comprobanteNumero String?

  // Mejora 4: Descuento global sobre la venta
  descuentoMonto      Decimal? @db.Decimal(10, 2)
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)

  // Pago mixto / fiado
  paymentDetails String?

  // SECURITY 2026-05-07 (X2): idempotencyKey para deduplicar ventas POS offline.
  // El POS genera uuid al meter en queue; el server deduplica antes del create.
  // @unique garantiza constraint a nivel DB (segunda línea de defensa tras check app).
  idempotencyKey String? @unique

  items    SaleItem[]
  customer Customer?  @relation(fields: [customerPhone], references: [phone], onDelete: SetNull)

  @@index([customerPhone])
  @@index([cashierId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerPhone])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    String
  productId Int
  name      String
  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)
  quantity  Int
  unit      String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ─── Promotions ─────────────────────────────────────────
model Promotion {
  id              String    @id
  name            String
  description     String    @default("")
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  minPurchase     Decimal?  @db.Decimal(12, 2)
  imageUrl        String?
  message         String?
  targetType      String    @default("all")
  targetPhones    String?
  active          Boolean   @default(true)
  tenantId        String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([tenantId])
}

// ─── Payables (Accounts Payable) ────────────────────────
model Payable {
  id              String   @id
  supplierId      String
  supplierName    String
  purchaseOrderId String?
  description     String   @default("")
  amount          Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("pendiente")
  dueDate         DateTime
  tenantId        String
  createdAt       DateTime @default(now())

  payments Payment[]
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([tenantId])
  @@index([dueDate])
  // TD-020 / ADR-017 — aplicado en prod 2026-04-09 via scripts/apply-ola1-indices.ts
  @@index([tenantId, status], map: "Payable_tenantId_status_idx")
}

model Payment {
  id        String   @id
  payableId String
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("efectivo")
  date      DateTime @default(now())
  reference String?

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
}

// ─── Cash Register ──────────────────────────────────────
enum CashRegisterStatus {
  abierta
  cerrada
}

model CashRegister {
  id             String             @id @default(cuid())
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  openingAmount  Decimal            @default(0) @db.Decimal(12, 2)
  closingAmount  Decimal?           @db.Decimal(12, 2)
  expectedAmount Decimal?           @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  status         CashRegisterStatus @default(abierta)
  notes          String?
  tenantId       String

  movements CashMovement[]

  @@index([tenantId])
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String
  type           String // venta, ingreso, egreso, apertura, cierre
  amount         Decimal  @db.Decimal(12, 2)
  method         String   @default("efectivo") // efectivo, yape, plin, tarjeta, transferencia
  description    String   @default("")
  saleId         String?
  createdAt      DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([cashRegisterId])
  // SECURITY 2026-05-07 (audit DB P0-3): saleId queries de reconciliación POS hacían seq scan.
  @@index([saleId])
  @@index([cashRegisterId, createdAt])
}

// ─── Inventory Movements ────────────────────────────────
model InventoryMovement {
  id            String   @id @default(cuid())
  productId     Int
  type          String // compra, venta, venta_online, devolucion, ajuste_positivo, ajuste_negativo, merma
  lossType      String? // damages, theft, expiry, obsolescence (only relevant when type=merma)
  quantity      Int
  previousStock Int      @default(0)
  newStock      Int      @default(0)
  reference     String? // saleId, orderId, purchaseId, etc.
  notes         String?
  warehouseId   String? // Which warehouse originated this movement
  createdBy     String? // Username of the admin who created this movement
  tenantId      String
  createdAt     DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([tenantId, createdAt])
}

// ─── Coupons ────────────────────────────────────────────
model Coupon {
  id            String    @id @default(cuid())
  code          String
  tenantId      String
  storeId       String? // TD-032: cupón específico de tienda marketplace (null = aplica a todo el tenant)
  description   String    @default("")
  discountType  String    @default("percent") // percent | fixed | giftcard
  discountValue Decimal   @default(0) @db.Decimal(12, 2)
  balance       Decimal?  @db.Decimal(12, 2) // remaining balance for giftcard type
  minPurchase   Decimal?  @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([storeId, code])
}

// ─── Returns / Refunds ──────────────────────────────────
model Return {
  id            String   @id @default(cuid())
  saleId        String?
  orderId       String?
  reason        String   @default("")
  total         Decimal  @default(0) @db.Decimal(12, 2)
  photoUrl      String?
  customerPhone String?
  creditApplied Boolean  @default(false)
  tenantId      String
  createdAt     DateTime @default(now())

  items ReturnItem[]

  @@index([tenantId])
  // SECURITY 2026-05-07 (audit DB P0-2): FKs sin índice. Lookup devolución por venta/pedido = seq scan.
  @@index([saleId])
  @@index([orderId])
  @@index([tenantId, createdAt])
}

model ReturnItem {
  id        Int     @id @default(autoincrement())
  returnId  String
  productId Int
  name      String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  unit      String

  returnRecord Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// ─── Shopping Lists ─────────────────────────────────────
model ShoppingList {
  id            String   @id @default(cuid())
  customerPhone String
  name          String
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ShoppingListItem[]

  @@index([customerPhone])
  @@index([tenantId])
}

model ShoppingListItem {
  id             Int    @id @default(autoincrement())
  shoppingListId String
  productId      Int
  quantity       Int    @default(1)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

// ─── Price History ──────────────────────────────────────
model PriceHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  tenantId  String
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changedAt])
  @@index([tenantId])
  // Perf 2026-05-29: compuesto para getByProduct/getByProducts (filtra tenant +
  // productId, ordena changedAt desc) — sirve el batch del sparkline de inventario.
  @@index([tenantId, productId, changedAt(sort: Desc)])
}

// ─── Delivery Slots ─────────────────────────────────────
model DeliverySlot {
  id        String   @id @default(cuid())
  orderId   String   @unique
  date      String // YYYY-MM-DD
  slot      String // manana, tarde, noche
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── Admin Chat Messages ────────────────────────────────
model AdminMessage {
  id        String   @id @default(cuid())
  sender    String // admin, cajero, almacenero
  message   String
  tenantId  String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── Supplier Evaluations ───────────────────────────────
model SupplierEvaluation {
  id          String   @id @default(cuid())
  supplierId  String
  purchaseId  String?
  punctuality Int      @default(3) // 1-5
  quality     Int      @default(3) // 1-5
  price       Int      @default(3) // 1-5
  notes       String?
  tenantId    String
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([tenantId])
}

// ─── Expenses (Operating Costs) ─────────────────────────
model Expense {
  id          String   @id @default(cuid())
  category    String // alquiler, servicios, personal, transporte, limpieza, marketing, otros
  description String   @default("")
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  recurring   Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([date])
  @@index([tenantId])
}

// ─── Gastos de PLATAFORMA (superadmin, Brandon 2026-06-30) ───────────────────
// Distinto de Expense (que es por-tenant): esto son los gastos REALES de Buleje
// como SaaS — facturas de infra (Vercel/Supabase), mensajería (Twilio), IA
// (Anthropic/OpenAI), pagos (fees Stripe/MP), personal, marketing. Global, sin
// tenantId. Se compara contra el costo de infra ESTIMADO (lib/cost-tracking).
model PlatformExpense {
  id        String   @id @default(cuid())
  concept   String // "Vercel Pro", "Twilio SMS", "Sueldo dev"
  category  String // infra | mensajeria | ia | pagos | personal | marketing | otros
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("PEN") // PEN | USD
  date      DateTime @default(now())
  recurring Boolean  @default(false)
  period    String   @default("") // mensual | anual (si recurring)
  vendor    String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
}

// ─── Product Bundles (Combos) ───────────────────────────
model Bundle {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(12, 2) // bundle price (usually less than sum of items)
  image       String   @default("")
  active      Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())

  items BundleItem[]

  @@index([tenantId])
}

model BundleItem {
  id        Int    @id @default(autoincrement())
  bundleId  String
  productId Int
  quantity  Int    @default(1)

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

// ─── Activity Log (Admin Audit Trail) ─────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  action    String // create, update, delete, view, login, etc.
  entity    String // product, order, customer, settings, etc.
  entityId  String?
  detail    String   @default("")
  user      String   @default("admin")
  ipAddress String?
  userAgent String?
  tenantId  String
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([user])
  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// ─── Push Subscriptions (persistent) ────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  phone     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([tenantId])
}

// ─── Admin Users ─────────────────────────────────────────
model AdminUser {
  id                    String    @id @default(cuid())
  username              String
  tenantId              String
  passwordHash          String
  // Seguridad (ADR-133): tras un reset del superadmin, fuerza al usuario a
  // setear su propia clave en el primer login. La temporal es de un solo uso.
  mustChangePassword    Boolean   @default(false)
  role                  String    @default("admin") // admin, cajero, almacenero
  name                  String    @default("")
  active                Boolean   @default(true)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ── 2FA TOTP (ADR-043) ──────────────────────────────────────
  totpSecret       String? // Base32-encoded TOTP secret (RFC 6238). NULL = sin 2FA configurado
  totpEnabledAt    DateTime? // Timestamp de activación. NULL = TOTP no activo aún
  // SECURITY 2026-05-06 (pentest H002): replay protection. Persistir el último
  // step TOTP usado por user para rechazar reuse del mismo código (60s window).
  totpLastUsedStep Int? // Último step (Date.now()/30000) consumido en verify

  turnos Turno[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([totpEnabledAt])
}

// ── AdminLoginDevice — dispositivos/IP conocidos por admin (ADR-133) ──
// Para alertar al dueño cuando hay un ingreso desde un dispositivo nuevo
// ("como Google"). El fingerprint = sha256(ip|familiaUA) para que cambios de
// versión menor del navegador NO cuenten como dispositivo nuevo. Se accede vía
// raw SQL (campo/tabla nueva, evita depender del cliente Prisma regenerado).
model AdminLoginDevice {
  id          String   @id @default(cuid())
  tenantId    String
  username    String
  fingerprint String
  ip          String?
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([tenantId, username, fingerprint])
  @@index([tenantId, username])
}

// ── SuperadminUser — platform-level users (ADR-043) ──────────
// La auth de superadmin usaba solo ADMIN_PASSWORD env + session cookie.
// Ahora persistimos el user con TOTP obligatorio para platform access.
model SuperadminUser {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  totpSecret    String? // Base32-encoded TOTP secret (RFC 6238)
  totpEnabledAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([username])
}

// ─── WhatsApp Notification Log ──────────────────────────
model NotificationLog {
  id        String   @id @default(cuid())
  type      String // order_confirmed, order_shipped, order_delivered, promotion, low_stock
  recipient String // phone number
  message   String
  status    String   @default("sent") // sent, failed
  orderId   String?
  tenantId  String
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  // TD-020 / ADR-017 — aplicado en prod 2026-04-09 via scripts/apply-ola1-indices.ts
  @@index([tenantId, createdAt(sort: Desc)], map: "NotificationLog_tenantId_createdAt_idx")
}

// ─── Customer Notification Inbox ────────────────────────
model CustomerNotification {
  id            String   @id @default(cuid())
  customerPhone String
  customerId    String? // TD-040 Phase 1 EXPAND: will hold Customer.id after Phase 2 backfill
  type          String // order, promo, stock, coupon, general
  title         String
  body          String
  link          String? // deep-link inside the app
  read          Boolean  @default(false)
  tenantId      String
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([customerPhone])
  @@index([createdAt])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════
// CMS - CONTENT MANAGEMENT SYSTEM
// ═══════════════════════════════════════════════════════

// ─── Page Heroes (customizable banners per page) ────────
model PageHero {
  id           String   @id @default(cuid())
  tenantId     String
  pageSlug     String // home | marketplace | recetas | negocios | tienda
  title        String?
  subtitle     String?
  imageUrl     String? // banner image URL
  ctaText      String? // button text
  ctaLink      String? // button href
  gradientFrom String? // tailwind color or hex
  gradientTo   String? // tailwind color or hex
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) // for multiple banners per page
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pageSlug, sortOrder])
  @@index([tenantId, pageSlug])
}

// ─── Pages ──────────────────────────────────────────────
enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id          String  @id @default(cuid())
  slug        String
  title       String
  description String?

  // SEO Metadata
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  // Publishing
  status      PageStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Layout
  layout   String @default("default")
  settings Json? // { headerVisible: true, footerVisible: true }
  tenantId String

  // Relations
  blocks   PageBlock[]
  versions PageVersion[]

  @@unique([tenantId, slug])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([tenantId])
}

// ─── Page Blocks ────────────────────────────────────────
model PageBlock {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Block config
  type    String // hero, about, benefits, products, cta, etc.
  order   Int // Display order
  visible Boolean @default(true)

  // Content
  props       Json // Component props
  styles      Json? // Custom styles
  mobileProps Json? // Mobile-specific props

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@index([type])
}

// ─── Block Templates ────────────────────────────────────
model BlockTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String // hero, cta, etc.
  category    String // marketing, informativo, producto

  // Template data
  props   Json
  styles  Json?
  preview String? // Preview image URL

  // Usage tracking
  isPublic   Boolean @default(false)
  usageCount Int     @default(0)
  tenantId   String? // null = global template, set = tenant-specific

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([tenantId])
}

// ─── Media Library ──────────────────────────────────────
model Media {
  id String @id @default(cuid())

  // File info
  filename String
  url      String
  mimeType String
  size     Int // bytes

  // Metadata
  alt     String?
  title   String?
  caption String?

  // Organization
  folder String   @default("general")
  tags   String[]

  // Image-specific
  width    Int?
  height   Int?
  blurhash String?

  // Usage tracking
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  tenantId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([tenantId])
}

// ─── Page Versions ──────────────────────────────────────
model PageVersion {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Snapshot
  title    String
  blocks   Json // Complete blocks array snapshot
  settings Json?

  // Metadata
  comment   String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

// ─── Theme Settings ─────────────────────────────────────
model ThemeSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // Design
  colors  Json // { primary, secondary, accent, ... }
  fonts   Json // { heading, body }
  spacing Json? // { section, container }

  // Components
  header Json? // { sticky, transparent }
  footer Json? // { showSocial }

  // Effects
  animations Json? // { enabled, speed }

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Navigation ─────────────────────────────────────────
model Navigation {
  id       String @id @default(cuid())
  tenantId String @unique
  items    Json // Array of { label, href, icon?, children? }
  settings Json? // { position, style }

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── WhatsApp Commerce: Tenant Config ───────────────────
model TenantWhatsAppConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  phoneNumberId      String // Phone Number ID de Meta Business
  whatsappToken      String // Token de acceso (Bearer)
  webhookVerifyToken String // Token de verificación del webhook
  businessName       String? // Nombre que aparece al responder
  yapeNumber         String? // Número Yape para instrucciones de pago
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([phoneNumberId])
}

// ─── WhatsApp Commerce: Sesiones de conversación ────────
model WhatsAppConversation {
  id              String   @id @default(cuid())
  tenantId        String
  phone           String // número del cliente (formato E.164 sin +)
  state           String   @default("idle") // idle | browsing | cart | checkout | awaiting_payment | completed
  cartItems       Json     @default("[]") // [{productId, name, quantity, price, unit}]
  deliveryAddress String?
  lastMessageAt   DateTime @default(now())
  expiresAt       DateTime // conversación expira en 30 min sin actividad
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([expiresAt])
}

// ─── Stripe Webhook Queue ────────────────────────────────
// Stores events that failed to be processed (e.g. DB unavailable).
// A cron job (POST /api/billing/webhook-replay) drains this queue.
model StripeWebhookQueue {
  id          String    @id @default(cuid())
  stripeId    String    @unique // Stripe event ID (idempotency key)
  eventType   String // e.g. "checkout.session.completed"
  payload     String // Raw JSON of the Stripe.Event object
  attempts    Int       @default(0) // How many replay attempts have failed
  lastError   String? // Last error message for debugging
  nextRetryAt DateTime  @default(now()) // Earliest time to retry
  processedAt DateTime? // Set when successfully replayed
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@index([nextRetryAt])
}

// ─── Mercado Pago Pending Plans ──────────────────────────
// Maps MP preference/preapproval IDs to the intended plan so webhooks
// can resolve the plan reliably without inferring from price amounts.
model MpPendingPlan {
  id            String    @id @default(cuid())
  tenantSlug    String
  plan          String // "pro" | "business" | "enterprise"
  preferenceId  String?   @unique // ID de preferencia (pago único)
  preapprovalId String?   @unique // ID de preapproval (suscripción)
  externalRef   String // external_reference enviado a MP
  status        String    @default("pending") // pending | approved | cancelled | expired
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime? // cuando el webhook procesó el pago

  @@index([tenantSlug])
  @@index([externalRef])
}

// ─── Quick Notes (Admin) ─────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String   @default("")
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Message Templates ───────────────────────────────────
model MessageTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  channel       String // whatsapp | email | sms
  category      String // ventas | cobranza | delivery | promociones | atención | general
  subject       String?
  body          String
  variablesJson String   @default("[]") // JSON array of variable names
  starred       Boolean  @default(false)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// ─── Smart Reminders ─────────────────────────────────────
model Reminder {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  description   String   @default("")
  type          String // pago | inventario | tarea | vencimiento | cliente | general
  priority      String   @default("media") // alta | media | baja
  status        String   @default("pendiente") // pendiente | completado | vencido
  dueDate       DateTime
  autoGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

// ─── Inventory Batches (Lotes) ────────────────────────────
model Batch {
  id              String   @id @default(cuid())
  tenantId        String
  lote            String
  productName     String
  productCategory String   @default("Otros")
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String   @default("unidad")
  supplierId      String?
  supplierName    String   @default("")
  entryDate       DateTime
  expiryDate      DateTime
  costUnit        Decimal  @default(0) @db.Decimal(12, 2)
  notes           String   @default("")
  productId       Int? // FK to Product catalogue (optional, backward compat)
  warehouseId     String? // FK to Warehouse where this batch is stored
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([expiryDate])
  @@index([productId])
  @@index([warehouseId])
  // Perf 2026-05-29: compuesto para getExpiring (filtra tenant + rango expiryDate,
  // ordena expiryDate asc) — el widget de lotes por vencer (7 consumidores).
  @@index([tenantId, expiryDate])
}

// ─── Saved Filters ───────────────────────────────────────
model SavedFilter {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  description    String   @default("")
  module         String
  conditionsJson String   @default("[]") // JSON array of { field, operator, value }
  isDefault      Boolean  @default(false)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// ─── Customer Chat (Live Chat Widget) ───────────────────
model ChatMessage {
  id            String   @id @default(cuid())
  customerPhone String
  customerName  String   @default("Cliente")
  sender        String // "customer" | "admin"
  message       String
  read          Boolean  @default(false)
  tenantId      String
  createdAt     DateTime @default(now())

  @@index([customerPhone])
  @@index([read])
  @@index([tenantId])
}

// ─── A/B Testing ────────────────────────────────────────
model ABTest {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  variants    Json // Array of { id: string, label: string, weight: number }
  active      Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())

  @@index([active])
  @@index([tenantId])
}

model ABTestEvent {
  id        String   @id @default(cuid())
  testId    String
  variantId String
  visitorId String // anonymous cookie or phone
  event     String // "impression" | "conversion"
  value     Decimal? @db.Decimal(12, 2) // optional conversion value
  tenantId  String
  createdAt DateTime @default(now())

  @@index([testId, variantId])
  @@index([visitorId])
  @@index([tenantId])
}

// ─── Customer Feedback Surveys ──────────────────────────
model SurveyResponse {
  id            String   @id @default(cuid())
  orderId       String
  customerPhone String?
  rating        Int // 1-5 stars
  comment       String   @default("")
  type          String   @default("nps") // nps, csat, etc.
  tenantId      String
  createdAt     DateTime @default(now())

  @@unique([orderId, type])
  @@index([customerPhone])
  @@index([type])
  @@index([tenantId])
}

// ─── Tenant Invitation ───────────────────────────────────
// Superadmin or tenant admins can invite users via signed email links.
model TenantInvitation {
  id        String   @id @default(cuid())
  tenantId  String // slug of the target tenant
  email     String
  role      String   @default("editor") // admin | editor | viewer
  token     String   @unique // 32-byte random hex, single-use
  status    String   @default("pending") // pending | accepted | expired
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([tenantId])
  @@index([email])
}

// ─── Order Status History ────────────────────────────────
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String? // admin user identifier or "system"
  note       String?
  tenantId   String
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([tenantId])
}

// ─── Newsletter Subscribers ─────────────────────────────
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─── Cron Dead Letter ───────────────────────────────────
model CronDeadLetter {
  id        String   @id @default(cuid())
  jobName   String
  error     String
  attempts  Int
  payload   String?
  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
}

model CronHealthLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName    String
  status     String
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  @@index([jobName, createdAt])
  @@index([createdAt])
}

// ─── Warehouses ─────────────────────────────────────────
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String
  type      String   @default("principal") // principal | secundario | punto-venta | deposito | frigorifico
  location  String   @default("")
  manager   String   @default("Administrador")
  capacity  Int      @default(10000)
  active    Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations          Location[]
  transfersFrom      Transfer[]          @relation("TransferFromWarehouse")
  transfersTo        Transfer[]          @relation("TransferToWarehouse")
  batches            Batch[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Transfer {
  id              String    @id @default(cuid())
  code            String
  fromWarehouseId String
  toWarehouseId   String
  productId       Int
  quantity        Int
  unit            String    @default("und")
  status          String    @default("pendiente")
  requestedBy     String
  requestDate     DateTime  @default(now())
  deliveredDate   DateTime?
  notes           String    @default("")
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fromWarehouse Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
}

model Location {
  id          String   @id @default(cuid())
  code        String
  zone        String
  aisle       String   @default("")
  shelf       String   @default("")
  bin         String   @default("")
  warehouseId String
  productId   Int?
  qty         Int      @default(0)
  capacity    Int      @default(0)
  category    String   @default("")
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
}

// ─── API Keys (Business plan) ────────────────────────────
// Programmatic access for Business-tier tenants via Bearer tokens.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String // slug of the owning tenant
  name       String // human-readable label
  keyPrefix  String // first 10 chars of the raw key (shown in UI)
  keyHash    String    @unique // SHA-256 of the full raw key
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([tenantId])
  @@index([keyHash])
}

// ─── Visitor Welcome Survey ──────────────────────────────
// Stores first-time visitor feedback submitted via the welcome modal.
model VisitorWelcome {
  id        String   @id @default(cuid())
  name      String
  devices   String // JSON array: ["celular","tablet","computadora"]
  userAgent String?
  tenantId  String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ─── Marketing Campaigns ──────────────────────────────────────────────────────
model Campaign {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  message       String    @db.Text
  segment       String    @default("todos") // todos | vip | inactivos | cumpleanos | deudores
  channel       String    @default("whatsapp") // whatsapp | inapp | ambos
  status        String    @default("borrador") // borrador | programada | activa | completada | cancelada
  scheduledAt   DateTime?
  sentAt        DateTime?
  totalAudience Int       @default(0)
  delivered     Int       @default(0)
  opened        Int       @default(0)
  conversions   Int       @default(0)
  revenue       Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ─── Commission Rules (tiered % per employee) ─────────────────────────────────
model CommissionRule {
  id        String   @id @default(cuid())
  tenantId  String
  cashierId String // matches adminUser.username
  label     String   @default("") // e.g. "Nivel base", "Objetivo Q1"
  minSales  Decimal  @default(0) // minimum revenue to qualify @db.Decimal(12, 2)
  maxSales  Decimal? @db.Decimal(12, 2) // null = no upper limit
  rate      Decimal  @default(0) @db.Decimal(5, 4) // commission % applied to revenue (e.g. 0.0500 = 5%)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, cashierId, minSales])
  @@index([tenantId])
  @@index([cashierId])
}

// ═══════════════════════════════════════════════════════
// CIERRE DIARIO (resumen del día)
// ═══════════════════════════════════════════════════════

model DailySummary {
  id               String   @id @default(cuid())
  tenantId         String
  fecha            DateTime
  totalVentas      Decimal  @default(0) @db.Decimal(10, 2)
  cantidadVentas   Int      @default(0)
  ticketPromedio   Decimal  @default(0) @db.Decimal(10, 2)
  efectivoContado  Decimal? @db.Decimal(10, 2)
  efectivoEsperado Decimal  @default(0) @db.Decimal(10, 2)
  diferenciaCaja   Decimal  @default(0) @db.Decimal(10, 2)
  fiadosCobrados   Decimal  @default(0) @db.Decimal(10, 2)
  fiadosNuevos     Decimal  @default(0) @db.Decimal(10, 2)
  fiadosVencidos   Int      @default(0)
  mejorHora        String?
  productoTop      String?
  stockAlertas     String? // JSON string
  notas            String?
  creadoPor        String
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fecha])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════
// FIADOS (ventas a crédito informal)
// ═══════════════════════════════════════════════════════

enum FiadoStatus {
  ACTIVO
  PAGADO
  VENCIDO
  CANCELADO
}

model Fiado {
  id          String       @id @default(cuid())
  tenantId    String
  customerId  String
  total       Decimal      @db.Decimal(10, 2)
  saldo       Decimal      @db.Decimal(10, 2)
  descripcion String?
  status      FiadoStatus  @default(ACTIVO)
  fechaVence  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [phone], onDelete: Restrict)
  cuotas      FiadoCuota[]

  @@index([tenantId, status])
  @@index([customerId])
}

model FiadoCuota {
  id        String    @id @default(cuid())
  fiadoId   String
  monto     Decimal   @db.Decimal(10, 2)
  pagadoEn  DateTime?
  notas     String?
  createdAt DateTime  @default(now())
  fiado     Fiado     @relation(fields: [fiadoId], references: [id], onDelete: Cascade)

  @@index([fiadoId])
}

// ═══════════════════════════════════════════════════════
// TURNOS (control de personal)
// ═══════════════════════════════════════════════════════

enum TurnoStatus {
  ABIERTO
  CERRADO
}

model Turno {
  id             String      @id @default(cuid())
  tenantId       String
  adminUserId    String
  // T5 (audit ventas-caja 2026-05-07): asocia el turno a un CashRegister
  // especifico para multi-caja real. Nullable hasta migrar turnos legados.
  cashRegisterId String?
  inicioEfectivo Decimal     @default(0) @db.Decimal(10, 2)
  cierreEfectivo Decimal?    @db.Decimal(10, 2)
  ventasTotal    Decimal     @default(0) @db.Decimal(10, 2)
  status         TurnoStatus @default(ABIERTO)
  abrioEn        DateTime    @default(now())
  cerroEn        DateTime?
  notas          String?
  createdAt      DateTime    @default(now())
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUser      AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([adminUserId])
  @@index([cashRegisterId])
}

// ═══════════════════════════════════════════════════════
// RECETAS Y PRODUCCIÓN
// ═══════════════════════════════════════════════════════

model Receta {
  id            String              @id @default(cuid())
  tenantId      String
  nombre        String
  descripcion   String?
  productoId    Int?
  costoTotal    Decimal             @default(0) @db.Decimal(10, 2)
  activa        Boolean             @default(true)
  emoji         String?
  tiempoMinutos Int?
  porciones     Int?
  dificultad    String? // "Facil" | "Media" | "Dificil"
  categoria     String? // "Entradas" | "Platos de fondo" | "Sopas" | "Postres" | "Bebidas"
  pasosJson     String? // JSON array of steps
  imageUrl      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto      Product?            @relation("RecetaProducto", fields: [productoId], references: [id], onDelete: Restrict)
  ingredientes  RecetaIngrediente[]
  producciones  ProduccionLote[]

  @@index([tenantId])
}

model RecetaIngrediente {
  id         String  @id @default(cuid())
  recetaId   String
  productoId Int
  cantidad   Decimal @db.Decimal(10, 3)
  unidad     String  @default("unidad")
  receta     Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  producto   Product @relation("IngredienteProducto", fields: [productoId], references: [id], onDelete: Restrict)

  @@index([recetaId])
}

model ProduccionLote {
  id          String   @id @default(cuid())
  tenantId    String
  recetaId    String
  cantidad    Decimal  @db.Decimal(10, 2)
  costoReal   Decimal  @default(0) @db.Decimal(10, 2)
  notas       String?
  producidoEn DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receta      Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([recetaId])
}

// ═══════════════════════════════════════════════════════
// PRÉSTAMOS
// ═══════════════════════════════════════════════════════

enum PrestamoStatus {
  ACTIVO
  PAGADO
  VENCIDO
  CANCELADO
}

enum PrestamoTipo {
  PERSONAL
  BANCARIO
  TERCERO
  PROVEEDOR
}

enum PrestamoDireccion {
  DADO
  RECIBIDO
}

enum PrestamoEntidadTipo {
  BANCO
  PERSONA_NATURAL
  EMPRESA
  PROVEEDOR
}

enum PrestamoSistemaAmortizacion {
  FRANCES
  ALEMAN
  AMERICANO
}

model Prestamo {
  id                  String                      @id @default(cuid())
  tenantId            String
  customerId          String?
  // ── Tipo y dirección ──
  tipo                PrestamoTipo                @default(PERSONAL)
  direccion           PrestamoDireccion           @default(DADO)
  // ── Entidad (banco/persona/proveedor) ──
  entidadNombre       String?
  entidadTipo         PrestamoEntidadTipo?
  nroOperacion        String?
  // ── Montos y tasas ──
  monto               Decimal                     @db.Decimal(12, 2)
  moneda              String                      @default("PEN")
  tasaInteres         Decimal                     @default(0) @db.Decimal(5, 2)
  tea                 Decimal?                    @db.Decimal(6, 4)
  moraInteres         Decimal                     @default(0) @db.Decimal(5, 2)
  // ── Cuotas y amortización ──
  numeroCuotas        Int                         @default(1)
  sistemaAmortizacion PrestamoSistemaAmortizacion @default(FRANCES)
  periodoGracia       Int                         @default(0)
  // ── Estado ──
  status              PrestamoStatus              @default(ACTIVO)
  // ── Fechas ──
  fechaDesembolso     DateTime?
  fechaVencimiento    DateTime?
  // ── Extras ──
  garantia            String?
  notas               String?
  // ── Timestamps ──
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  // ── Relations ──
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?                   @relation(fields: [customerId], references: [phone], onDelete: SetNull)
  cuotas              PrestamoCuota[]
  documentos          PrestamoDocumento[]

  @@index([tenantId, status])
  @@index([tenantId, tipo])
  @@index([tenantId, direccion])
  @@index([customerId])
}

model PrestamoCuota {
  id            String    @id @default(cuid())
  prestamoId    String
  numeroCuota   Int
  monto         Decimal   @db.Decimal(12, 2)
  capital       Decimal   @default(0) @db.Decimal(12, 2)
  interes       Decimal   @default(0) @db.Decimal(12, 2)
  fechaVence    DateTime
  pagadoEn      DateTime?
  montoPagado   Decimal?  @db.Decimal(12, 2)
  moraCalculada Decimal   @default(0) @db.Decimal(12, 2)
  prestamo      Prestamo  @relation(fields: [prestamoId], references: [id], onDelete: Cascade)

  @@index([prestamoId])
  @@index([fechaVence])
}

model PrestamoDocumento {
  id         String   @id @default(cuid())
  prestamoId String
  nombre     String
  tipo       String   @default("otro")
  url        String
  createdAt  DateTime @default(now())
  prestamo   Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)

  @@index([prestamoId])
}

// ═══════════════════════════════════════════════════════
// TESORERÍA (Cuentas bancarias, cajas, movimientos)
// ═══════════════════════════════════════════════════════

enum TreasuryCuentaTipo {
  BANCO_AHORRO
  BANCO_CORRIENTE
  CAJA_FISICA
  MONEDERO_DIGITAL
}

enum TreasuryMovimientoTipo {
  INGRESO
  EGRESO
  TRANSFERENCIA_IN
  TRANSFERENCIA_OUT
}

enum TreasuryMovimientoOrigen {
  MANUAL
  VENTA
  GASTO
  PRESTAMO_DADO
  PRESTAMO_CUOTA
  COMPRA_PROVEEDOR
  CIERRE_CAJA
  TRANSFERENCIA
  OTRO
}

model TreasuryCuenta {
  id           String             @id @default(cuid())
  tenantId     String
  nombre       String // "BCP Ahorro", "Caja principal", "Yape"
  tipo         TreasuryCuentaTipo
  banco        String? // "BCP", "Interbank", "BBVA", etc.
  numeroCuenta String? // Número de cuenta bancaria
  cci          String? // Código interbancario
  moneda       String             @default("PEN")
  saldo        Decimal            @default(0) @db.Decimal(12, 2)
  saldoInicial Decimal            @default(0) @db.Decimal(12, 2)
  activa       Boolean            @default(true)
  color        String? // Color para UI: "#3b82f6"
  notas        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movimientos           TreasuryMovimiento[]
  transferenciasOrigen  TreasuryTransferencia[] @relation("TransferenciaOrigen")
  transferenciasDestino TreasuryTransferencia[] @relation("TransferenciaDestino")

  @@index([tenantId, activa])
  @@index([tenantId, tipo])
}

model TreasuryMovimiento {
  id             String                   @id @default(cuid())
  tenantId       String
  cuentaId       String
  tipo           TreasuryMovimientoTipo
  origen         TreasuryMovimientoOrigen @default(MANUAL)
  monto          Decimal                  @db.Decimal(12, 2)
  saldoAnterior  Decimal                  @default(0) @db.Decimal(12, 2)
  saldoPosterior Decimal                  @default(0) @db.Decimal(12, 2)
  descripcion    String                   @default("")
  referencia     String? // ID de venta, gasto, préstamo, etc.
  categoria      String? // Para agrupar: "ventas", "nómina", etc.
  createdAt      DateTime                 @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta TreasuryCuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([cuentaId, createdAt])
  @@index([tenantId, origen])
}

model TreasuryTransferencia {
  id          String   @id @default(cuid())
  tenantId    String
  origenId    String
  destinoId   String
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String   @default("")
  createdAt   DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  origen  TreasuryCuenta @relation("TransferenciaOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destino TreasuryCuenta @relation("TransferenciaDestino", fields: [destinoId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════
// COTIZACIONES (Presupuestos)
// ═══════════════════════════════════════════════════════

enum CotizacionStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

model Cotizacion {
  id            String           @id @default(cuid())
  tenantId      String
  numero        String // correlativo: COT-0001
  customerId    String?
  clienteNombre String
  clienteRuc    String?
  validoHasta   DateTime
  status        CotizacionStatus @default(BORRADOR)
  subtotal      Decimal          @default(0) @db.Decimal(10, 2)
  igv           Decimal          @default(0) @db.Decimal(10, 2)
  total         Decimal          @default(0) @db.Decimal(10, 2)
  notas         String?
  createdBy     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?        @relation(fields: [customerId], references: [phone], onDelete: SetNull)
  items         CotizacionItem[]

  @@index([tenantId, status])
  @@index([numero])
}

model CotizacionItem {
  id           String     @id @default(cuid())
  cotizacionId String
  productoId   String?
  descripcion  String
  cantidad     Decimal    @db.Decimal(10, 3)
  precioUnit   Decimal    @db.Decimal(10, 2)
  descuento    Decimal    @default(0) @db.Decimal(5, 2)
  subtotal     Decimal    @db.Decimal(10, 2)
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
}

// ═══════════════════════════════════════════════════════
// GUÍAS DE REMISIÓN
// ═══════════════════════════════════════════════════════

enum GuiaStatus {
  BORRADOR
  EMITIDA
  EN_TRANSITO
  ENTREGADA
  ANULADA
}

model GuiaRemision {
  id                    String             @id @default(cuid())
  tenantId              String
  numero                String // GRR-0001
  orderId               String?
  motivoTraslado        String // VENTA, TRASLADO_ALMACEN, DEVOLUCION, etc.
  fechaTraslado         DateTime
  destinatarioNombre    String
  destinatarioRuc       String?
  destinatarioDireccion String
  transportistaRuc      String?
  transportistaNombre   String?
  vehiculoPlaca         String?
  conductorNombre       String?
  conductorDni          String?
  bultos                Int?
  documentoRef          String? // Factura, boleta u orden que ampara el traslado
  puntoPartida          String
  puntoLlegada          String
  status                GuiaStatus         @default(BORRADOR)
  pesoTotal             Decimal?           @db.Decimal(10, 3)
  pesoBruto             Decimal?           @db.Decimal(10, 3)
  notas                 String?
  createdBy             String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order                 Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items                 GuiaRemisionItem[]

  @@index([tenantId, status])
  @@index([numero])
}

model GuiaRemisionItem {
  id           String       @id @default(cuid())
  guiaId       String
  productoId   String?
  descripcion  String
  cantidad     Decimal      @db.Decimal(10, 3)
  unidad       String       @default("NIU")
  pesoUnitario Decimal?     @db.Decimal(10, 3)
  guia         GuiaRemision @relation(fields: [guiaId], references: [id], onDelete: Cascade)

  @@index([guiaId])
}

// ═══════════════════════════════════════════════════════
// NOTAS DE CRÉDITO
// ═══════════════════════════════════════════════════════

enum NotaCreditoStatus {
  BORRADOR
  EMITIDA
  ANULADA
}

model NotaCredito {
  id           String            @id @default(cuid())
  tenantId     String
  numero       String // NC-0001
  orderId      String?
  saleId       String?
  motivoCodigo String // 01=anulación, 02=anulación por error RUC, etc.
  motivoDesc   String
  monto        Decimal           @db.Decimal(10, 2)
  igv          Decimal           @default(0) @db.Decimal(10, 2)
  total        Decimal           @db.Decimal(10, 2)
  status       NotaCreditoStatus @default(BORRADOR)
  notas        String?
  createdBy    String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([numero])
}

// ═══════════════════════════════════════════════════════
// NOTIFICATION CENTER (admin in-app notifications)
// ═══════════════════════════════════════════════════════

model Notification {
  id          String    @id @default(cuid())
  tenantId    String
  type        String // FIADO_VENCIDO, STOCK_CRITICO, VENTA_ALTA, TURNO_SIN_CERRAR, DIFERENCIA_CAJA, PROVEEDOR_VENCIDO, META_ALCANZADA, CLIENTE_INACTIVO
  severity    String // HIGH, MEDIUM, LOW
  title       String
  body        String
  actionUrl   String?
  actionLabel String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt])
  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════
// CONTEO FÍSICO (Physical Inventory Count)
// ═══════════════════════════════════════════════════════

model ConteoFisico {
  id          String             @id @default(cuid())
  tenantId    String
  tipo        String             @default("completo") // completo, categoria, ubicacion
  status      String             @default("INICIADO") // INICIADO, EN_PROGRESO, CERRADO
  creadoPor   String
  fechaInicio DateTime           @default(now())
  fechaCierre DateTime?
  items       ConteoFisicoItem[]
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model ConteoFisicoItem {
  id           String       @id @default(cuid())
  conteoId     String
  productId    Int
  stockSistema Int
  stockContado Int?
  diferencia   Int?
  ajustado     Boolean      @default(false)
  conteo       ConteoFisico @relation(fields: [conteoId], references: [id], onDelete: Cascade)

  @@index([conteoId])
}

// ─── Discount Rules (POS promotions) ────────────────────
model DiscountRule {
  id          String   @id @default(cuid())
  nombre      String
  tipo        String // porcentaje, 2x1, 3x2, combo, monto_fijo
  valor       Decimal  @default(0) @db.Decimal(12, 2)
  categorias  String   @default("[]") // JSON array
  condicion   String?
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([activa, tenantId])
}

// ─── Supplier Returns ────────────────────────────────────
model SupplierReturn {
  id              String   @id @default(cuid())
  proveedorId     String?
  proveedorNombre String
  motivo          String
  estado          String   @default("PENDIENTE") // PENDIENTE, ENVIADA, RESUELTA
  notas           String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items SupplierReturnItem[]

  @@index([tenantId])
  @@index([estado, tenantId])
}

model SupplierReturnItem {
  id       Int    @id @default(autoincrement())
  returnId String
  nombre   String
  cantidad Float
  unidad   String @default("und")

  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// ─── Compliance Items (regulatory tracking) ─────────────
model ComplianceItem {
  id          String    @id @default(cuid())
  title       String
  entity      String
  category    String // sunat, municipal, sanitario, seguridad
  frequency   String
  nextDue     DateTime
  status      String    @default("pendiente") // vigente, por-vencer, vencido, pendiente
  lastFiled   DateTime?
  description String    @default("")
  documents   Json      @default("[]")
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([status, tenantId])
  @@index([nextDue, tenantId])
}

// ─── Custom KPIs (business metrics) ─────────────────────
model CustomKpi {
  id            String   @id @default(cuid())
  name          String
  description   String?
  formula       String?
  currentValue  Float?   @default(0)
  target        Float?   @default(0)
  unit          String?  @default("S/")
  trend         String?  @default("flat") // up, down, flat
  changePercent Float?   @default(0)
  period        String?  @default("Hoy")
  category      String?  @default("Ventas")
  color         String?  @default("bg-emerald-500")
  history       Json     @default("[]")
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([category, tenantId])
}

// ══════════════════════════════════════════════════════════
// ██ MARKETPLACE
// ══════════════════════════════════════════════════════════

model Store {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                String               @unique
  name                String
  description         String?
  logo                String?
  banner              String?
  category            String               @default("bodega")
  zone                String?
  lat                 Float?
  lng                 Float?
  rating              Float                @default(0)
  reviewCount         Int                  @default(0)
  isPublished         Boolean              @default(false)
  vacationMode        Boolean              @default(false)
  vacationMessage     String?
  whatsappPublic      String? // WhatsApp público que el dueño publica para que los clientes le escriban (FAB del storefront). Distinto de ownerPhone (PII interna del dueño).
  commission          Decimal              @default(5.0) @db.Decimal(5, 2) // marketplace commission %, e.g. 5.00
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  products            StoreProduct[]
  permissions         StorePermission[]
  reviews             Review[]
  banners             StoreBanner[]
  stockoutPredictions StockoutPrediction[]
  salesAnomalies      SalesAnomaly[]
  sponsoredBoosts     SponsoredBoost[]
  deliveryRoutes      DeliveryRoute[]
  conversationThreads ConversationThread[]
  posts               StorePost[]

  @@index([tenantId])
  // Audit #3 (Brandon 2026-05-30): listado del directorio /tiendas ordena por
  // rating/reviewCount y filtra por isPublished + zona. Antes: seq scan sobre Store.
  @@index([isPublished, rating(sort: Desc), reviewCount(sort: Desc)])
  @@index([isPublished, zone])
}

// ─── ADR-130 — Publicaciones por tienda (feed social + comentarios) ──────────
// Feed editorial del dueño (texto + imagen) que los vecinos comentan. Retención.
// Migración ADITIVA (2 tablas nuevas). Plantilla: Review (tenantId/status/soft-del).
model StorePost {
  id           String             @id @default(cuid())
  tenantId     String
  storeId      String
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  body         String
  imageUrl     String?
  pinned       Boolean            @default(false)
  status       String             @default("published") // published | hidden
  likeCount    Int                @default(0)
  commentCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  comments     StorePostComment[]

  @@index([tenantId])
  @@index([storeId, status, pinned, createdAt(sort: Desc)], name: "StorePost_store_feed_idx")
}

model StorePostComment {
  id         String    @id @default(cuid())
  tenantId   String
  postId     String
  post       StorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customerId String?
  authorName String
  body       String
  status     String    @default("published") // published | hidden
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([postId, status, createdAt], name: "StorePostComment_post_idx")
}

model StoreBanner {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  Int       @default(0)
  section   String    @default("hero")
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
  @@index([tenantId])
  @@index([storeId, section, position])
}

model StoreProduct {
  id                  String               @id @default(cuid())
  storeId             String
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailPrice         Decimal              @db.Decimal(12, 2)
  wholesalePrice      Decimal?             @db.Decimal(12, 2)
  minOrderQty         Int                  @default(1)
  isActive            Boolean              @default(true)
  volumePricingTiers  Json? // [{ minQty: 10, discount: 5 }, ...]
  /// ADR-081: precio promocional efectivo. Null = sin oferta vigente.
  discountPrice       Decimal?             @db.Decimal(12, 2)
  /// Fecha de vencimiento de la oferta. Null = sin caducidad.
  discountUntil       DateTime?
  /// Texto opcional para chips ("2x1", "Liquidación", "-30%"). Max 40 chars.
  discountLabel       String?              @db.VarChar(40)
  stockoutPredictions StockoutPrediction[]

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([discountUntil])
  // Audit #3 (Brandon 2026-05-30): todo query de catálogo filtra isActive + storeId.
  @@index([storeId, isActive])
}

model DeliveryPartner {
  id             String               @id @default(cuid())
  name           String
  phone          String
  email          String?
  zone           String
  vehicleType    String               @default("moto")
  isActive       Boolean              @default(true)
  rating         Float                @default(5.0)
  fee            Decimal              @default(5.0) @db.Decimal(12, 2)
  notes          String? // JSON: { notifyWhatsApp, notifyEmail, notifyUrgent }
  // ── Rappi-style realtime fields (ADR-087) ─────────────────────────────
  passwordHash   String? // bcrypt — null hasta que el partner active login
  lat            Float? // GPS actual
  lng            Float?
  lastPingAt     DateTime? // heartbeat — ping cada 30s desde la app
  isOnline       Boolean              @default(false) // si recibe ofertas
  currentOrderId String? // si está atendiendo, no recibe más ofertas
  acceptanceRate Float                @default(1.0) // % accept histórico (0..1)
  maxRadiusKm    Float                @default(5.0) // radio max para ofertas
  totalOffers    Int                  @default(0)
  totalAccepted  Int                  @default(0)
  score          Int                  @default(0)
  // ──────────────────────────────────────────────────────────────────────
  tenantId       String
  createdAt      DateTime             @default(now())
  assignments    DeliveryAssignment[]
  offers         DeliveryOffer[]
  payouts        PartnerPayout[]

  @@index([tenantId])
  @@index([tenantId, isOnline, currentOrderId])
}

// ─── Retiros (cash-out) del repartidor a Yape ─────────────────────────
// Patrón Rappi/Uber "Cobra ya". El saldo disponible se calcula en backend
// (Σ fee+propina de entregas completadas − Σ retiros pending|paid). Un
// retiro `pending` aparta el dinero; el dueño lo marca `paid` tras yapear,
// o `rejected` para liberarlo. Decimal(12,2) como el resto del dinero.
model PartnerPayout {
  id         String          @id @default(cuid())
  partnerId  String
  partner    DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenantId   String
  amount     Decimal         @db.Decimal(12, 2)
  yapeNumber String // celular Yape destino (9 dígitos)
  status     String          @default("pending") // pending | paid | rejected
  note       String? // referencia de pago o motivo de rechazo
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([tenantId])
  @@index([partnerId, status])
}

// ─── Rappi-style cascading offer system (ADR-087) ─────────────────────
// Cada DeliveryOffer es una "invitación" a un partner. Si rechaza/expira,
// el cron crea otra para el siguiente más cercano. Cuando 1 acepta, se
// crea el DeliveryAssignment y se cancelan todas las offers pending.
model DeliveryOffer {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  status      String          @default("pending") // pending | accepted | rejected | expired | cancelled
  offeredAt   DateTime        @default(now())
  expiresAt   DateTime // offeredAt + 2 min (configurable)
  respondedAt DateTime?
  distanceKm  Float
  feeOffered  Decimal         @db.Decimal(12, 2)
  attempt     Int             @default(1) // 1 = primer candidato, 2 = segundo, etc
  tenantId    String

  @@index([orderId, status])
  @@index([partnerId, status])
  @@index([status, expiresAt])
  @@index([tenantId])
}

model DeliveryAssignment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  status         String          @default("assigned")
  fee            Decimal         @db.Decimal(12, 2)
  tipAmount      Decimal         @default(0) @db.Decimal(12, 2)
  tipMessage     String?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  routeStartedAt DateTime?
  proofPhotoUrl  String?
  notes          String?
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([partnerId])
  @@index([tenantId])
}

// ─── SOS Alerts (repartidor en peligro) ──────────────────────────────────────
model DeliverySOSAlert {
  id         String    @id @default(cuid())
  partnerId  String
  lat        Float
  lng        Float
  message    String?
  status     String    @default("active") // active | resolved | false_alarm
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([partnerId])
  @@index([status])
}

// ─── Bloque D1 — Delivery vivo ────────────────────────────

// Schema alineado con MANUAL-marketplace-bloque-d1.sql aplicado 2026-04-08 (Supabase us-east-2).
// Los modelos usan nombres en PascalCase que matchean la tabla real (no se agrega @map
// porque el SQL ya creó las tablas con esos nombres exactos).

model DeliveryTracking {
  id           String   @id
  tenantId     String
  orderId      String
  status       String // preparing|ready|picked_up|in_transit|nearby|delivered|failed|cancelled
  description  String?
  lat          Float?
  lng          Float?
  distanceM    Int?
  etaMinutes   Int?
  actorId      String?
  actorType    String   @default("system") // driver|system|admin|customer
  photoUrl     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([orderId, createdAt(sort: Desc)], name: "DeliveryTracking_orderId_createdAt_idx")
  @@index([tenantId, status])
}

model DeliveryRoute {
  id             String    @id
  tenantId       String
  storeId        String
  driverId       String
  driverName     String
  driverPhone    String?
  vehicleType    String    @default("moto") // moto|bici|auto|caminando
  status         String    @default("planned") // planned|in_progress|completed|cancelled
  plannedStartAt DateTime
  actualStartAt  DateTime?
  completedAt    DateTime?
  totalStops     Int       @default(0)
  completedStops Int       @default(0)
  totalDistanceM Int?
  optimizedByAi  Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stops DeliveryRouteStop[]

  @@index([tenantId])
  @@index([storeId])
  @@index([driverId])
  @@index([storeId, status])
  @@index([tenantId, plannedStartAt(sort: Desc)], name: "DeliveryRoute_tenantId_plannedStartAt_idx")
}

model DeliveryRouteStop {
  id                 String    @id
  tenantId           String
  routeId            String
  orderId            String
  sequence           Int
  status             String    @default("pending") // pending|arrived|delivered|failed|skipped
  address            String
  addressDetail      String?
  lat                Float?
  lng                Float?
  customerName       String
  customerPhone      String?
  estimatedArrivalAt DateTime?
  actualArrivalAt    DateTime?
  completedAt        DateTime?
  failureReason      String?
  proofPhotoUrl      String?
  proofSignatureUrl  String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  route DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@index([routeId])
  @@index([orderId])
  @@index([routeId, status])
}

// ─── Bloque D2 — Chat buyer ↔ seller ─────────────────────
// Schema alineado con MANUAL-marketplace-bloque-d2.sql aplicado 2026-04-08.
// Los hilos viven del lado del tenant VENDEDOR (dueño de la tienda).
// Un buyer puede tener varios hilos cerrados pero sólo uno abierto por
// (storeId, customerPhone, orderId|null).

model ConversationThread {
  id              String    @id
  tenantId        String
  storeId         String
  orderId         String?
  customerPhone   String
  customerName    String
  subject         String?
  status          String    @default("open") // open|closed|archived|blocked
  unreadForBuyer  Int       @default(0)
  unreadForSeller Int       @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?
  lastSenderType  String? // buyer|seller|system
  closedAt        DateTime?
  closedReason    String?
  // Tanda 3 (Brandon 2026-06-11): etiquetas de triage del vendedor
  // (Nuevo·Pagado·Reclamo·custom). JSON array de strings. Compartidas entre
  // cajeros. Aplicada via apply_migration add_conversation_thread_labels_json.
  labelsJson      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@index([tenantId])
  @@index([storeId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt(sort: Desc)], name: "ConversationThread_tenantId_lastMessageAt_idx")
  @@index([customerPhone])
  @@index([orderId])
}

model ConversationMessage {
  id             String    @id
  tenantId       String
  threadId       String
  senderType     String // buyer|seller|system
  senderId       String?
  senderName     String
  body           String
  messageType    String    @default("text") // text|image|system_event|quote|order_link
  attachmentUrl  String?
  metadataJson   String?
  readByBuyerAt  DateTime?
  readBySellerAt DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([threadId])
  @@index([threadId, createdAt(sort: Desc)], name: "ConversationMessage_threadId_createdAt_idx")
  @@index([senderType])
}

// ══════════════════════════════════════════════════════════
// ██ MESSENGER PLATAFORMA ↔ TENANTS (superadmin) — ADR-132
// ══════════════════════════════════════════════════════════
// Conversaciones bidireccionales entre el superadmin (plataforma) y los dueños
// de tenants. Modelo dedicado (NO ConversationThread, que es buyer↔seller).
// senderType: platform|tenant|system. Acceso vía lib/db/platform-chat.db.ts.

model PlatformConversation {
  id                String    @id @default(cuid())
  tenantId          String // tenant interlocutor
  tenantName        String
  subject           String?
  status            String    @default("open") // open|closed|archived
  priority          String    @default("medium") // low|medium|high
  assignedTo        String? // username del superadmin asignado
  labelsJson        String? // JSON array de strings (triage)
  unreadForPlatform Int       @default(0)
  unreadForTenant   Int       @default(0)
  lastMessageAt     DateTime?
  lastMessageText   String?
  lastSenderType    String? // platform|tenant|system
  createdBy         String    @default("platform")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages PlatformMessage[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedTo])
  @@index([lastMessageAt(sort: Desc)], name: "PlatformConversation_lastMessageAt_idx")
  @@index([tenantId, status])
}

model PlatformMessage {
  id               String    @id @default(cuid())
  conversationId   String
  tenantId         String
  senderType       String // platform|tenant|system
  senderName       String
  senderId         String?
  body             String
  messageType      String    @default("text") // text|image|broadcast|note|system_event
  attachmentUrl    String?
  isInternalNote   Boolean   @default(false) // solo visible al superadmin
  metadataJson     String?
  readByPlatformAt DateTime?
  readByTenantAt   DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  conversation PlatformConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
  @@index([conversationId, createdAt(sort: Desc)], name: "PlatformMessage_conversationId_createdAt_idx")
}

// Notas internas del superadmin sobre un tenant (CRM). Solo plataforma — NO el
// modelo Note (ese es del admin del negocio). Brandon 2026-06-14 (bundle C).
model PlatformTenantNote {
  id        String   @id @default(cuid())
  tenantId  String
  body      String
  author    String   @default("superadmin")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)], name: "PlatformTenantNote_tenantId_createdAt_idx")
}

model WholesaleOrder {
  id             String               @id @default(cuid())
  buyerTenantId  String
  sellerTenantId String
  // CONTRACT aplicado — backfill via MANUAL-p0-wholesale-order-tenantid-not-null.sql
  tenantId       String
  status         String               @default("pending")
  total          Decimal              @db.Decimal(12, 2)
  commission     Decimal              @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          WholesaleOrderItem[]
  tenant         Tenant               @relation("WholesaleOrderTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([buyerTenantId])
  @@index([sellerTenantId])
  @@index([tenantId])
}

model WholesaleOrderItem {
  id               String         @id @default(cuid())
  wholesaleOrderId String
  order            WholesaleOrder @relation(fields: [wholesaleOrderId], references: [id], onDelete: Cascade)
  productId        Int
  name             String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  appliedDiscount  Decimal        @default(0) @db.Decimal(5, 2) // porcentaje de descuento por volumen aplicado

  @@index([wholesaleOrderId])
  @@index([productId])
}

model StorePermission {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  userType    String
  permissions String
  grantedBy   String
  createdAt   DateTime @default(now())

  @@unique([storeId, userId, userType])
  @@index([storeId])
  @@index([userId])
}

model CommissionLedger {
  id        String    @id @default(cuid())
  orderId   String
  storeId   String?
  partnerId String?
  type      String
  amount    Decimal   @db.Decimal(12, 2)
  rate      Decimal   @db.Decimal(5, 4)
  status    String    @default("pending")
  settledAt DateTime?
  tenantId  String
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, status])
}

model SupplierPortal {
  id          String   @id @default(cuid())
  supplierId  String   @unique
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  apiKey      String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  autoPublish Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([apiKey])
}

// ─── Support Tickets ─────────────────────────────────────
model SupportTicket {
  id        String    @id @default(cuid())
  subject   String
  message   String
  priority  String    @default("medium") // low, medium, high
  status    String    @default("open") // open, replied, closed
  reply     String?
  repliedAt DateTime?
  tenantId  String
  createdBy String    @default("admin") // username
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, createdAt])
  // TD-020 / ADR-017 — aplicado en prod 2026-04-09 via scripts/apply-ola1-indices.ts
  @@index([tenantId, status], map: "SupportTicket_tenantId_status_idx")
}

// ══════════════════════════════════════════════════════════
// ██ FACTURACIÓN ELECTRÓNICA SUNAT / NUBEFACT
// ══════════════════════════════════════════════════════════

// ─── Configuración SUNAT por tenant ─────────────────────
model TenantSunatConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  ruc             String // RUC del negocio (11 dígitos)
  razonSocial     String // Razón social registrada en SUNAT
  direccionFiscal String? // Dirección fiscal
  ubigeo          String? // Código ubigeo SUNAT (6 dígitos)
  nubefactToken   String // Token API Nubefact
  nubefactUrl     String   @default("https://api.nubefact.com/api/v1")
  boletaSeries    String   @default("B001")
  facturaSeries   String   @default("F001")
  lastBoletaNum   Int      @default(0)
  lastFacturaNum  Int      @default(0)
  isProduction    Boolean  @default(false) // false = sandbox Nubefact
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices SunatInvoice[]

  @@index([tenantId])
}

// ─── Comprobantes electrónicos emitidos ─────────────────
model SunatInvoice {
  id           String    @id @default(cuid())
  tenantId     String
  orderId      String? // orden de venta relacionada (opcional)
  type         String // "boleta" | "factura" | "nota_credito" | "baja"
  series       String // "B001" | "F001" | "BC01" | "FC01"
  number       Int // correlativo
  customerRuc  String? // RUC del receptor (solo facturas)
  customerName String // nombre/razón social del receptor
  subtotal     Decimal   @db.Decimal(12, 2) // monto gravado (sin IGV)
  igv          Decimal   @db.Decimal(12, 2) // monto IGV
  total        Decimal   @db.Decimal(12, 2) // total con IGV
  xmlContent   String? // XML UBL 2.1 generado (texto)
  cdrResponse  String? // CDR XML devuelto por SUNAT
  sunatStatus  String    @default("pending") // pending | accepted | rejected | voided
  nubefactId   String? // ID interno Nubefact
  pdfUrl       String? // URL del PDF generado por Nubefact
  errorMessage String? // mensaje de error si sunatStatus=rejected
  sentAt       DateTime? // cuándo se envió a Nubefact
  acceptedAt   DateTime? // cuándo SUNAT aceptó el CDR
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  config TenantSunatConfig? @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, series, number])
  @@index([tenantId])
  @@index([tenantId, type, series, number])
  @@index([orderId])
  @@index([sunatStatus])
}

// ─── Anti-Churn: Health Score ────────────────────────────
model TenantHealthScore {
  id                 String   @id @default(cuid())
  tenantId           String
  score              Int // 0-100 (100 = muy saludable)
  loginsLast7d       Int      @default(0)
  loginsLast30d      Int      @default(0)
  ordersLast7d       Int      @default(0)
  ordersLast30d      Int      @default(0)
  featuresUsed       Int      @default(0) // de 47 recursos RBAC, cuántos usó
  daysSinceLastOrder Int      @default(0)
  daysSinceLastLogin Int      @default(0)
  trialDaysLeft      Int? // null si no está en trial
  riskLevel          String   @default("low") // low | medium | high | critical
  calculatedAt       DateTime @default(now())

  @@index([tenantId])
  @@index([riskLevel])
  @@index([calculatedAt])
}

// ─── Anti-Churn: Señales de riesgo ──────────────────────
model ChurnSignal {
  id           String    @id @default(cuid())
  tenantId     String
  signalType   String // "login_drop" | "order_drop" | "trial_expiring" | "support_unresolved" | "plan_downgrade_intent"
  severity     String    @default("medium") // low | medium | high | critical
  detail       String
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String? // "auto" | "manual" | username
  intervention String? // qué acción se tomó
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([severity, resolved])
  @@index([createdAt])
}

// ─── Anti-Churn: Playbooks de intervención ───────────────
model ChurnPlaybook {
  id              String   @id @default(cuid())
  name            String // "trial_expiring_3d" | "login_drop_7d" | "order_drop_50pct"
  triggerSignal   String // signal type que lo activa
  triggerSeverity String   @default("high") // mínima severity para activar
  action          String // "email" | "whatsapp" | "discount" | "call"
  templateId      String? // ID de template de email/WhatsApp
  discountPercent Int? // si action = "discount"
  discountDays    Int? // duración del descuento
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([name])
}

// ═══════════════════════════════════════════════════════
// MOTOR DE CRÉDITO INTERNO (Buy-Now-Pay-Later)
// ═══════════════════════════════════════════════════════

model CreditProfile {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String
  creditScore      Int      @default(0) // 0-1000
  creditLimit      Decimal  @default(0) // monto máximo de crédito en PEN @db.Decimal(12, 2)
  usedCredit       Decimal  @default(0) // crédito utilizado actualmente @db.Decimal(12, 2)
  availableCredit  Decimal  @default(0) // creditLimit - usedCredit @db.Decimal(12, 2)
  riskLevel        String   @default("none") // none | low | medium | high
  totalLoans       Int      @default(0) // total de préstamos dados
  paidOnTime       Int      @default(0) // pagados a tiempo
  paidLate         Int      @default(0) // pagados tarde
  defaulted        Int      @default(0) // impagos
  avgTicket        Decimal  @default(0) // ticket promedio de compra @db.Decimal(12, 2)
  purchaseFreqDays Float? // frecuencia de compra en días
  lastScoreUpdate  DateTime @default(now())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  installments CreditInstallment[]
  scoreHistory CreditScoreHistory[]

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([creditScore])
}

model CreditInstallment {
  id                String   @id @default(cuid())
  tenantId          String
  creditProfileId   String
  orderId           String? // orden que generó este crédito
  totalAmount       Decimal  @db.Decimal(12, 2) // monto total del crédito
  installments      Int // número de cuotas (2, 3, 4)
  installmentAmount Decimal  @db.Decimal(12, 2) // monto por cuota
  interestRate      Float    @default(0) // tasa de interés mensual (ej: 0.05 = 5%)
  paidAmount        Decimal  @default(0) @db.Decimal(12, 2)
  paidInstallments  Int      @default(0)
  status            String   @default("active") // active | paid | overdue | defaulted
  nextDueDate       DateTime
  createdAt         DateTime @default(now())

  creditProfile CreditProfile @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditProfileId])
  @@index([status, nextDueDate])
}

// ─── Credit Score History (Fiado Digital Phase 1) ─────────────────────────────
// Append-only timeline of credit score snapshots. Used for transparency
// (customer sees "your score went from X to Y") and analytics.
// ADR-021 §3: immutable, tenant-isolated, write-only after creation.
model CreditScoreHistory {
  id                          String   @id @default(cuid())
  tenantId                    String
  customerId                  String
  creditProfileId             String
  score                       Int // 0-1000 at snapshot time
  creditLimit                 Decimal  @db.Decimal(12, 2)
  riskLevel                   String // none | low | medium | high
  // Breakdown at snapshot time (for transparency explainability)
  breakdownPurchaseHistory    Int      @default(0)
  breakdownPaymentPunctuality Int      @default(0)
  breakdownAvgTicket          Int      @default(0)
  breakdownSeniority          Int      @default(0)
  breakdownLoyaltyPoints      Int      @default(0)
  // What triggered this snapshot
  trigger                     String   @default("manual") // manual | weekly_recalc | payment | fiado_close
  createdAt                   DateTime @default(now())

  creditProfile CreditProfile @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([creditProfileId, createdAt])
  @@index([createdAt])
}

// ─── Credit Reminder (Fiado Digital Phase 2) ──────────────────────────────────
// Idempotent reminder tracking. Each (fiadoId, stage, date) combination
// can only produce one reminder. Prevents double-sends on cron retries.
// ADR-021 §4: stages escalate T-3 → T-1 → T0 → T+1 → T+7 → T+30.
model CreditReminder {
  id             String   @id @default(cuid())
  tenantId       String
  fiadoId        String
  customerId     String
  stage          String // pre_3d | pre_1d | due_day | post_1d | post_7d | post_30d
  channel        String   @default("whatsapp") // whatsapp | notification | sms
  message        String   @db.Text
  sentAt         DateTime @default(now())
  // Idempotency: unique constraint ensures one reminder per fiado+stage+day
  idempotencyKey String   @unique // format: {fiadoId}:{stage}:{YYYY-MM-DD}

  @@index([tenantId])
  @@index([fiadoId])
  @@index([customerId])
  @@index([sentAt])
}

// ─── AI Demand Forecasting ───────────────────────────────
// Registro de predicciones de demanda por SKU.
// El campo actualQty se llena después para medir accuracy real.
model ForecastLog {
  id           String   @id @default(cuid())
  tenantId     String
  productId    Int
  predictedQty Float
  actualQty    Float? // se llena después para medir accuracy
  confidence   Float // 0-1
  trend        String // "up" | "stable" | "down"
  daysAhead    Int
  forecastDate DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([forecastDate])
}

// ─── Supplier Portal — Price Versions ───────────────────
// Historial de cambios de precio publicados por el proveedor.
model SupplierPriceVersion {
  id            String   @id @default(cuid())
  supplierId    String
  productName   String
