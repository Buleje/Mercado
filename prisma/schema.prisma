// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (SaaS multi-tenancy) ────────────────────────
model Tenant {
  id                   String    @id @default(cuid())
  slug                 String    @unique  // subdomain: e.g. "bodega-san-martin"
  name                 String            // E.g. "Bodega San Martín"
  plan                 String    @default("free") // free | pro | business
  active               Boolean   @default(true)
  customDomain         String?           // Optional custom domain: "www.mitienda.com"
  ownerEmail           String?
  ownerPhone           String?
  trialEndsAt          DateTime?
  // ── Stripe billing ──────────────────────────────────
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([slug])
  @@index([active])
  @@index([stripeCustomerId])
}

// ─── Products ───────────────────────────────────────────
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  category    String
  price       Float
  costPrice   Float?
  image       String    @default("")
  description String?
  unit        String    @default("unidad")
  badge       String?
  barcode     String?
  stock       Int?
  stockMin    Int?
  stockMax    Int?
  active      Boolean   @default(true)
  tenantId    String    @default("main")
  deletedAt   DateTime? // soft-delete — null means active
  expiresAt   DateTime? // nearest expiry date of available stock
  shelfLifeDays Int?    // default shelf-life in days for auto-calc

  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  inventoryMovements InventoryMovement[]
  priceHistory  PriceHistory[]
  transfers     Transfer[]
  locations     Location[]
  batches       Batch[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// ─── Batches: see "Inventory Batches (Lotes)" section below (line ~969)

// ─── Customers ──────────────────────────────────────────
model Customer {
  phone            String          @id
  name             String
  location         String          @default("")
  reference        String          @default("")
  activeLocationId String?
  aiNotes          String?
  aiNotesDate      DateTime?
  birthday         DateTime?
  loyaltyPoints    Int             @default(0)
  loyaltyTier      String          @default("bronce")
  totalSpent       Float           @default(0)
  notifOrderUpdates Boolean        @default(true)
  notifPromotions   Boolean        @default(true)
  notifRestock      Boolean        @default(false)
  privateNotes      String?
  referralCode      String?        @unique
  referredBy        String?
  creditBalance     Float          @default(0)
  tenantId         String          @default("main")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  locations     SavedLocation[]
  orders        Order[]
  sales         Sale[]
  savedCart     SavedCart?
  notifications CustomerNotification[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// ─── Saved Carts (persistent across devices) ────────────
model SavedCart {
  id            String   @id @default(cuid())
  customerPhone String   @unique
  tenantId      String   @default("main")
  itemsJson     String   // JSON array of cart items
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([tenantId])
}

model SavedLocation {
  id            String   @id @default(cuid())
  location      String
  reference     String   @default("")
  customerPhone String
  customer      Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([customerPhone])
}

// ─── Orders ─────────────────────────────────────────────
enum OrderStatus {
  pendiente
  confirmado
  en_camino
  entregado
  cancelado
}

model Order {
  id                  String      @id
  customerName        String
  customerPhone       String?
  customerLocation    String      @default("")
  customerReference   String      @default("")
  total               Float
  status              OrderStatus @default(pendiente)
  notes               String?
  paymentMethod       String?
  yapeOperationNumber String?
  deuda               Boolean?
  appliedCouponCode   String?
  couponDiscount      Float?
  appliedPromoId      String?
  discountAmount      Float?
  totalCogs           Float?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenantId            String      @default("main")
  deletedAt           DateTime?   // soft-delete — null means active
  idempotencyKey      String?     @unique // prevents duplicate order creation
  riderName           String?             // repartidor asignado al pedido
  cancelReason        String?             // motivo de cancelación
  cancelledAt         DateTime?           // cuándo se canceló

  items          OrderItem[]
  customer       Customer?   @relation(fields: [customerPhone], references: [phone], onDelete: SetNull)
  statusHistory  OrderStatusHistory[]

  @@index([customerPhone])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  String
  productId Int?
  name     String
  price    Float
  costPrice Float?
  quantity Int
  unit     String
  image    String @default("")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ─── Reviews ────────────────────────────────────────────
model Review {
  id             String    @id
  name           String
  location       String    @default("")
  text           String
  rating         Int
  phone          String?
  productId      Int?      // null = general store review; set for product-specific reviews
  status         String    @default("approved") // pending | approved | rejected
  tenantId       String    @default("main")
  date           DateTime  @default(now())
  deletedAt      DateTime? // soft-delete — null means active
  adminReply     String?
  adminReplyDate DateTime?

  @@index([status])
  @@index([tenantId])
  @@index([productId])
}

// ─── Settings ───────────────────────────────────────────
model Settings {
  id                 Int     @id @default(autoincrement())
  tenantId           String  @default("main") @unique
  mode               String  @default("checkout")
  businessName       String?
  businessPhone      String?
  businessAddress    String?
  logoUrl            String?
  description        String?
  hours              String?
  deliveryZone       String?
  yapeEnabled        Boolean @default(false)
  yapeImage          String?
  yapeName           String?
  yapePhone          String?
  cashEnabled        Boolean @default(true)
  navLinksJson       String?
  businessLat        Float?
  businessLon        Float?
  adminPassword      String?
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  adminBypassLogin   Boolean @default(false)
  comboTemplatesJson String?
  featureFlagsJson   String? // JSON object: { [FeatureFlag]: boolean }
}

// ─── Suppliers ──────────────────────────────────────────
model Supplier {
  id        String   @id
  name      String
  ruc       String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  tenantId  String   @default("main")
  createdAt DateTime @default(now())

  purchases   PurchaseOrder[]
  payables    Payable[]
  evaluations SupplierEvaluation[]

  @@index([tenantId])
}

// ─── Purchase Orders ────────────────────────────────────
enum PurchaseStatus {
  pendiente
  recibido
  parcial
  cancelado
}

model PurchaseOrder {
  id           String         @id
  supplierId   String
  supplierName String
  total        Float
  status       PurchaseStatus @default(pendiente)
  notes        String?
  tenantId     String         @default("main")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items    PurchaseItem[]
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([tenantId])
}

model PurchaseItem {
  id              Int    @id @default(autoincrement())
  purchaseOrderId String
  productId       Int
  name            String
  quantity        Int
  unitCost        Float
  unit            String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// ─── Sales (POS) ────────────────────────────────────────
model Sale {
  id            String   @id
  total         Float
  totalCogs     Float?
  payment       String   @default("efectivo")
  amountPaid    Float    @default(0)
  change        Float    @default(0)
  customerPhone String?
  cashierId     String?
  tenantId      String   @default("main")
  createdAt     DateTime @default(now())

  items    SaleItem[]
  customer Customer?  @relation(fields: [customerPhone], references: [phone], onDelete: SetNull)

  @@index([customerPhone])
  @@index([cashierId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id        Int    @id @default(autoincrement())
  saleId    String
  productId Int
  name      String
  price     Float
  costPrice Float?
  quantity  Int
  unit      String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ─── Promotions ─────────────────────────────────────────
model Promotion {
  id              String    @id
  name            String
  description     String    @default("")
  discountPercent Float     @default(0)
  minPurchase     Float?
  imageUrl        String?
  message         String?
  targetType      String    @default("all")
  targetPhones    String?
  active          Boolean   @default(true)
  tenantId        String    @default("main")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([tenantId])
}

// ─── Payables (Accounts Payable) ────────────────────────
model Payable {
  id              String   @id
  supplierId      String
  supplierName    String
  purchaseOrderId String?
  description     String   @default("")
  amount          Float
  paidAmount      Float    @default(0)
  status          String   @default("pendiente")
  dueDate         DateTime
  tenantId        String   @default("main")
  createdAt       DateTime @default(now())

  payments Payment[]
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([tenantId])
}

model Payment {
  id        String   @id
  payableId String
  amount    Float
  method    String   @default("efectivo")
  date      DateTime @default(now())
  reference String?

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([payableId])
}

// ─── Cash Register ──────────────────────────────────────
enum CashRegisterStatus {
  abierta
  cerrada
}

model CashRegister {
  id            String             @id @default(cuid())
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  openingAmount Float              @default(0)
  closingAmount Float?
  expectedAmount Float?
  difference    Float?
  status        CashRegisterStatus @default(abierta)
  notes         String?
  tenantId      String             @default("main")

  movements CashMovement[]

  @@index([tenantId])
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String
  type           String   // venta, ingreso, egreso, apertura, cierre
  amount         Float
  method         String   @default("efectivo") // efectivo, yape, plin, tarjeta, transferencia
  description    String   @default("")
  saleId         String?
  createdAt      DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([cashRegisterId])
}

// ─── Inventory Movements ────────────────────────────────
model InventoryMovement {
  id          String   @id @default(cuid())
  productId   Int
  type        String   // compra, venta, venta_online, devolucion, ajuste_positivo, ajuste_negativo, merma
  lossType    String?  // damages, theft, expiry, obsolescence (only relevant when type=merma)
  quantity    Int
  previousStock Int    @default(0)
  newStock    Int      @default(0)
  reference   String?  // saleId, orderId, purchaseId, etc.
  notes         String?
  warehouseId   String?   // Which warehouse originated this movement
  createdBy     String?   // Username of the admin who created this movement
  tenantId      String    @default("main")
  createdAt     DateTime  @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([tenantId, createdAt])
}

// ─── Coupons ────────────────────────────────────────────
model Coupon {
  id              String    @id @default(cuid())
  code            String
  tenantId        String    @default("main")
  description     String    @default("")
  discountType    String    @default("percent") // percent | fixed | giftcard
  discountValue   Float     @default(0)
  balance         Float?    // remaining balance for giftcard type
  minPurchase     Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─── Returns / Refunds ──────────────────────────────────
model Return {
  id              String       @id @default(cuid())
  saleId          String?
  orderId         String?
  reason          String       @default("")
  total           Float        @default(0)
  photoUrl        String?
  customerPhone   String?
  creditApplied   Boolean      @default(false)
  tenantId        String       @default("main")
  createdAt       DateTime     @default(now())

  items ReturnItem[]

  @@index([tenantId])
}

model ReturnItem {
  id        Int    @id @default(autoincrement())
  returnId  String
  productId Int
  name      String
  quantity  Int
  price     Float
  unit      String

  returnRecord Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// ─── Shopping Lists ─────────────────────────────────────
model ShoppingList {
  id            String   @id @default(cuid())
  customerPhone String
  name          String
  tenantId      String   @default("main")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ShoppingListItem[]

  @@index([customerPhone])
  @@index([tenantId])
}

model ShoppingListItem {
  id             Int    @id @default(autoincrement())
  shoppingListId String
  productId      Int
  quantity       Int    @default(1)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

// ─── Price History ──────────────────────────────────────
model PriceHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  oldPrice  Float
  newPrice  Float
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changedAt])
}

// ─── Delivery Slots ─────────────────────────────────────
model DeliverySlot {
  id        String   @id @default(cuid())
  orderId   String   @unique
  date      String   // YYYY-MM-DD
  slot      String   // manana, tarde, noche
  notes     String?
  createdAt DateTime @default(now())
}

// ─── Admin Chat Messages ────────────────────────────────
model AdminMessage {
  id        String   @id @default(cuid())
  sender    String   // admin, cajero, almacenero
  message   String
  createdAt DateTime @default(now())
}

// ─── Supplier Evaluations ───────────────────────────────
model SupplierEvaluation {
  id            String   @id @default(cuid())
  supplierId    String
  purchaseId    String?
  punctuality   Int      @default(3) // 1-5
  quality       Int      @default(3) // 1-5
  price         Int      @default(3) // 1-5
  notes         String?
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ─── Expenses (Operating Costs) ─────────────────────────
model Expense {
  id          String   @id @default(cuid())
  category    String   // alquiler, servicios, personal, transporte, limpieza, marketing, otros
  description String   @default("")
  amount      Float
  date        DateTime @default(now())
  recurring   Boolean  @default(false)
  tenantId    String   @default("main")
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([date])
  @@index([tenantId])
}

// ─── Product Bundles (Combos) ───────────────────────────
model Bundle {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  price       Float     // bundle price (usually less than sum of items)
  image       String    @default("")
  active      Boolean   @default(true)
  tenantId    String    @default("main")
  createdAt   DateTime  @default(now())

  items BundleItem[]

  @@index([tenantId])
}

model BundleItem {
  id        Int    @id @default(autoincrement())
  bundleId  String
  productId Int
  quantity  Int    @default(1)

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

// ─── Activity Log (Admin Audit Trail) ─────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // create, update, delete, view, login, etc.
  entity    String   // product, order, customer, settings, etc.
  entityId  String?
  detail    String   @default("")
  user      String   @default("admin")
  ipAddress String?
  userAgent String?
  tenantId  String   @default("main")
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([user])
  @@index([tenantId])
  @@index([createdAt])
}

// ─── Push Subscriptions (persistent) ────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  phone     String?
  tenantId  String   @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([tenantId])
}

// ─── Admin Users ─────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  username     String
  tenantId     String   @default("main")
  passwordHash String
  role         String   @default("admin") // admin, cajero, almacenero
  name         String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, username])
  @@index([tenantId])
}

// ─── WhatsApp Notification Log ──────────────────────────
model NotificationLog {
  id        String   @id @default(cuid())
  type      String   // order_confirmed, order_shipped, order_delivered, promotion, low_stock
  recipient String   // phone number
  message   String
  status    String   @default("sent") // sent, failed
  orderId   String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// ─── Customer Notification Inbox ────────────────────────
model CustomerNotification {
  id            String   @id @default(cuid())
  customerPhone String
  type          String   // order, promo, stock, coupon, general
  title         String
  body          String
  link          String?  // deep-link inside the app
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerPhone], references: [phone], onDelete: Cascade)

  @@index([customerPhone])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════
// CMS - CONTENT MANAGEMENT SYSTEM
// ═══════════════════════════════════════════════════════

// ─── Pages ──────────────────────────────────────────────
enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String?
  
  // SEO Metadata
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  
  // Publishing
  status          PageStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Layout
  layout          String     @default("default")
  settings        Json?      // { headerVisible: true, footerVisible: true }
  
  // Relations
  blocks          PageBlock[]
  versions        PageVersion[]
  
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

// ─── Page Blocks ────────────────────────────────────────
model PageBlock {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  // Block config
  type        String   // hero, about, benefits, products, cta, etc.
  order       Int      // Display order
  visible     Boolean  @default(true)
  
  // Content
  props       Json     // Component props
  styles      Json?    // Custom styles
  mobileProps Json?    // Mobile-specific props
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([pageId, order])
  @@index([type])
}

// ─── Block Templates ────────────────────────────────────
model BlockTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // hero, cta, etc.
  category    String   // marketing, informativo, producto
  
  // Template data
  props       Json
  styles      Json?
  preview     String?  // Preview image URL
  
  // Usage tracking
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type])
  @@index([category])
}

// ─── Media Library ──────────────────────────────────────
model Media {
  id          String    @id @default(cuid())
  
  // File info
  filename    String
  url         String
  mimeType    String
  size        Int       // bytes
  
  // Metadata
  alt         String?
  title       String?
  caption     String?
  
  // Organization
  folder      String    @default("general")
  tags        String[]
  
  // Image-specific
  width       Int?
  height      Int?
  blurhash    String?
  
  // Usage tracking
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([folder])
  @@index([mimeType])
}

// ─── Page Versions ──────────────────────────────────────
model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  // Snapshot
  title     String
  blocks    Json     // Complete blocks array snapshot
  settings  Json?
  
  // Metadata
  comment   String?
  createdBy String?
  createdAt DateTime @default(now())
  
  @@index([pageId, createdAt])
}

// ─── Theme Settings ─────────────────────────────────────
model ThemeSettings {
  id         String   @id @default("global")
  
  // Design
  colors     Json     // { primary, secondary, accent, ... }
  fonts      Json     // { heading, body }
  spacing    Json?    // { section, container }
  
  // Components
  header     Json?    // { sticky, transparent }
  footer     Json?    // { showSocial }
  
  // Effects
  animations Json?    // { enabled, speed }
  
  updatedAt  DateTime @updatedAt
}

// ─── Navigation ─────────────────────────────────────────
model Navigation {
  id        String   @id @default("main")
  items     Json     // Array of { label, href, icon?, children? }
  settings  Json?    // { position, style }
  
  updatedAt DateTime @updatedAt
}

// ─── Stripe Webhook Queue ────────────────────────────────
// Stores events that failed to be processed (e.g. DB unavailable).
// A cron job (POST /api/billing/webhook-replay) drains this queue.
model StripeWebhookQueue {
  id          String   @id @default(cuid())
  stripeId    String   @unique          // Stripe event ID (idempotency key)
  eventType   String                    // e.g. "checkout.session.completed"
  payload     String                    // Raw JSON of the Stripe.Event object
  attempts    Int      @default(0)      // How many replay attempts have failed
  lastError   String?                   // Last error message for debugging
  nextRetryAt DateTime @default(now())  // Earliest time to retry
  processedAt DateTime?                 // Set when successfully replayed
  createdAt   DateTime @default(now())

  @@index([processedAt])
  @@index([nextRetryAt])
}

// ─── Quick Notes (Admin) ─────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  tenantId  String   @default("main")
  title     String
  content   String   @default("")
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Message Templates ───────────────────────────────────
model MessageTemplate {
  id            String   @id @default(cuid())
  tenantId      String   @default("main")
  name          String
  channel       String   // whatsapp | email | sms
  category      String   // ventas | cobranza | delivery | promociones | atención | general
  subject       String?
  body          String
  variablesJson String   @default("[]") // JSON array of variable names
  starred       Boolean  @default(false)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// ─── Smart Reminders ─────────────────────────────────────
model Reminder {
  id            String   @id @default(cuid())
  tenantId      String   @default("main")
  title         String
  description   String   @default("")
  type          String   // pago | inventario | tarea | vencimiento | cliente | general
  priority      String   @default("media") // alta | media | baja
  status        String   @default("pendiente") // pendiente | completado | vencido
  dueDate       DateTime
  autoGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

// ─── Inventory Batches (Lotes) ────────────────────────────
model Batch {
  id              String   @id @default(cuid())
  tenantId        String   @default("main")
  lote            String
  productName     String
  productCategory String   @default("Otros")
  quantity        Float
  unit            String   @default("unidad")
  supplierId      String?
  supplierName    String   @default("")
  entryDate       DateTime
  expiryDate      DateTime
  costUnit        Float    @default(0)
  notes           String   @default("")
  productId       Int?                  // FK to Product catalogue (optional, backward compat)
  warehouseId     String?               // FK to Warehouse where this batch is stored
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([expiryDate])
  @@index([productId])
  @@index([warehouseId])
}

// ─── Saved Filters ───────────────────────────────────────
model SavedFilter {
  id             String   @id @default(cuid())
  tenantId       String   @default("main")
  name           String
  description    String   @default("")
  module         String
  conditionsJson String   @default("[]") // JSON array of { field, operator, value }
  isDefault      Boolean  @default(false)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// ─── Customer Chat (Live Chat Widget) ───────────────────
model ChatMessage {
  id            String   @id @default(cuid())
  customerPhone String
  customerName  String   @default("Cliente")
  sender        String   // "customer" | "admin"
  message       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([customerPhone])
  @@index([read])
}

// ─── A/B Testing ────────────────────────────────────────
model ABTest {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  variants    Json     // Array of { id: string, label: string, weight: number }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
}

model ABTestEvent {
  id        String   @id @default(cuid())
  testId    String
  variantId String
  visitorId String   // anonymous cookie or phone
  event     String   // "impression" | "conversion"
  value     Float?   // optional conversion value
  createdAt DateTime @default(now())

  @@index([testId, variantId])
  @@index([visitorId])
}

// ─── Customer Feedback Surveys ──────────────────────────
model SurveyResponse {
  id            String   @id @default(cuid())
  orderId       String
  customerPhone String?
  rating        Int      // 1-5 stars
  comment       String   @default("")
  type          String   @default("nps") // nps, csat, etc.
  createdAt     DateTime @default(now())

  @@unique([orderId, type])
  @@index([customerPhone])
  @@index([type])
}

// ─── Tenant Invitation ───────────────────────────────────
// Superadmin or tenant admins can invite users via signed email links.
model TenantInvitation {
  id        String   @id @default(cuid())
  tenantId  String   // slug of the target tenant
  email     String
  role      String   @default("editor") // admin | editor | viewer
  token     String   @unique            // 32-byte random hex, single-use
  status    String   @default("pending") // pending | accepted | expired
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([tenantId])
  @@index([email])
}

// ─── Order Status History ────────────────────────────────
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  changedBy String?              // admin user identifier or "system"
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── Newsletter Subscribers ─────────────────────────────
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  tenantId  String   @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Cron Dead Letter ───────────────────────────────────
model CronDeadLetter {
  id        String   @id @default(cuid())
  jobName   String
  error     String
  attempts  Int
  payload   String?
  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
}

// ─── Warehouses ─────────────────────────────────────────
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String
  type      String   @default("principal") // principal | secundario | punto-venta | deposito | frigorifico
  location  String   @default("")
  manager   String   @default("Administrador")
  capacity  Int      @default(10000)
  active    Boolean  @default(true)
  tenantId  String   @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations          Location[]
  transfersFrom      Transfer[]          @relation("TransferFromWarehouse")
  transfersTo        Transfer[]          @relation("TransferToWarehouse")
  batches            Batch[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Transfer {
  id              String    @id @default(cuid())
  code            String
  fromWarehouseId String
  toWarehouseId   String
  productId       Int
  quantity        Int
  unit            String    @default("und")
  status          String    @default("pendiente")
  requestedBy     String
  requestDate     DateTime  @default(now())
  deliveredDate   DateTime?
  notes           String    @default("")
  tenantId        String    @default("main")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fromWarehouse Warehouse @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
}

model Location {
  id          String    @id @default(cuid())
  code        String
  zone        String
  aisle       String    @default("")
  shelf       String    @default("")
  bin         String    @default("")
  warehouseId String
  productId   Int?
  qty         Int       @default(0)
  capacity    Int       @default(0)
  category    String    @default("")
  tenantId    String    @default("main")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productId])
}

// ─── API Keys (Business plan) ────────────────────────────
// Programmatic access for Business-tier tenants via Bearer tokens.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String    // slug of the owning tenant
  name       String    // human-readable label
  keyPrefix  String    // first 10 chars of the raw key (shown in UI)
  keyHash    String    @unique // SHA-256 of the full raw key
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([tenantId])
  @@index([keyHash])
}

// ─── Visitor Welcome Survey ──────────────────────────────
// Stores first-time visitor feedback submitted via the welcome modal.
model VisitorWelcome {
  id        String   @id @default(cuid())
  name      String
  devices   String   // JSON array: ["celular","tablet","computadora"]
  userAgent String?
  tenantId  String   @default("main")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ─── Marketing Campaigns ──────────────────────────────────────────────────────
model Campaign {
  id            String    @id @default(cuid())
  tenantId      String    @default("main")
  name          String
  message       String    @db.Text
  segment       String    @default("todos")    // todos | vip | inactivos | cumpleanos | deudores
  channel       String    @default("whatsapp") // whatsapp | inapp | ambos
  status        String    @default("borrador") // borrador | programada | activa | completada | cancelada
  scheduledAt   DateTime?
  sentAt        DateTime?
  totalAudience Int       @default(0)
  delivered     Int       @default(0)
  opened        Int       @default(0)
  conversions   Int       @default(0)
  revenue       Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ─── Commission Rules (tiered % per employee) ─────────────────────────────────
model CommissionRule {
  id         String   @id @default(cuid())
  tenantId   String   @default("main")
  cashierId  String                         // matches adminUser.username
  label      String   @default("")          // e.g. "Nivel base", "Objetivo Q1"
  minSales   Float    @default(0)           // minimum revenue to qualify
  maxSales   Float?                         // null = no upper limit
  rate       Float    @default(0)           // commission % applied to revenue
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([cashierId])
  @@unique([tenantId, cashierId, minSales])
}
