  nombre      String
  tipo        String // porcentaje, 2x1, 3x2, combo, monto_fijo
  valor       Decimal  @default(0) @db.Decimal(12, 2)
  categorias  String   @default("[]") // JSON array
  condicion   String?
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([activa, tenantId])
}

// ─── Supplier Returns ────────────────────────────────────
model SupplierReturn {
  id              String   @id @default(cuid())
  proveedorId     String?
  proveedorNombre String
  motivo          String
  estado          String   @default("PENDIENTE") // PENDIENTE, ENVIADA, RESUELTA
  notas           String?
  tenantId        String
  createdAt       DateTime @default(now())
