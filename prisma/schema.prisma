  trend         String?  @default("flat") // up, down, flat
  changePercent Float?   @default(0)
  period        String?  @default("Hoy")
  category      String?  @default("Ventas")
  color         String?  @default("bg-emerald-500")
  history       Json     @default("[]")
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([category, tenantId])
}

// ══════════════════════════════════════════════════════════
// ██ MARKETPLACE
// ══════════════════════════════════════════════════════════

model Store {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                String               @unique
  name                String
  description         String?
  logo                String?
  banner              String?
  category            String               @default("bodega")
  zone                String?
  lat                 Float?
  lng                 Float?
  rating              Float                @default(0)
  reviewCount         Int                  @default(0)
  isPublished         Boolean              @default(false)
  vacationMode        Boolean              @default(false)
  vacationMessage     String?
  whatsappPublic      String? // WhatsApp público que el dueño publica para que los clientes le escriban (FAB del storefront). Distinto de ownerPhone (PII interna del dueño).
  commission          Decimal              @default(5.0) @db.Decimal(5, 2) // marketplace commission %, e.g. 5.00
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  products            StoreProduct[]
  permissions         StorePermission[]
  reviews             Review[]
  banners             StoreBanner[]
  stockoutPredictions StockoutPrediction[]
  salesAnomalies      SalesAnomaly[]
  sponsoredBoosts     SponsoredBoost[]
  deliveryRoutes      DeliveryRoute[]
  conversationThreads ConversationThread[]
  posts               StorePost[]

  @@index([tenantId])
  // Audit #3 (Brandon 2026-05-30): listado del directorio /tiendas ordena por
  // rating/reviewCount y filtra por isPublished + zona. Antes: seq scan sobre Store.
  @@index([isPublished, rating(sort: Desc), reviewCount(sort: Desc)])
  @@index([isPublished, zone])
}

// ─── ADR-130 — Publicaciones por tienda (feed social + comentarios) ──────────
// Feed editorial del dueño (texto + imagen) que los vecinos comentan. Retención.
// Migración ADITIVA (2 tablas nuevas). Plantilla: Review (tenantId/status/soft-del).
model StorePost {
  id           String             @id @default(cuid())
  tenantId     String
  storeId      String
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  body         String
  imageUrl     String?
  pinned       Boolean            @default(false)
  status       String             @default("published") // published | hidden
  likeCount    Int                @default(0)
  commentCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  comments     StorePostComment[]

  @@index([tenantId])
  @@index([storeId, status, pinned, createdAt(sort: Desc)], name: "StorePost_store_feed_idx")
}

model StorePostComment {
  id         String    @id @default(cuid())
  tenantId   String
  postId     String
  post       StorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customerId String?
  authorName String
  body       String
  status     String    @default("published") // published | hidden
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([tenantId])
  @@index([postId, status, createdAt], name: "StorePostComment_post_idx")
}

model StoreBanner {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  Int       @default(0)
  section   String    @default("hero")
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
  @@index([tenantId])
  @@index([storeId, section, position])
}

model StoreProduct {
  id                  String               @id @default(cuid())
  storeId             String
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailPrice         Decimal              @db.Decimal(12, 2)
  wholesalePrice      Decimal?             @db.Decimal(12, 2)
  minOrderQty         Int                  @default(1)
  isActive            Boolean              @default(true)
  volumePricingTiers  Json? // [{ minQty: 10, discount: 5 }, ...]
  /// ADR-081: precio promocional efectivo. Null = sin oferta vigente.
  discountPrice       Decimal?             @db.Decimal(12, 2)
  /// Fecha de vencimiento de la oferta. Null = sin caducidad.
  discountUntil       DateTime?
  /// Texto opcional para chips ("2x1", "Liquidación", "-30%"). Max 40 chars.
  discountLabel       String?              @db.VarChar(40)
  stockoutPredictions StockoutPrediction[]

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([discountUntil])
  // Audit #3 (Brandon 2026-05-30): todo query de catálogo filtra isActive + storeId.
  @@index([storeId, isActive])
}

model DeliveryPartner {
  id             String               @id @default(cuid())
  name           String
  phone          String
  email          String?
  zone           String
  vehicleType    String               @default("moto")
  isActive       Boolean              @default(true)
  rating         Float                @default(5.0)
  fee            Decimal              @default(5.0) @db.Decimal(12, 2)
  notes          String? // JSON: { notifyWhatsApp, notifyEmail, notifyUrgent }
  // ── Rappi-style realtime fields (ADR-087) ─────────────────────────────
  passwordHash   String? // bcrypt — null hasta que el partner active login
  lat            Float? // GPS actual
  lng            Float?
  lastPingAt     DateTime? // heartbeat — ping cada 30s desde la app
  isOnline       Boolean              @default(false) // si recibe ofertas
  currentOrderId String? // si está atendiendo, no recibe más ofertas
  acceptanceRate Float                @default(1.0) // % accept histórico (0..1)
  maxRadiusKm    Float                @default(5.0) // radio max para ofertas
  totalOffers    Int                  @default(0)
  totalAccepted  Int                  @default(0)
  score          Int                  @default(0)
  // ──────────────────────────────────────────────────────────────────────
  tenantId       String
  createdAt      DateTime             @default(now())
  assignments    DeliveryAssignment[]
  offers         DeliveryOffer[]
  payouts        PartnerPayout[]

  @@index([tenantId])
  @@index([tenantId, isOnline, currentOrderId])
}

// ─── Retiros (cash-out) del repartidor a Yape ─────────────────────────
// Patrón Rappi/Uber "Cobra ya". El saldo disponible se calcula en backend
// (Σ fee+propina de entregas completadas − Σ retiros pending|paid). Un
// retiro `pending` aparta el dinero; el dueño lo marca `paid` tras yapear,
// o `rejected` para liberarlo. Decimal(12,2) como el resto del dinero.
model PartnerPayout {
  id         String          @id @default(cuid())
  partnerId  String
  partner    DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tenantId   String
  amount     Decimal         @db.Decimal(12, 2)
  yapeNumber String // celular Yape destino (9 dígitos)
  status     String          @default("pending") // pending | paid | rejected
  note       String? // referencia de pago o motivo de rechazo
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([tenantId])
  @@index([partnerId, status])
}

// ─── Rappi-style cascading offer system (ADR-087) ─────────────────────
// Cada DeliveryOffer es una "invitación" a un partner. Si rechaza/expira,
// el cron crea otra para el siguiente más cercano. Cuando 1 acepta, se
// crea el DeliveryAssignment y se cancelan todas las offers pending.
model DeliveryOffer {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  status      String          @default("pending") // pending | accepted | rejected | expired | cancelled
  offeredAt   DateTime        @default(now())
  expiresAt   DateTime // offeredAt + 2 min (configurable)
  respondedAt DateTime?
  distanceKm  Float
  feeOffered  Decimal         @db.Decimal(12, 2)
  attempt     Int             @default(1) // 1 = primer candidato, 2 = segundo, etc
  tenantId    String

  @@index([orderId, status])
  @@index([partnerId, status])
  @@index([status, expiresAt])
  @@index([tenantId])
}

model DeliveryAssignment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  status         String          @default("assigned")
  fee            Decimal         @db.Decimal(12, 2)
  tipAmount      Decimal         @default(0) @db.Decimal(12, 2)
  tipMessage     String?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  routeStartedAt DateTime?
  proofPhotoUrl  String?
  notes          String?
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([partnerId])
  @@index([tenantId])
}

// ─── SOS Alerts (repartidor en peligro) ──────────────────────────────────────
model DeliverySOSAlert {
  id         String    @id @default(cuid())
  partnerId  String
  lat        Float
  lng        Float
  message    String?
  status     String    @default("active") // active | resolved | false_alarm
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([partnerId])
  @@index([status])
}

// ─── Bloque D1 — Delivery vivo ────────────────────────────

// Schema alineado con MANUAL-marketplace-bloque-d1.sql aplicado 2026-04-08 (Supabase us-east-2).
// Los modelos usan nombres en PascalCase que matchean la tabla real (no se agrega @map
// porque el SQL ya creó las tablas con esos nombres exactos).

model DeliveryTracking {
  id           String   @id
  tenantId     String
  orderId      String
  status       String // preparing|ready|picked_up|in_transit|nearby|delivered|failed|cancelled
  description  String?
  lat          Float?
  lng          Float?
  distanceM    Int?
  etaMinutes   Int?
  actorId      String?
  actorType    String   @default("system") // driver|system|admin|customer
  photoUrl     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([orderId, createdAt(sort: Desc)], name: "DeliveryTracking_orderId_createdAt_idx")
  @@index([tenantId, status])
}

model DeliveryRoute {
  id             String    @id
  tenantId       String
  storeId        String
  driverId       String
  driverName     String
  driverPhone    String?
  vehicleType    String    @default("moto") // moto|bici|auto|caminando
  status         String    @default("planned") // planned|in_progress|completed|cancelled
  plannedStartAt DateTime
  actualStartAt  DateTime?
  completedAt    DateTime?
  totalStops     Int       @default(0)
  completedStops Int       @default(0)
  totalDistanceM Int?
  optimizedByAi  Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stops DeliveryRouteStop[]

  @@index([tenantId])
  @@index([storeId])
  @@index([driverId])
  @@index([storeId, status])
  @@index([tenantId, plannedStartAt(sort: Desc)], name: "DeliveryRoute_tenantId_plannedStartAt_idx")
}

model DeliveryRouteStop {
  id                 String    @id
  tenantId           String
  routeId            String
  orderId            String
  sequence           Int
  status             String    @default("pending") // pending|arrived|delivered|failed|skipped
  address            String
  addressDetail      String?
  lat                Float?
  lng                Float?
  customerName       String
  customerPhone      String?
  estimatedArrivalAt DateTime?
  actualArrivalAt    DateTime?
  completedAt        DateTime?
  failureReason      String?
  proofPhotoUrl      String?
  proofSignatureUrl  String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  route DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@index([routeId])
  @@index([orderId])
  @@index([routeId, status])
}

// ─── Bloque D2 — Chat buyer ↔ seller ─────────────────────
// Schema alineado con MANUAL-marketplace-bloque-d2.sql aplicado 2026-04-08.
// Los hilos viven del lado del tenant VENDEDOR (dueño de la tienda).
// Un buyer puede tener varios hilos cerrados pero sólo uno abierto por
// (storeId, customerPhone, orderId|null).

model ConversationThread {
  id              String    @id
  tenantId        String
  storeId         String
  orderId         String?
  customerPhone   String
  customerName    String
  subject         String?
  status          String    @default("open") // open|closed|archived|blocked
  unreadForBuyer  Int       @default(0)
  unreadForSeller Int       @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?
  lastSenderType  String? // buyer|seller|system
  closedAt        DateTime?
  closedReason    String?
  // Tanda 3 (Brandon 2026-06-11): etiquetas de triage del vendedor
  // (Nuevo·Pagado·Reclamo·custom). JSON array de strings. Compartidas entre
  // cajeros. Aplicada via apply_migration add_conversation_thread_labels_json.
  labelsJson      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@index([tenantId])
  @@index([storeId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt(sort: Desc)], name: "ConversationThread_tenantId_lastMessageAt_idx")
  @@index([customerPhone])
  @@index([orderId])
}

model ConversationMessage {
  id             String    @id
  tenantId       String
  threadId       String
  senderType     String // buyer|seller|system
  senderId       String?
  senderName     String
  body           String
  messageType    String    @default("text") // text|image|system_event|quote|order_link
  attachmentUrl  String?
  metadataJson   String?
  readByBuyerAt  DateTime?
  readBySellerAt DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([threadId])
  @@index([threadId, createdAt(sort: Desc)], name: "ConversationMessage_threadId_createdAt_idx")
  @@index([senderType])
}

// ══════════════════════════════════════════════════════════
// ██ MESSENGER PLATAFORMA ↔ TENANTS (superadmin) — ADR-132
// ══════════════════════════════════════════════════════════
// Conversaciones bidireccionales entre el superadmin (plataforma) y los dueños
// de tenants. Modelo dedicado (NO ConversationThread, que es buyer↔seller).
// senderType: platform|tenant|system. Acceso vía lib/db/platform-chat.db.ts.

model PlatformConversation {
  id                String    @id @default(cuid())
  tenantId          String // tenant interlocutor
  tenantName        String
  subject           String?
  status            String    @default("open") // open|closed|archived
  priority          String    @default("medium") // low|medium|high
  assignedTo        String? // username del superadmin asignado
  labelsJson        String? // JSON array de strings (triage)
  unreadForPlatform Int       @default(0)
  unreadForTenant   Int       @default(0)
  lastMessageAt     DateTime?
  lastMessageText   String?
  lastSenderType    String? // platform|tenant|system
  createdBy         String    @default("platform")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages PlatformMessage[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedTo])
  @@index([lastMessageAt(sort: Desc)], name: "PlatformConversation_lastMessageAt_idx")
  @@index([tenantId, status])
}

model PlatformMessage {
  id               String    @id @default(cuid())
  conversationId   String
  tenantId         String
  senderType       String // platform|tenant|system
  senderName       String
  senderId         String?
  body             String
  messageType      String    @default("text") // text|image|broadcast|note|system_event
  attachmentUrl    String?
  isInternalNote   Boolean   @default(false) // solo visible al superadmin
  metadataJson     String?
  readByPlatformAt DateTime?
  readByTenantAt   DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  conversation PlatformConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
  @@index([conversationId, createdAt(sort: Desc)], name: "PlatformMessage_conversationId_createdAt_idx")
}

// Notas internas del superadmin sobre un tenant (CRM). Solo plataforma — NO el
// modelo Note (ese es del admin del negocio). Brandon 2026-06-14 (bundle C).
model PlatformTenantNote {
  id        String   @id @default(cuid())
  tenantId  String
  body      String
  author    String   @default("superadmin")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)], name: "PlatformTenantNote_tenantId_createdAt_idx")
}

model WholesaleOrder {
  id             String               @id @default(cuid())
  buyerTenantId  String
  sellerTenantId String
  // CONTRACT aplicado — backfill via MANUAL-p0-wholesale-order-tenantid-not-null.sql
  tenantId       String
  status         String               @default("pending")
  total          Decimal              @db.Decimal(12, 2)
  commission     Decimal              @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          WholesaleOrderItem[]
  tenant         Tenant               @relation("WholesaleOrderTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([buyerTenantId])
  @@index([sellerTenantId])
  @@index([tenantId])
}

model WholesaleOrderItem {
  id               String         @id @default(cuid())
  wholesaleOrderId String
  order            WholesaleOrder @relation(fields: [wholesaleOrderId], references: [id], onDelete: Cascade)
  productId        Int
  name             String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  appliedDiscount  Decimal        @default(0) @db.Decimal(5, 2) // porcentaje de descuento por volumen aplicado

  @@index([wholesaleOrderId])
  @@index([productId])
}

model StorePermission {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String
  userType    String
  permissions String
  grantedBy   String
  createdAt   DateTime @default(now())

  @@unique([storeId, userId, userType])
  @@index([storeId])
  @@index([userId])
}

model CommissionLedger {
  id        String    @id @default(cuid())
  orderId   String
  storeId   String?
  partnerId String?
  type      String
  amount    Decimal   @db.Decimal(12, 2)
  rate      Decimal   @db.Decimal(5, 4)
  status    String    @default("pending")
  settledAt DateTime?
  tenantId  String
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, status])
}

model SupplierPortal {
  id          String   @id @default(cuid())
  supplierId  String   @unique
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  apiKey      String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  autoPublish Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([apiKey])
}

// ─── Support Tickets ─────────────────────────────────────
model SupportTicket {
  id        String    @id @default(cuid())
  subject   String
  message   String
  priority  String    @default("medium") // low, medium, high
  status    String    @default("open") // open, replied, closed
  reply     String?
  repliedAt DateTime?
  tenantId  String
  createdBy String    @default("admin") // username
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, createdAt])
  // TD-020 / ADR-017 — aplicado en prod 2026-04-09 via scripts/apply-ola1-indices.ts
  @@index([tenantId, status], map: "SupportTicket_tenantId_status_idx")
}

// ══════════════════════════════════════════════════════════
// ██ FACTURACIÓN ELECTRÓNICA SUNAT / NUBEFACT
// ══════════════════════════════════════════════════════════

// ─── Configuración SUNAT por tenant ─────────────────────
model TenantSunatConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  ruc             String // RUC del negocio (11 dígitos)
  razonSocial     String // Razón social registrada en SUNAT
  direccionFiscal String? // Dirección fiscal
  ubigeo          String? // Código ubigeo SUNAT (6 dígitos)
  nubefactToken   String // Token API Nubefact
  nubefactUrl     String   @default("https://api.nubefact.com/api/v1")
  boletaSeries    String   @default("B001")
  facturaSeries   String   @default("F001")
  lastBoletaNum   Int      @default(0)
  lastFacturaNum  Int      @default(0)
  isProduction    Boolean  @default(false) // false = sandbox Nubefact
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices SunatInvoice[]

  @@index([tenantId])
}

// ─── Comprobantes electrónicos emitidos ─────────────────
model SunatInvoice {
  id           String    @id @default(cuid())
  tenantId     String
  orderId      String? // orden de venta relacionada (opcional)
  type         String // "boleta" | "factura" | "nota_credito" | "baja"
  series       String // "B001" | "F001" | "BC01" | "FC01"
  number       Int // correlativo
  customerRuc  String? // RUC del receptor (solo facturas)
  customerName String // nombre/razón social del receptor
  subtotal     Decimal   @db.Decimal(12, 2) // monto gravado (sin IGV)
  igv          Decimal   @db.Decimal(12, 2) // monto IGV
  total        Decimal   @db.Decimal(12, 2) // total con IGV
  xmlContent   String? // XML UBL 2.1 generado (texto)
  cdrResponse  String? // CDR XML devuelto por SUNAT
  sunatStatus  String    @default("pending") // pending | accepted | rejected | voided
  nubefactId   String? // ID interno Nubefact
  pdfUrl       String? // URL del PDF generado por Nubefact
  errorMessage String? // mensaje de error si sunatStatus=rejected
  sentAt       DateTime? // cuándo se envió a Nubefact
  acceptedAt   DateTime? // cuándo SUNAT aceptó el CDR
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  config TenantSunatConfig? @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, series, number])
  @@index([tenantId])
  @@index([tenantId, type, series, number])
  @@index([orderId])
  @@index([sunatStatus])
}

// ─── Anti-Churn: Health Score ────────────────────────────
model TenantHealthScore {
  id                 String   @id @default(cuid())
  tenantId           String
  score              Int // 0-100 (100 = muy saludable)
  loginsLast7d       Int      @default(0)
  loginsLast30d      Int      @default(0)
  ordersLast7d       Int      @default(0)
  ordersLast30d      Int      @default(0)
  featuresUsed       Int      @default(0) // de 47 recursos RBAC, cuántos usó
  daysSinceLastOrder Int      @default(0)
  daysSinceLastLogin Int      @default(0)
  trialDaysLeft      Int? // null si no está en trial
  riskLevel          String   @default("low") // low | medium | high | critical
  calculatedAt       DateTime @default(now())

  @@index([tenantId])
  @@index([riskLevel])
  @@index([calculatedAt])
}

// ─── Anti-Churn: Señales de riesgo ──────────────────────
model ChurnSignal {
  id           String    @id @default(cuid())
  tenantId     String
  signalType   String // "login_drop" | "order_drop" | "trial_expiring" | "support_unresolved" | "plan_downgrade_intent"
  severity     String    @default("medium") // low | medium | high | critical
  detail       String
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String? // "auto" | "manual" | username
  intervention String? // qué acción se tomó
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([severity, resolved])
  @@index([createdAt])
}

// ─── Anti-Churn: Playbooks de intervención ───────────────
model ChurnPlaybook {
  id              String   @id @default(cuid())
  name            String // "trial_expiring_3d" | "login_drop_7d" | "order_drop_50pct"
  triggerSignal   String // signal type que lo activa
  triggerSeverity String   @default("high") // mínima severity para activar
  action          String // "email" | "whatsapp" | "discount" | "call"
  templateId      String? // ID de template de email/WhatsApp
  discountPercent Int? // si action = "discount"
  discountDays    Int? // duración del descuento
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([name])
}

// ═══════════════════════════════════════════════════════
// MOTOR DE CRÉDITO INTERNO (Buy-Now-Pay-Later)
// ═══════════════════════════════════════════════════════

model CreditProfile {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String
  creditScore      Int      @default(0) // 0-1000
  creditLimit      Decimal  @default(0) // monto máximo de crédito en PEN @db.Decimal(12, 2)
  usedCredit       Decimal  @default(0) // crédito utilizado actualmente @db.Decimal(12, 2)
  availableCredit  Decimal  @default(0) // creditLimit - usedCredit @db.Decimal(12, 2)
  riskLevel        String   @default("none") // none | low | medium | high
  totalLoans       Int      @default(0) // total de préstamos dados
  paidOnTime       Int      @default(0) // pagados a tiempo
  paidLate         Int      @default(0) // pagados tarde
  defaulted        Int      @default(0) // impagos
  avgTicket        Decimal  @default(0) // ticket promedio de compra @db.Decimal(12, 2)
  purchaseFreqDays Float? // frecuencia de compra en días
  lastScoreUpdate  DateTime @default(now())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  installments CreditInstallment[]
  scoreHistory CreditScoreHistory[]

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([creditScore])
}

model CreditInstallment {
  id                String   @id @default(cuid())
  tenantId          String
  creditProfileId   String
  orderId           String? // orden que generó este crédito
  totalAmount       Decimal  @db.Decimal(12, 2) // monto total del crédito
  installments      Int // número de cuotas (2, 3, 4)
  installmentAmount Decimal  @db.Decimal(12, 2) // monto por cuota
  interestRate      Float    @default(0) // tasa de interés mensual (ej: 0.05 = 5%)
  paidAmount        Decimal  @default(0) @db.Decimal(12, 2)
  paidInstallments  Int      @default(0)
  status            String   @default("active") // active | paid | overdue | defaulted
  nextDueDate       DateTime
  createdAt         DateTime @default(now())

  creditProfile CreditProfile @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([creditProfileId])
  @@index([status, nextDueDate])
}

// ─── Credit Score History (Fiado Digital Phase 1) ─────────────────────────────
// Append-only timeline of credit score snapshots. Used for transparency
// (customer sees "your score went from X to Y") and analytics.
// ADR-021 §3: immutable, tenant-isolated, write-only after creation.
model CreditScoreHistory {
  id                          String   @id @default(cuid())
  tenantId                    String
  customerId                  String
  creditProfileId             String
  score                       Int // 0-1000 at snapshot time
  creditLimit                 Decimal  @db.Decimal(12, 2)
  riskLevel                   String // none | low | medium | high
  // Breakdown at snapshot time (for transparency explainability)
  breakdownPurchaseHistory    Int      @default(0)
  breakdownPaymentPunctuality Int      @default(0)
  breakdownAvgTicket          Int      @default(0)
  breakdownSeniority          Int      @default(0)
  breakdownLoyaltyPoints      Int      @default(0)
  // What triggered this snapshot
  trigger                     String   @default("manual") // manual | weekly_recalc | payment | fiado_close
  createdAt                   DateTime @default(now())

  creditProfile CreditProfile @relation(fields: [creditProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([creditProfileId, createdAt])
  @@index([createdAt])
}

// ─── Credit Reminder (Fiado Digital Phase 2) ──────────────────────────────────
// Idempotent reminder tracking. Each (fiadoId, stage, date) combination
// can only produce one reminder. Prevents double-sends on cron retries.
// ADR-021 §4: stages escalate T-3 → T-1 → T0 → T+1 → T+7 → T+30.
model CreditReminder {
  id             String   @id @default(cuid())
  tenantId       String
  fiadoId        String
  customerId     String
  stage          String // pre_3d | pre_1d | due_day | post_1d | post_7d | post_30d
  channel        String   @default("whatsapp") // whatsapp | notification | sms
  message        String   @db.Text
  sentAt         DateTime @default(now())
  // Idempotency: unique constraint ensures one reminder per fiado+stage+day
  idempotencyKey String   @unique // format: {fiadoId}:{stage}:{YYYY-MM-DD}

  @@index([tenantId])
  @@index([fiadoId])
  @@index([customerId])
  @@index([sentAt])
}

// ─── AI Demand Forecasting ───────────────────────────────
// Registro de predicciones de demanda por SKU.
// El campo actualQty se llena después para medir accuracy real.
model ForecastLog {
  id           String   @id @default(cuid())
  tenantId     String
  productId    Int
  predictedQty Float
  actualQty    Float? // se llena después para medir accuracy
  confidence   Float // 0-1
  trend        String // "up" | "stable" | "down"
  daysAhead    Int
  forecastDate DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([forecastDate])
}

// ─── Supplier Portal — Price Versions ───────────────────
// Historial de cambios de precio publicados por el proveedor.
model SupplierPriceVersion {
  id            String   @id @default(cuid())
  supplierId    String
  productName   String
  sku           String?
  oldPrice      Decimal  @db.Decimal(12, 2)
  newPrice      Decimal  @db.Decimal(12, 2)
  tenantId      String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([supplierId])
  @@index([effectiveDate])
  @@index([tenantId])
}

// ─── Supplier Portal — Monthly Ratings ──────────────────
// Métricas de desempeño calculadas por periodo (mes).
model SupplierRating {
  id              String   @id @default(cuid())
  tenantId        String
  supplierId      String
  period          String // "2026-03"
  ordersPlaced    Int      @default(0)
  ordersDelivered Int      @default(0)
  ordersOnTime    Int      @default(0)
  avgDeliveryDays Float?
  fillRate        Float? // % items entregados vs pedidos
  qualityScore    Float? // 0-5 rating promedio
  calculatedAt    DateTime @default(now())

  @@unique([tenantId, supplierId, period])
  @@index([supplierId])
}

// ─── Supplier Portal — Offers ────────────────────────────
// Ofertas de temporada publicadas por el proveedor.
model SupplierOffer {
  id              String   @id @default(cuid())
  supplierId      String
  title           String
  description     String?
  discountPercent Float?
  minQuantity     Int?
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  tenantId        String
  createdAt       DateTime @default(now())

  @@index([supplierId])
  @@index([validUntil])
  @@index([tenantId])
}

// ─── AI Assistant — Conversation Memory ──────────────────
// Multi-turn conversation history for AI assistant (support + coaching).
// Allows the AI to remember context across multiple messages.
model AIConversation {
  id        String      @id @default(cuid())
  tenantId  String // Required — multi-tenant isolation
  user      String // Username of the user who started this conversation
  channel   String      @default("assistant") // "assistant", "coach", "whatsapp"
  title     String      @default("") // Auto-generated from first message or user-provided
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  messages  AIMessage[]

  @@index([tenantId])
  @@index([user])
  @@index([channel])
  @@index([updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" or "assistant"
  content        String   @db.Text // Up to 10,000 chars for longer responses
  feedback       String? // "up" or "down" — user rating of assistant response
  feedbackNote   String? // User's comment on why they rated it
  mode           String? // Execution mode (for debugging/analytics)
  tokensUsed     Int? // For LLM cost tracking
  latencyMs      Int? // Response latency in milliseconds
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

// ─── Product Analytics ───────────────────────────────────
model ProductAnalytics {
  id          String   @id @default(cuid())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId    String
  date        DateTime @db.Date
  views       Int      @default(0)
  clicks      Int      @default(0)
  addsToCart  Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, date, tenantId])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, date])
}

// ═══════════════════════════════════════════════════════
// MARKETPLACE BLOQUE C — Stock Intelligence + Ads + Search
// ═══════════════════════════════════════════════════════

// ─── C1: Stock Intelligence ──────────────────────────────
// Predicción de cuándo se agota un producto en una tienda concreta.
// El worker de demand-forecast actualiza este registro cada noche.
model StockoutPrediction {
  id                      String   @id @default(cuid())
  tenantId                String
  storeId                 String
  productId               Int
  storeProductId          String
  predictedDaysToStockout Float // días hasta agotamiento
  avgDailyUnits           Float // promedio de unidades vendidas por día
  currentStock            Int // stock al momento del cálculo
  confidence              Float // 0-1
  severity                String // low | medium | high | critical
  computedAt              DateTime
  expiresAt               DateTime // cuándo caduca esta predicción

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storeId])
  @@index([storeId, severity])
  @@index([expiresAt])
}

// ─── C2: Sales Anomalies ─────────────────────────────────
// Anomalías de ventas detectadas por comparación con periodos anteriores.
model SalesAnomaly {
  id             String    @id @default(cuid())
  tenantId       String
  storeId        String
  date           DateTime // día analizado
  comparisonDate DateTime // ej: mismo día semana anterior
  metric         String // revenue | orders | units | aov
  expected       Float
  actual         Float
  deltaPct       Float // diferencia porcentual
  severity       String // low | medium | high | critical
  direction      String // drop | spike
  notifiedAt     DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storeId])
  @@index([storeId, date])
  @@index([severity])
}

// ─── C3: Sponsored Boosts ────────────────────────────────
// El vendedor paga para que su producto aparezca primero.
// Usa Decimal para cumplir TD-018 (Float→Decimal para valores monetarios).
model SponsoredBoost {
  id               String   @id @default(cuid())
  tenantId         String
  storeId          String
  productId        Int
  bidAmount        Decimal  @db.Decimal(10, 2) // PEN por día
  startDate        DateTime
  endDate          DateTime
  status           String   @default("active") // active | paused | expired | exhausted
  impressionsCount Int      @default(0)
  clicksCount      Int      @default(0)
  conversionsCount Int      @default(0)
  totalSpentPen    Decimal  @default(0) @db.Decimal(10, 2)
  maxBudgetPen     Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
  @@index([status, endDate])
}

// ─── C4: Search Suggestions ──────────────────────────────
// Log + caché de búsquedas para autocompletado y autocorrección.
// Se combina con índice GIN trigram sobre Product.name (creado en el SQL manual).
model SearchSuggestion {
  id               String   @id @default(cuid())
  tenantId         String
  query            String // texto original del usuario
  normalizedQuery  String // lowercase + sin tildes
  resultCount      Int
  clickedProductId Int?
  lastSearchedAt   DateTime
  searchCount      Int      @default(1)

  @@unique([tenantId, normalizedQuery])
  @@index([tenantId])
  @@index([tenantId, normalizedQuery])
  @@index([lastSearchedAt])
}

// ─── Roadmap Item Status (Master Roadmap 2026-04-09) ─────
// Estado mutable de los 84 items del master roadmap.
// El contenido vive en lib/roadmap/items.ts (estático en código).
// Este modelo solo guarda el estado (planned/in_progress/done/blocked/skipped),
// progreso 0-100, notas y auditoría. Es PLATFORM-LEVEL (sin tenantId).
model RoadmapItemStatus {
  id          String    @id @default(cuid())
  itemId      String    @unique // slug que matchea RoadmapItem.id en lib/roadmap/items.ts
  status      String    @default("planned") // "planned" | "in_progress" | "done" | "blocked" | "skipped"
  progress    Int       @default(0) // 0-100
  startedAt   DateTime?
  completedAt DateTime?
  notes       String? // historial de notas (append-only con timestamps inline)
  updatedBy   String? // username del superadmin que hizo la última mutación
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([updatedAt])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// PlatformSetting — global platform-level key/value store (NO tenantId).
/// Single source of truth for plan prices, maintenance mode, feature flags, etc.
/// Referenced by lib/db/platform-settings.db.ts + lib/plans.ts (getPlanPrice).
/// Fix del bug MRR fake 2026-04-09 — ver docs/research/superadmin-improvements-2026-04-09.md
/// ─────────────────────────────────────────────────────────────────────────────
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// ─────────────────────────────────────────────────────────────────────────────
/// TenantFeatureFlag — per-tenant DB overrides for feature flags.
/// Allows toggling features at the tenant level without env var changes.
/// Referenced by lib/feature-flags.ts (isFeatureEnabled with DB fallback).
/// ─────────────────────────────────────────────────────────────────────────────
model TenantFeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  flagKey   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// MarketplaceAbandonedCart — carts abandoned during marketplace checkout.
/// Used by the cron job to send WhatsApp recovery messages.
/// Referenced by lib/db/marketplace.db.ts (MarketplaceAbandonedCartsDB).
/// ─────────────────────────────────────────────────────────────────────────────
model MarketplaceAbandonedCart {
  id             String    @id @default(cuid())
  storeSlug      String
  customerName   String
  customerPhone  String
  itemsJson      String /// JSON array of {storeProductId, productId, name, quantity, price, unit}
  total          Decimal   @db.Decimal(12, 2)
  recovered      Boolean   @default(false)
  convertedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeSlug])
  @@index([customerPhone])
  @@index([recovered, reminderSentAt, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// TenantStorePage — customización de la página pública individual por tienda.
/// Una fila por tenant. Controla tema, hero, about, SEO y estado publicado.
/// Referenciado por lib/db/store-page.db.ts (StorePageDB).
/// Página pública: /t/[slug] (server component con "use cache" + cacheTag).
/// ─────────────────────────────────────────────────────────────────────────────
model TenantStorePage {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  published       Boolean  @default(true)
  heroTitle       String?
  heroSubtitle    String?
  heroImageUrl    String?
  heroCtaLabel    String?
  heroCtaUrl      String?
  primaryColor    String   @default("#00B4A6")
  accentColor     String   @default("#f4a261")
  aboutTitle      String?
  aboutBody       String?
  whatsappPhone   String?
  contactEmail    String?
  address         String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  footerHtml      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// TenantPageProductOverride — override de producto para la página individual.
/// Permite al dueño elegir qué productos del inventario aparecen, fijar precio
/// exclusivo (menor al marketplace) y destacarlos. NO afecta marketplace general.
/// ─────────────────────────────────────────────────────────────────────────────
model TenantPageProductOverride {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  exclusivePrice Decimal? @db.Decimal(12, 2)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  badge          String?
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([tenantId, visible, featured])
  @@index([productId])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// TenantPagePromotion — promociones exclusivas de la página individual.
/// Scope limitado: NO aparecen en marketplace ni en admin general de promos.
/// discountType: "percent" | "amount" | "fixed"
/// ─────────────────────────────────────────────────────────────────────────────
model TenantPagePromotion {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  discountType   String    @default("percent")
  discountValue  Decimal   @db.Decimal(12, 2)
  bannerImageUrl String?
  ctaLabel       String?
  ctaUrl         String?
  startAt        DateTime?
  endAt          DateTime?
  active         Boolean   @default(true)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, active, startAt, endAt])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// TenantPageVisit — evento analítico de visita a la página individual.
/// Trackea visitas (pageview) y conversiones (linked orderId) por tenant.
/// Write-heavy: usar índice compuesto para queries de agregado.
/// ─────────────────────────────────────────────────────────────────────────────
model TenantPageVisit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String?
  referrer  String?
  utmSource String?
  userAgent String?
  ipHash    String?
  path      String?
  converted Boolean  @default(false)
  orderId   String?
  visitedAt DateTime @default(now())

  @@index([tenantId, visitedAt])
  @@index([tenantId, converted])
  @@index([sessionId])
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Subscription — "Bodega al Mes" (Amazon Subscribe & Save adaptado PE).
/// ADR-076. Feature mutable: status/frequency/quantity cambian durante la vida.
/// userId hace FK lógico a Customer.phone (no físico — evita CASCADE inesperado).
/// ─────────────────────────────────────────────────────────────────────────────
enum SubscriptionFreq {
  weekly
  biweekly
  monthly
  bimonthly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String // multi-tenant isolation (CLAUDE.md #3)
  userId         String // FK lógico a Customer.phone
  productId      Int // FK lógico a Product.id
  frequency      SubscriptionFreq
  quantity       Int                @default(1)
  discount       Decimal            @default(0.05) @db.Decimal(5, 4) // 5 % default, 4 decimales
  status         SubscriptionStatus
  nextDeliveryAt DateTime
  pausedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deliveries SubscriptionDelivery[]

  @@index([tenantId, userId, status])
  @@index([tenantId, nextDeliveryAt, status])
  @@index([tenantId, status])
  @@map("subscriptions")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// SubscriptionDelivery — ledger append-only de cada entrega programada.
/// ADR-076. Cada row es una entrega (real o saltada). orderId es nullable
/// porque una entrega saltada no genera pedido.
/// ─────────────────────────────────────────────────────────────────────────────
model SubscriptionDelivery {
  id             String    @id @default(cuid())
  subscriptionId String
  tenantId       String
  scheduledFor   DateTime
  deliveredAt    DateTime?
  skipped        Boolean   @default(false)
  skipReason     String?
  orderId        String? // FK lógico a Order.id cuando se crea pedido real
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, subscriptionId])
  @@index([tenantId, scheduledFor])
  @@map("subscription_deliveries")
}

// ═══════════════════════════════════════════════════════════════════════════
// GIFT CARDS (ADR-077 — HMAC-hashed codes + redemption ledger)
// ═══════════════════════════════════════════════════════════════════════════
//
// IMPORTANT: estas definiciones se INSERTAN al final de `prisma/schema.prisma`
// (no son un segundo schema). Este archivo existe SOLO para que revisores
// puedan ver el delta aislado en PR y para que el hook danger-zone no bloquee
// la creación del contenido; el agente que aplique el merge tiene que pegar
// el contenido abajo del model `TenantPageVisit` de schema.prisma.
//
// Una "gift card Buleje" es un producto virtual que guarda saldo en soles.
// NUNCA almacenamos el código plano: solo el HMAC-SHA256(code, AUTH_SECRET).
// El código original se devuelve UNA SOLA VEZ al comprador (sender) tras
// la compra; a partir de ese momento solo queda `codeHash` + `codeLast4`
// (para UI masked "****-XXXX"). Ver docs/adr/077-gift-cards-hmac-redemption.md.
//
// Ciclo de vida:
//   pending_delivery → active → partially_redeemed → fully_redeemed
//                                              ↘ cancelled / expired
//
// Canje seguro: prisma.$transaction con SELECT FOR UPDATE de la fila para
// evitar double-spend bajo concurrencia. Ver lib/db/gift-cards.db.ts.

enum GiftCardDesign {
  cumpleanos
  navidad
  felicitaciones
  aniversario
  gracias
  anio_nuevo
  bienvenida
  general
}

enum GiftCardStatus {
  pending_delivery // comprada pero aún no enviada al destinatario
  active // activa, se puede canjear
  fully_redeemed // saldo 0
  partially_redeemed // saldo > 0 pero < amount original
  expired
  cancelled
}

model GiftCard {
  id              String         @id @default(cuid())
  tenantId        String
  codeHash        String         @unique // HMAC-SHA256(code + AUTH_SECRET) — NUNCA code plano
  codeLast4       String // para UI masked "****-XXXX"
  amountSoles     Decimal        @db.Decimal(10, 2)
  balanceSoles    Decimal        @db.Decimal(10, 2) // saldo restante (reducir en partial redemption)
  currency        String         @default("PEN")
  design          GiftCardDesign
  status          GiftCardStatus
  senderName      String?
  senderEmail     String?
  senderUserId    String? // FK Customer si sender logueado
  recipientName   String
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String? // FK Customer si destinatario claimea (en /cuenta)
  dedicatoria     String?        @db.Text
  expiresAt       DateTime? // null = no expira (política actual "sin vencimiento")
  purchasedAt     DateTime       @default(now())
  firstRedeemedAt DateTime?
  fullyRedeemedAt DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  redemptions GiftCardRedemption[]

  @@index([tenantId, recipientUserId, status])
  @@index([tenantId, senderUserId])
  @@index([tenantId, status])
  @@index([codeHash])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id             String   @id @default(cuid())
  giftCardId     String
  tenantId       String
  userId         String? // Customer que canjeó (null si guest)
  orderId        String? // FK Order si aplicó a pedido
  amountRedeemed Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)

  @@index([tenantId, giftCardId])
  @@index([tenantId, userId])
  @@index([tenantId, redeemedAt])
  @@map("gift_card_redemptions")
}

// ─── Socio Buleje — Membresía Prime-like (ADR-078) ──────────────────
/// Programa de suscripción mensual/anual del marketplace. Beneficios:
/// delivery gratis, 5% cashback, early access, precios exclusivos.
///
/// Tres tablas (ADR-078):
///   1. SocioMembership     — contrato vivo (mutable).
///   2. SocioBillingCycle   — ciclo de cobro mensual/anual.
///   3. SocioCashbackEntry  — ledger append-only del saldo cashback.
///
/// Write path: lib/db/socio-buleje.db.ts (todos los métodos).
/// Cron diario: app/api/cron/socio/renew-cycles.
// ─────────────────────────────────────────────────────────────────────

enum SocioPlan {
  monthly
  annual
}

enum SocioStatus {
  trial
  active
  past_due
  paused
  cancelled
}

enum BillingCycleStatus {
  pending
  paid
  failed
  waived
}

enum CashbackEntryType {
  earned
  redeemed
  expired
  bonus
  adjustment
}

model SocioMembership {
  id                String      @id @default(cuid())
  tenantId          String
  userId            String
  plan              SocioPlan
  status            SocioStatus
  startedAt         DateTime    @default(now())
  currentPeriodEnd  DateTime
  trialEndsAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  cancelAtPeriodEnd Boolean     @default(false)
  autoRenew         Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  billingCycles   SocioBillingCycle[]
  cashbackEntries SocioCashbackEntry[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, currentPeriodEnd, status])
  @@index([tenantId, cancelAtPeriodEnd])
  @@map("socio_memberships")
}

model SocioBillingCycle {
  id            String             @id @default(cuid())
  membershipId  String
  tenantId      String
  periodStart   DateTime
  periodEnd     DateTime
  amountSoles   Decimal            @db.Decimal(10, 2)
  status        BillingCycleStatus
  paidAt        DateTime?
  invoiceId     String?
  failureReason String?
  createdAt     DateTime           @default(now())

  membership SocioMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@index([tenantId, periodEnd, status])
  @@map("socio_billing_cycles")
}

model SocioCashbackEntry {
  id           String            @id @default(cuid())
  membershipId String
  tenantId     String
  userId       String
  orderId      String?
  type         CashbackEntryType
  amountSoles  Decimal           @db.Decimal(10, 2)
  description  String
  balanceAfter Decimal           @db.Decimal(10, 2)
  createdAt    DateTime          @default(now())

  membership SocioMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, membershipId, type])
  @@index([tenantId, orderId])
  @@map("socio_cashback_entries")
}

model VendorApplication {
  id String @id @default(cuid())

  // ── Datos del negocio (wizard step 1) ──────────────────
  businessName String
  ruc          String         @unique
  address      String
  district     VendorDistrict
  category     VendorCategory

  // ── Contacto (wizard step 2) ───────────────────────────
  contactName  String
  contactDni   String
  contactPhone String
  contactEmail String

  // ── Verificacion (wizard step 3) ───────────────────────
  rucDocumentUrl     String?
  storefrontPhotoUrl String?
  termsAcceptedAt    DateTime?

  // ── Horarios + delivery (wizard step 4) ────────────────
  schedule         Json
  deliveryZones    Json
  deliveryFeeSoles Decimal @db.Decimal(10, 2)

  // ── Plan (wizard step 5) ───────────────────────────────
  plan VendorPlan

  // ── Workflow ───────────────────────────────────────────
  status          ApplicationStatus @default(pending)
  submittedAt     DateTime          @default(now())
  reviewStartedAt DateTime?
  decidedAt       DateTime?
  reviewerUserId  String?
  decisionReason  String?           @db.Text
  infoRequestNote String?           @db.Text

  // ── Post-approval: link al tenant ──────────────────────
  tenantId   String? @unique
  tenantSlug String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews VendorApplicationReview[]

  @@index([status, submittedAt])
  @@index([district, status])
  @@index([contactEmail])
  @@map("vendor_applications")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// VendorApplicationReview — log append-only de cada accion sobre una solicitud.
/// Nunca se actualiza ni borra. Es la historia de vida de la aplicacion.
/// ─────────────────────────────────────────────────────────────────────────────
model VendorApplicationReview {
  id             String                  @id @default(cuid())
  applicationId  String
  reviewerUserId String
  action         ApplicationReviewAction
  note           String?                 @db.Text
  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  createdAt      DateTime                @default(now())

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([reviewerUserId])
  @@map("vendor_application_reviews")
}

enum VendorDistrict {
  callerya
  yarinacocha
  manantay
  puerto_callao
  pucallpa_centro
  san_fernando
  masisea
  otros_ucayali
}

enum VendorCategory {
  bodega
  minimarket
  carniceria
  fruteria
  panaderia
  licoreria
  farmacia
  ferreteria
  restaurante_comida
}

enum VendorPlan {
  free
  pro
}

enum ApplicationStatus {
  pending
  under_review
  info_requested
  approved
  tenant_provisioned
  rejected
}

enum ApplicationReviewAction {
  start_review
  request_info
  approve
  reject
  reopen
}

enum LiveStatus {
  scheduled
  live
  ended
  cancelled
}

enum ModerationState {
  approved
  flagged
  removed
}

enum LiveViewerEventType {
  joined
  left
  heartbeat
  product_click
  add_to_cart
  ordered
}

/// Transmisión en vivo. State machine: scheduled → live → ended (o scheduled → cancelled).
/// streamUrl / recordingUrl nullable — streaming real (WebRTC/HLS) queda fuera del ADR-080.
/// Agregados se calculan al endLive desde LiveViewerEvent + LiveChatMessage.
model LiveSession {
  id              String     @id @default(cuid())
  tenantId        String
  storeId         String?
  title           String
  description     String?
  thumbnailUrl    String?
  status          LiveStatus
  scheduledFor    DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  streamUrl       String?
  recordingUrl    String?
  viewersPeak     Int        @default(0)
  viewersAvg      Int        @default(0)
  messagesCount   Int        @default(0)
  ordersGenerated Int        @default(0)
  gmvSoles        Decimal    @default(0) @db.Decimal(10, 2)
  categoryChips   String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products     LiveProduct[]
  messages     LiveChatMessage[]
  viewerEvents LiveViewerEvent[]

  @@index([tenantId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([tenantId, endedAt])
  @@map("live_sessions")
}

/// Producto destacado dentro de una transmisión. featuredOrder define el orden
/// del panel lateral; highlightedAt marca "lo de ahora" durante el stream.
/// Contadores addedToCart / orderedCount se incrementan via trackViewerEvent.
model LiveProduct {
  id            String    @id @default(cuid())
  liveSessionId String
  tenantId      String
  productId     Int
  featuredOrder Int
  highlightedAt DateTime?
  addedToCart   Int       @default(0)
  orderedCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  session LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, productId])
  @@index([tenantId, liveSessionId, featuredOrder])
  @@map("live_products")
}

/// Mensaje de chat en vivo. moderationState=flagged oculta el mensaje del feed público.
/// Rate limit 10 msg/min por userId / anonymousId (ADR-080).
model LiveChatMessage {
  id              String          @id @default(cuid())
  liveSessionId   String
  tenantId        String
  userId          String?
  userName        String
  message         String
  moderationState ModerationState @default(approved)
  createdAt       DateTime        @default(now())

  session LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, createdAt])
  @@index([tenantId, moderationState])
  @@map("live_chat_messages")
}

/// Eventos de viewer (joined/left/heartbeat/product_click/add_to_cart/ordered).
/// Retention: 90 días detallados, después rollup a totales del LiveSession (cron v2, ADR-080).
model LiveViewerEvent {
  id            String              @id @default(cuid())
  liveSessionId String
  tenantId      String
  userId        String?
  anonymousId   String?
  eventType     LiveViewerEventType
  productId     Int?
  createdAt     DateTime            @default(now())

  session LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, eventType, createdAt])
  @@index([tenantId, createdAt])
  @@map("live_viewer_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// PaymentApproval — Yape Vision close-loop.
// Tabla creada en migration 20260502120000_add_payment_approval. La IA Claude
// Sonnet 4.6 Vision compara captura vs expectedAmount; humanos del equipo
// Buleje revisan dudas en /superadmin/pagos-yape.
// expand-migrate-contract: tenantId TEXT NULLABLE (ccfffa33) →
// NOT NULL aplicado via pg ALTER TABLE (multi-tenant-contract-audit branch).
// audit-first: verificado 0 rows NULL antes de SET NOT NULL.
// ─────────────────────────────────────────────────────────────────────────────
model PaymentApproval {
  id              String    @id
  tenantId        String
  conversationId  String?
  customerPhone   String
  expectedAmount  Decimal   @db.Decimal(12, 2)
  detectedAmount  Decimal?  @db.Decimal(12, 2)
  imageUrl        String
  visionResponse  Json?
  yapeOpCode      String?
  yapeLast4       String?
  yapeDate        DateTime?
  status          String    @default("pending") // pending|review_required|approved|rejected
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([conversationId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// EventDeadLetter — DLQ persistente para eventos de dominio fallidos.
// Antes (audit P0-2): InMemoryDeadLetterQueue vivía en RAM y perdía eventos
// en cada cold start de Vercel. Ahora persistido en Postgres para sobrevivir
// reinicios. Indexes (tenantId, resolvedAt) y (eventType, resolvedAt) cubren
// los queries de retry-cron y dashboards de superadmin.
// ─────────────────────────────────────────────────────────────────────────────
model EventDeadLetter {
  id           String    @id @default(cuid())
  tenantId     String
  eventType    String
  eventPayload Json
  occurredAt   DateTime
  failedAt     DateTime  @default(now())
  attemptCount Int       @default(1)
  lastError    String
  handlerName  String
  resolvedAt   DateTime?

  @@index([tenantId, resolvedAt])
  @@index([eventType, resolvedAt])
}

// ─── ClientErrorLog ─────────────────────────────────────
// Errores runtime del panel admin de los negocios (reportados por el error
// boundary vía /api/admin/log-error). Brandon 2026-06-19: antes solo se
// logueaban; ahora se persisten con tenantId para verlos en vivo en el
// superadmin y ayudar al negocio. Dedup por (tenantId+digest+source) sin
// resolver → incrementa `count` en vez de crear filas nuevas.
model ClientErrorLog {
  id          String    @id @default(cuid())
  tenantId    String
  digest      String?
  message     String    @db.Text
  source      String    @default("")
  userAgent   String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([resolvedAt, lastSeenAt])
  @@index([tenantId])
  @@index([digest])
}

// ─── Industry (nicho de negocio) ────────────────────────
// Permite que el panel admin se especialice por tipo de negocio.
// Default: bodega — todos los tenants actuales quedan en este valor.
enum Industry {
  bodega // minimarket / abarrotes — default
  restaurante // mesas, cocina, comanda
  madereria // pietaje, cubicación, GuiaRemision SUNAT
  farmacia // batch FEFO estricto, recetas médicas
  ferreteria // catálogo extenso, ventas B2B
  panaderia // produccion lote, recetas
  otro // genérico / custom
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTOS v2 — Drive interno enterprise (sprint 2026-05-10)
// Expand-only: 5 tablas + 1 plantilla. Sin ALTER sobre modelos existentes.
// Multi-tenant via tenantId. customer/order/supplier son soft-FK (string).
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String    @id @default(cuid())
  tenantId     String
  folderId     String?
  name         String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  category     String    @default("otros")
  tags         String[]  @default([])
  favorite     Boolean   @default(false)
  // Workflow del documento: none | draft | review | approved | archived.
  status       String    @default("none")
  expiresAt    DateTime?

  customerId String?
  orderId    String?
  supplierId String?

  ocrText     String?  @db.Text
  ocrMetadata Json?
  aiCategory  String?
  aiTags      String[] @default([])

  // Permisos a nivel documento: si está vacío, lo ven todos los admins; si tiene
  // roles, solo esos (los roles privilegiados —admin/owner/manager— ven todo).
  allowedRoles String[] @default([])

  // ADR-119 — anti-spam del cron de vencimiento. Se setea al enviar el aviso
  // de WhatsApp y se limpia al cambiar expiresAt para re-armar el ciclo.
  expiryReminderSentAt DateTime?

  uploadedById String
  uploadedAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  folder    DocumentFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions  DocumentVersion[]
  shares    DocumentShare[]
  auditLogs DocumentAuditLog[]

  @@index([tenantId, folderId, deletedAt])
  @@index([tenantId, category])
  @@index([tenantId, favorite])
  @@index([tenantId, uploadedAt])
  @@index([tenantId, expiresAt]) // ADR-119 — query "por vencer"
  @@index([tenantId, status])
}

model DocumentFolder {
  id           String   @id @default(cuid())
  tenantId     String
  parentId     String?
  name         String
  color        String?
  icon         String?
  /// Emoji elegido por el dueño de la carpeta. Es CONTENIDO del usuario (como el
  /// color), no iconografía del design system: gana sobre `icon` al dibujarla.
  emoji        String?
  /// Etiquetas de la carpeta ("legal", "sunat"): agrupan carpetas que no están
  /// juntas en el árbol. Distintas de las etiquetas de documento.
  tags         String[] @default([])
  // Permisos por carpeta: vacío = todos los admins; con roles = solo esos.
  // Los documentos dentro heredan esta restricción.
  allowedRoles String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// SetNull y no Cascade: la FK en la base es `ON DELETE SET NULL` (verificado
  /// 2026-07-29 contra el catálogo de Postgres) y el schema declaraba Cascade,
  /// así que la UI prometía un borrado en cascada que nunca ocurrió — las
  /// subcarpetas quedaban en la raíz. Se alinea la declaración con la realidad;
  /// borrar el árbol completo es una acción EXPLÍCITA de la UI, no un efecto
  /// secundario de la FK.
  parent    DocumentFolder?       @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DocumentFolder[]      @relation("DocumentFolderTree")
  documents Document[]
  shares    DocumentFolderShare[]

  @@index([tenantId, parentId])
  @@index([tags], type: Gin)
}

model DocumentFolderShare {
  id           String    @id @default(cuid())
  folderId     String
  tenantId     String
  token        String    @unique
  expiresAt    DateTime
  password     String?
  createdById  String
  createdAt    DateTime  @default(now())
  accessCount  Int       @default(0)
  lastAccessAt DateTime?
  revokedAt    DateTime?

  folder DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tenantId, createdAt])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  storagePath   String
  size          Int
  mimeType      String
  uploadedById  String
  uploadedAt    DateTime @default(now())
  changeNote    String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentShare {
  id           String    @id @default(cuid())
  documentId   String
  tenantId     String
  token        String    @unique
  expiresAt    DateTime
  password     String?
  createdById  String
  createdAt    DateTime  @default(now())
  accessCount  Int       @default(0)
  lastAccessAt DateTime?
  revokedAt    DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tenantId, createdAt])
}

model DocumentAuditLog {
  id         String   @id @default(cuid())
  documentId String
  tenantId   String
  actorId    String
  action     String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([documentId, createdAt])
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String
  name        String
  description String?
  body        String   @db.Text
  fields      Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════
// ADELANTOS & LIQUIDACIONES (ADR-XXX, 2026-05-25)
// Adelanto de dinero a una persona/proveedor por servicios, liquidado a
// medida que entrega producto/servicio. Distinto de Prestamo (cuotas+interes),
// Fiado (credito a cliente) y Treasury (libro de caja). Saldo a favor del
// negocio que se consume con entregas valuadas. Totales SIEMPRE en backend.
// ═══════════════════════════════════════════════════════

enum AdelantoModalidad {
  CUENTA_CORRIENTE // saldo se consume libremente con cada entrega
  ENTREGAS_PACTADAS // plan fijo de entregas esperadas
  DESCUENTO_PLANILLA // adelanto de sueldo: se descuenta del pago del período (ADR-329)
}

enum AdelantoStatus {
  ABIERTO // saldo pendiente > 0
  LIQUIDADO // saldo == 0 (entregas == monto adelantado)
  EXCEDIDO // entregas > monto adelantado (el negocio le debe a la persona)
  CANCELADO // anulado manualmente
}

enum AdelantoEntregaTipo {
  LIBRE // descripcion + valor manual
  PRODUCTO // vinculado a Product (cantidad x precio)
}

model AdelantoBeneficiario {
  id                 String               @id @default(cuid())
  tenantId           String
  nombre             String
  documento          String? // DNI / RUC
  telefono           String?
  notas              String?
  limiteCredito      Decimal?             @db.Decimal(12, 2) // ADR-118: tope de adelanto por persona
  ultimoRecordatorio DateTime? // ADR-118: último recordatorio de cobranza (server-side)
  /// (330) Identidad oficial, traída de RENIEC/SUNAT al tipear el documento.
  /// "DNI" | "RUC" | "CE" | "OTRO" — decide contra qué padrón se consulta.
  tipoDocumento      String?
  /// Razón social de SUNAT cuando es RUC. `nombre` queda como el nombre con el
  /// que se lo conoce en el mostrador, que casi nunca es el legal.
  razonSocial        String?
  direccion          String?
  /// El ubigeo en columnas propias (331): SUNAT los manda separados y pegarlos
  /// dentro de `direccion` obliga a adivinar dónde termina la calle.
  departamento       String?
  provincia          String?
  distrito           String?
  email              String?
  /// "ACTIVO" | "BAJA DE OFICIO" | … y "HABIDO" | "NO HABIDO": un RUC no habido
  /// no sirve para deducir la factura, y eso hay que saberlo ANTES de pagar.
  estadoSunat        String?
  condicionSunat     String?
  /// Cuándo se contrastó contra el padrón oficial. Sin esto no se sabe si el
  /// dato es de hoy o de hace dos años.
  verificadoEn       DateTime?
  /// Para transferirle el adelanto sin salir a buscar el número a un WhatsApp.
  banco              String?
  cuentaBancaria     String?
  cci                String?
  /// Baja lógica: el DELETE se bloquea (bien) si la persona tiene adelantos,
  /// así que sin esto la libreta sólo podía crecer.
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adelantos          Adelanto[]
  recurrentes        AdelantoRecurrente[]
  gestiones          AdelantoGestion[]

  @@index([tenantId])
  @@index([tenantId, nombre])
  @@index([tenantId, documento])
  @@index([tenantId, activo])
}

// ADR-118: plantilla de adelantos recurrentes (materializados por cron diario)
/// (333) La bitácora de cobranza: QUÉ pasó en cada gestión, no sólo cuándo.
///
/// `ultimoRecordatorio` alcanzaba para no escribir dos veces el mismo día y para
/// nada más. Una promesa de pago —el compromiso más fácil de reclamar— se perdía
/// en la memoria de quien atendió.
model AdelantoGestion {
  id             String               @id @default(cuid())
  tenantId       String
  beneficiarioId String
  fecha          DateTime             @default(now())
  /// RECORDATORIO | PROMESA | NO_CONTESTA | REFINANCIAR | VISITA | PAGO | OTRO
  tipo           String               @default("RECORDATORIO")
  nota           String?
  /// Sólo tipo PROMESA. Vive en la PERSONA y no en un adelanto porque se
  /// promete «te pago todo el viernes», que puede abarcar varios suyos.
  fechaPrometida DateTime?
  montoPrometido Decimal?             @db.Decimal(12, 2)
  /// Quién la anotó: una gestión sin autor no se le puede preguntar a nadie.
  usuario        String?
  createdAt      DateTime             @default(now())
  beneficiario   AdelantoBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@index([tenantId, beneficiarioId, fecha])
  @@index([tenantId, fechaPrometida])
}

model AdelantoRecurrente {
  id               String               @id @default(cuid())
  tenantId         String
  beneficiarioId   String
  modalidad        AdelantoModalidad    @default(CUENTA_CORRIENTE)
  monto            Decimal              @db.Decimal(12, 2)
  moneda           String               @default("PEN")
  frecuencia       String // "semanal" | "quincenal" | "mensual"
  diaSemana        Int? // 0-6 (semanal/quincenal)
  diaMes           Int? // 1-28 (mensual)
  activo           Boolean              @default(true)
  ultimaEjecucion  DateTime?
  proximaEjecucion DateTime?
  notas            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiario     AdelantoBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([activo, proximaEjecucion])
}

model Adelanto {
  id               String                   @id @default(cuid())
  tenantId         String
  /// (ADR-329) El identificador que se dice por teléfono y se escribe en el
  /// papel: «ADL-2026-0007». El `id` es un cuid de 25 caracteres — sirve para la
  /// máquina, no para alguien que tiene que buscarlo o dictarlo. Único POR
  /// TENANT: cada negocio lleva su numeración.
  codigoOperacion  String?
  /// N° del talonario de papel que se le entregó a la persona: el puente entre
  /// el sistema y lo que quedó firmado sobre el mostrador.
  reciboManual     String?
  beneficiarioId   String
  modalidad        AdelantoModalidad        @default(CUENTA_CORRIENTE)
  montoAdelantado  Decimal                  @db.Decimal(12, 2)
  moneda           String                   @default("PEN")
  fechaAdelanto    DateTime                 @default(now())
  /// (332) Cuándo se acordó devolverlo. Sin esto, la cobranza sólo podía medir
  /// ANTIGÜEDAD para los adelantos sin plan de cuotas — y la antigüedad no es
  /// un incumplimiento.
  fechaVencimiento DateTime?
  status           AdelantoStatus           @default(ABIERTO)
  // Mantenido por backend: montoAdelantado - SUM(entregas.valor). Negativo => EXCEDIDO.
  saldoPendiente   Decimal                  @db.Decimal(12, 2)
  notas            String?
  comprobanteUrl   String? // ADR-118: foto/comprobante del adelanto
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiario     AdelantoBeneficiario     @relation(fields: [beneficiarioId], references: [id], onDelete: Restrict)
  entregas         AdelantoEntrega[]
  entregasPactadas AdelantoEntregaPactada[]

  @@unique([tenantId, codigoOperacion])
  @@index([tenantId, status])
  @@index([tenantId, fechaAdelanto])
  @@index([tenantId, reciboManual])
  @@index([tenantId, fechaVencimiento])
  @@index([beneficiarioId])
}

model AdelantoEntrega {
  id             String                  @id @default(cuid())
  adelantoId     String
  fecha          DateTime                @default(now())
  tipo           AdelantoEntregaTipo     @default(LIBRE)
  descripcion    String?
  // Solo tipo PRODUCTO: referencia suelta a Product.id (sin relacion formal — desacople).
  productId      Int?
  cantidad       Decimal?                @db.Decimal(12, 3)
  // Valor en S/ que descuenta del saldo — SIEMPRE calculado en backend.
  valor          Decimal                 @db.Decimal(12, 2)
  sumadoAStock   Boolean                 @default(false)
  notas          String?
  comprobanteUrl String? // ADR-118: foto/comprobante de la entrega
  createdAt      DateTime                @default(now())
  adelanto       Adelanto                @relation(fields: [adelantoId], references: [id], onDelete: Cascade)
  pactada        AdelantoEntregaPactada?

  @@index([adelantoId])
  @@index([adelantoId, fecha])
}

model AdelantoEntregaPactada {
  id                  String           @id @default(cuid())
  adelantoId          String
  numero              Int
  descripcionEsperada String
  valorEsperado       Decimal          @db.Decimal(12, 2)
  fechaEsperada       DateTime?
  cumplidaEn          DateTime?
  // Link a la entrega real que la cumplio (1:1 opcional).
  entregaId           String?          @unique
  adelanto            Adelanto         @relation(fields: [adelantoId], references: [id], onDelete: Cascade)
  entrega             AdelantoEntrega? @relation(fields: [entregaId], references: [id], onDelete: SetNull)

  @@index([adelantoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FORESTAL / CTP — Centro de Transformación Primaria (ADR-124, 2026-05-28)
// ─────────────────────────────────────────────────────────────────────────────
//
// Modulo de especialización forestal. Habilitable por tenant vía TenantFeatureFlag
// con flagKey "spec:forestal:ctp-libro" (set desde /superadmin/specializations).
//
// LOE-CTP (Libro de Operaciones Electrónico de Centros de Transformación
// Primaria) — registro oficial SERFOR del flujo de productos forestales
// maderables ingresando a un CTP. Spec normativa:
//   - RDE N° D000009-2023-MIDAGRI-SERFOR-DE (oficializa LOE-CTP)
//   - RDE N° D000014-2024-MIDAGRI-SERFOR-DE (formato GTF + anexos)
//
// Este módulo NO reemplaza el sistema oficial SERFOR (LOE-CTP V2.6.1
// vive en sniffs.serfor.gob.pe) — es un libro PARALELO interno para
// gestión operativa del tenant, con campos compatibles para futuro
// integración / sync.

enum WoodEntryStatus {
  pendiente // Recién ingresado, esperando validación
  validado // Validado por responsable (firmado)
  rechazado // Documentación incompleta o inconsistencias
  procesado // Madera ya transformada / consumida en producción
  anulado // Anulado (error de tipeo, no contó); soft-history
}

enum WoodOriginType {
  concesion // Concesión forestal (titular habilitante)
  predio_privado // Predio privado con plan de manejo
  comunidad_nativa // Comunidad nativa / campesina
  reforestacion // Plantación / proyecto de reforestación
  retroaserradero // Re-entrada desde otro aserradero (origen CTP)
  otro
}

enum WoodProductType {
  rolliza // Madera rolliza (troncos sin procesar)
  aserrada // Aserrada (tabla/tablón cortado)
  tablones // Tablones específicamente
  listones // Listones (medidas estandarizadas)
  durmientes // Durmientes (railway ties)
  pulgada // Comercializada en pulgadas (medida tradicional)
  carbon // Carbón vegetal
  lena // Leña / firewood
  otro
}

enum DocumentType {
  RUC
  DNI
  CE // Carnet de Extranjería
  PASAPORTE
}

// WoodEntry — registro de ingreso de madera al CTP (planta).
// 1 entry = 1 GTF + 1 especie + 1 product type. Si la GTF trae múltiples
// especies/productos, se crean N entries con el mismo gtfNumber.
model WoodEntry {
  id       String @id @default(cuid())
  tenantId String

  /// (1) "N° Registro del libro de operaciones" del formato oficial LO-CTP
  /// (ADR-311). Folio correlativo por tenant, asignado dentro de la tx del
  /// INSERT. Estable: no se recalcula al listar — el libro tiene que casar con
  /// lo ya presentado a la autoridad.
  libroNro Int?

  // ── Fecha + Guía de Transporte Forestal (SERFOR) ─────
  entryDate            DateTime  @default(now())
  /// (3) "Tipo de documento" con el que ingresó: GTF | GRR.
  docType              String?   @default("GTF")
  /// N° de constancia de registro del SNIFFS (`1-19-0313629`): con ese número se
  /// consulta la guía en la base pública de SERFOR.
  serforNumeroRegistro String?
  /// La ficha OFICIAL tal como la publicó SERFOR (titular, propietario,
  /// destinatario, transportista, detalle de productos y lista de trozas).
  /// Se guarda para poder reimprimir la GTF y probar el origen de cada dato sin
  /// depender de que el servicio de ellos esté arriba el día de la fiscalización.
  serforGtf            Json?
  gtfNumber            String // (4) "N° de documento" — Número de Guía de Transporte Forestal
  gtfDate              DateTime?
  /// Cuándo la madera LLEGÓ físicamente a la planta (ADR-335).
  ///
  /// No es `entryDate` —la fecha del asiento en el libro— ni `gtfDate` —la del
  /// documento—: el camión puede salir el lunes, la guía tener fecha del viernes
  /// anterior y descargarse el martes. El plazo de registro y la recepción se
  /// cuentan desde ESTA, y es lo primero que pregunta una fiscalización cuando
  /// las otras dos no coinciden.
  fechaRecepcion       DateTime?
  gtfSeries            String? // Serie de la GTF (si aplica)

  /// El cuerpo del documento que ampara ESTE ingreso: propietario del producto
  /// (casilleros 13-21 del formato), destinatario (22-28), transportista y
  /// vehículo (29-34), comprobante de compra y los casilleros sueltos.
  ///
  /// Misma forma que `ForestCtpEntry.gtfDatos` —la guía de salida— y se lee con
  /// el MISMO `leerGtfDatos()`: dos esquemas para el mismo formato oficial
  /// terminan divergiendo, y un fiscalizador compara los dos lados del libro.
  /// JSON y no columnas porque son declaraciones de un documento ajeno: se
  /// guardan enteras y no se consultan campo por campo.
  gtfDatos             Json?

  // ── Proveedor / Titular Habilitante ──────────────────
  /// SE QUEDA aunque exista `supplierId`: es el acta de la guía, no un mirror
  /// del maestro de proveedores (ADR-134 D2). Nunca se borra ni se deriva.
  providerName         String
  providerDocument     String? // RUC/DNI/CE/PASAPORTE number
  providerDocumentType DocumentType?

  /// Enlace opcional al maestro de proveedores (ADR-134). NULL = guía de un
  /// titular que todavía no está en Supplier; el acta de arriba sigue valiendo.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // ── Costo de materia prima (ADR-134) ─────────────────
  /// S/ total de la factura del proveedor. Llega TARDE (D6) ⇒ nullable por diseño.
  /// El costo unitario NO se almacena: se deriva como costoTotal / volumeM3.
  /// Sin factura → NULL, nunca 0 (un 0 fingiría margen 100%).
  costoTotal Decimal? @db.Decimal(12, 2)
  moneda     String?  @default("PEN")

  // ── Origen del material ──────────────────────────────
  originType         WoodOriginType @default(otro)
  /// (9) "Código de origen/procedencia": el código con el que el producto SALIÓ
  /// de la fuente de origen (para trozas, el que le pusieron en el bosque).
  originCode         String?
  /// (5) "N° de fuente de origen o procedencia" (Apartado 1 del formato): de
  /// dónde viene la madera. Texto libre a propósito — lo emite la ARFFS y varía
  /// por región (ADR-311).
  originSourceNumber String?
  /// (10) "Código de CTP" de la Sección 1: el código que ESTE centro le asigna al
  /// producto al ingresar (por troza, o por carga/paquete si son diámetros
  /// menores) y marca físicamente sobre la madera para identificarla dentro de la
  /// planta. NO es el código de otro CTP; el del centro propio vive en la Ficha.
  ctpProductCode     String?
  originRegion       String? // Loreto, Ucayali, Madre de Dios, etc.
  originDistrict     String? // Distrito específico

  // ── Especie ──────────────────────────────────────────
  speciesCommonName     String // "Tornillo", "Capirona", "Shihuahuaco"
  speciesScientificName String? // "Cedrelinga catenaeformis"
  speciesCites          Boolean @default(false) // ¿En CITES (protegida)?

  // ── Producto ─────────────────────────────────────────
  productType   WoodProductType @default(rolliza)
  /// "Forma de presentación" del formato LO-CTP (ADR-314): cómo viene
  /// físicamente el producto — TROZAS, PIEZAS, PAQUETES… La guía de SERFOR la
  /// declara y hasta ahora se perdía al registrar el ingreso.
  presentacion  String?
  /// (11) "Unidad de medida" declarada en el documento (m3 | unidad | kg | tonelada).
  /// INFORMATIVA: todo el libro —saldos, invariantes I1-I5, costeo— se calcula en
  /// m³ y `volumeM3` sigue siendo la cantidad. Cambiar la unidad base es otro ADR.
  unit          String?         @default("m3")
  volumeM3      Decimal         @db.Decimal(12, 4) // (12) "Cantidad" — 4 decimales, precisión forestal
  pieces        Int             @default(0)
  avgLengthM    Decimal?        @db.Decimal(8, 2) // Largo promedio metros
  avgDiameterCm Decimal?        @db.Decimal(8, 2) // Diámetro promedio cm (rolliza)
  humidityPct   Decimal?        @db.Decimal(5, 2) // % humedad
  defectsNotes  String? // Defectos visibles (nudos, podredumbre)

  // ── Trazabilidad ─────────────────────────────────────
  notes           String?
  photos          Json? // Array de URLs de fotos
  status          WoodEntryStatus @default(pendiente)
  validatedBy     String? // AdminUser.id que validó
  validatedAt     DateTime?
  rejectionReason String? // Si status=rechazado, razón

  // ── Auditoría ────────────────────────────────────────
  createdBy String // AdminUser.id que registró
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// En qué corridas de producción se consumió este ingreso (ADR-134 D5).
  /// La invariante I2 (Σ consumos ≤ volumeM3) impide consumirlo dos veces —
  /// el patrón de blanqueo que fiscaliza SERFOR. Se aplica en la capa DB (D7).
  consumos ForestCtpConsumo[]

  /// Lista de trozas de la GTF (ADR-312). Cada pieza con su codificación, que es
  /// lo que OSINFOR cruza contra el POA del título habilitante.
  trozas WoodEntryTroza[]

  @@index([tenantId, entryDate(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, gtfNumber])
  @@index([tenantId, speciesCommonName])
  @@index([tenantId, supplierId])
  @@index([tenantId, libroNro])
  @@index([deletedAt])
}

/// Una troza de la lista que ampara la GTF (ADR-312).
///
/// Se guarda como fila propia —no sólo dentro del JSON de la ficha— porque la
/// codificación de la troza es lo que un fiscalizador de OSINFOR cruza pieza por
/// pieza contra el POA del título habilitante. Dentro del JSON el dato existe
/// pero no se puede buscar, y una trazabilidad que no se puede consultar no
/// sirve el día de la fiscalización.
model WoodEntryTroza {
  id       String @id @default(cuid())
  tenantId String

  woodEntryId String
  entry       WoodEntry @relation(fields: [woodEntryId], references: [id], onDelete: Cascade)

  /// Orden en que la GTF lista la troza. Se conserva para poder reimprimir la
  /// lista igual que el documento.
  orden Int @default(0)

  /// El código con el que la troza salió del bosque, tal como lo publica SERFOR.
  /// Es el dato que se busca.
  codificacion String?

  /// La especie viaja EN LA TROZA, no sólo en el ingreso: si una troza no matchea
  /// con ninguna especie declarada, se engancha al primer ingreso del grupo pero
  /// conserva la suya — el dato del documento no se pierde por una heurística.
  especieComun      String?
  especieCientifica String?

  /// Dimensiones tal como las publica SERFOR ("5.00 X 0.85 X 0.80"). Texto porque
  /// el formato varía y romperlo en números perdería lo que dice el documento.
  dimensiones String?
  largoM      Decimal? @db.Decimal(8, 3)
  /// Los DOS extremos del tronco, tal como los publica SERFOR.
  ///
  /// Se guardan por separado además del promedio porque el tronco es cónico y
  /// las reglas del retrozado (ADR-313) necesitan el diámetro MAYOR: con sólo el
  /// promedio, una troza de 73→58 parecía de 65.5 cm y rechazaba cortes válidos.
  d1Cm        Decimal? @db.Decimal(8, 2)
  d2Cm        Decimal? @db.Decimal(8, 2)
  /// Promedio de los dos. Es el que se muestra y con el que se calcula Huber.
  diametroCm  Decimal? @db.Decimal(8, 2)

  cantidad  Int?
  volumenM3 Decimal? @db.Decimal(12, 4)

  // ── Recepción física en planta (ADR-325) ─────────────────────────────
  /// Parcela de corta del POA de donde salió el árbol. Es lo que OSINFOR cruza
  /// pieza por pieza contra el plan del título habilitante — sin esto, la troza
  /// es trazable hasta la guía pero no hasta el punto del bosque.
  parcela        String?
  /// El código que ESTE centro marca físicamente sobre la troza al recibirla.
  /// Distinto de `WoodEntry.ctpProductCode`, que identifica la carga entera:
  /// acá se identifica la pieza, que es lo que después se busca en el patio.
  codigoPlanta   String?
  /// La guía la declara pero no llegó al patio. NO se borra la fila: el
  /// documento dice que existe, y esconderla sería alterar el acta. El volumen
  /// que sí llegó se deriva sumando las recepcionadas.
  noRecepcionada Boolean @default(false)
  /// Cuándo bajó ESTA pieza del camión (ADR-336).
  ///
  /// El ingreso ya tiene la suya (`WoodEntry.fechaRecepcion`, ADR-335), pero una
  /// guía de sesenta trozas se descarga en dos viajes: el saldo del patio del
  /// lunes no puede incluir la madera que recién llegó el miércoles. NULL = la
  /// del ingreso.
  fechaRecepcion DateTime?
  /// Qué se observó al recibirla (o por qué no llegó).
  recepcionObs   String?

  // ── Consumo por pieza (ADR-326) ──────────────────────────────────────
  /// El LOTE DE ASERRÍO en el que se guardó esta pieza (ADR-334).
  ///
  /// El operador arma el lote en el patio —trozas de UNA especie que van juntas
  /// a la sierra— y recién después lo consume. Es el «Lote» que el LO-CTP usa
  /// como hilo entre Consumos, Producción y Salidas: sin él, esa columna era
  /// texto libre y nada garantizaba que las tres secciones hablaran del mismo.
  ///
  /// `SetNull` y no cascada: borrar un lote NO puede borrar las piezas — la
  /// madera existe aunque el lote se deshaga.
  loteAserrioId String?
  loteAserrio   ForestLoteAserrio? @relation("TrozasDelLote", fields: [loteAserrioId], references: [id], onDelete: SetNull)

  /// La corrida que se comió ESTA troza. NULL = sigue en el patio.
  ///
  /// El consumo del libro sigue siendo `ForestCtpConsumo` (ingreso → corrida en
  /// m³): ahí viven las invariantes I1-I6 y el costeo. Esto dice QUÉ PIEZAS
  /// entraron, que es lo que un fiscalizador cuenta en la pila.
  ///
  /// Es una referencia y no una tabla puente porque la relación es 1:N de
  /// verdad: una troza entra a UNA corrida. Con puente habría que prohibir por
  /// constraint que la misma pieza aparezca dos veces; así es imposible.
  consumidaEnId String?
  consumidaEn   ForestCtpEntry? @relation("TrozasConsumidas", fields: [consumidaEnId], references: [id], onDelete: SetNull)
  /// Cuándo entró a la sierra.
  fechaConsumo  DateTime?

  // ── Salida sin aserrar (ADR-363) ─────────────────────────────────────
  /// El DESPACHO que se llevó esta pieza ENTERA, sin pasar por la sierra.
  /// NULL = sigue en el patio.
  ///
  /// Espejo exacto de `consumidaEnId`, y por la misma razón: una troza sale en
  /// UN despacho, así que es una referencia y no una tabla puente. Las dos
  /// columnas son excluyentes en la práctica (T2) pero se guardan aparte porque
  /// son dos hechos distintos: una dice que se aserró, la otra que se vendió en
  /// rollo — y el libro tiene que poder decir cuál de las dos pasó.
  despachadaEnId String?
  despachadaEn   ForestCtpEntry? @relation("TrozasDespachadas", fields: [despachadaEnId], references: [id], onDelete: SetNull)
  /// Cuándo salió del patio.
  fechaDespacho  DateTime?

  // ── Retrozado (ADR-313 · Apartado 2 del formato LO-CTP) ──────────────
  /// De qué troza se cortó ésta. NULL = troza tal como llegó en la guía.
  ///
  /// Un retrozo ES una troza, con madre: por eso se modela como auto-relación y
  /// no como tabla aparte. Así el buscador por codificación, la lista del
  /// ingreso y los saldos lo encuentran sin duplicar nada.
  trozaOrigenId String?
  trozaOrigen   WoodEntryTroza?  @relation("Retrozado", fields: [trozaOrigenId], references: [id], onDelete: Cascade)
  retrozos      WoodEntryTroza[] @relation("Retrozado")

  /// Cuándo se cortó. Es una operación del patio, no del documento.
  fechaRetrozo  DateTime?
  /// El pedazo que no sirve. Ocupa volumen de la madre —por eso se registra—
  /// pero no debe contarse como producto disponible.
  descarte      Boolean   @default(false)
  observaciones String?

  createdAt DateTime @default(now())

  @@index([tenantId, woodEntryId])
  @@index([tenantId, codificacion])
  @@index([tenantId, loteAserrioId])
  /// ⚠️ En la BASE hay además un índice ÚNICO PARCIAL sobre
  /// (`tenantId`, `codigoPlanta`) WHERE codigoPlanta IS NOT NULL (migración 336).
  /// Prisma no sabe expresar índices parciales, así que vive sólo en el SQL —
  /// no lo borres creyendo que es drift. El guard app-level está en
  /// `WoodEntriesDB.create` y `actualizarRecepcion`.
  @@index([tenantId, codigoPlanta])
  @@index([tenantId, fechaRecepcion])
  @@index([tenantId, consumidaEnId])
  @@index([tenantId, despachadaEnId])
  @@index([tenantId, trozaOrigenId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Libro de Operaciones de los Títulos Habilitantes (LO-TH) — ADR-125
// Libro del titular de la concesión/permiso, EN EL BOSQUE (≠ LO-CTP de planta).
// Formato RDE N° 264-2019-MINAGRI-SERFOR-DE · 6 secciones unificadas.
// ═══════════════════════════════════════════════════════════════════════════

/// Carátula del libro (Anexo 1). Un registro por tomo / documento de gestión.
model ForestLothCaratula {
  id       String @id @default(cuid())
  tenantId String

  registroNumber     String? // N° de registro del libro (otorgado por la ARFFS)
  tomo               String? // N° de tomo (por documento de gestión)
  titularName        String // Titular del título habilitante (persona/razón social)
  representanteLegal String? // Si es persona jurídica
  tituloHabilitante  String? // N° de título habilitante (contrato/permiso/autorización)
  ruc                String?
  dni                String?
  domicilio          String?
  departamento       String?
  provincia          String?
  distrito           String?
  telefono           String?
  email              String?
  docGestionType     String? // PO | PMFI | DEMA
  docGestionName     String? // Nombre/periodo del documento de gestión
  resolucionNumber   String? // N° de resolución de aprobación
  resolucionDate     DateTime?

  isActive  Boolean   @default(true)
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, isActive])
  @@index([deletedAt])
}

/// Entrada unificada de las 6 secciones del LO-TH (discriminador `section`).
model ForestLothEntry {
  id         String  @id @default(cuid())
  tenantId   String
  caratulaId String? // libro/tomo al que pertenece (ref. app-level)
  planId     String? // Plan de Manejo de origen (ADR-127 — flujo data-driven)

  // tala | trozado | despacho_troza | consumo_troza | producto_terminado | despacho_producto
  section   String
  lineNo    Int // correlativo por sección/tomo (item N°), calculado max+1
  entryDate DateTime @default(now())

  // ── Trazabilidad por código ──────────────────────────
  treeCode     String? // Código del árbol (tala, trozado)
  trozaCode    String? // Código de troza (trozado, despacho, consumo)
  despachoCode String? // Código de despacho distinto (despacho_troza)
  isRama       Boolean @default(false) // "R" — rama aprovechable (X)

  // ── Especie ──────────────────────────────────────────
  speciesCommon     String?
  speciesScientific String?
  cites             Boolean @default(false)

  // ── Medidas dasométricas (tala, trozado) ─────────────
  diamMayorM Decimal? @db.Decimal(8, 3) // Ø sección mayor (m)
  diamMenorM Decimal? @db.Decimal(8, 3) // Ø sección menor (m)
  lengthM    Decimal? @db.Decimal(8, 2) // longitud (aprovechable) (m)
  volumeM3   Decimal? @db.Decimal(12, 4) // Smalian

  // ── Producto (producto_terminado, despacho_producto) ─
  productType String? // tipo de producto terminado (lista SERFOR)
  quantity    Decimal? @db.Decimal(14, 4)
  unit        String? // m3 | kg | unidad
  pieces      Int? // cantidad de piezas (despacho_producto)

  // ── Despacho ─────────────────────────────────────────
  gtfNumber String? // despacho_troza, despacho_producto

  // ── Georreferencia + evidencia de campo (Batch 4) ────
  gpsLat   Decimal? @db.Decimal(10, 7) // latitud captura en campo
  gpsLng   Decimal? @db.Decimal(10, 7) // longitud captura en campo
  photoUrl String? // foto-evidencia (tocón/troza) vía /api/upload

  // ── Flags + observaciones ────────────────────────────
  discarded      Boolean @default(false) // "descartado"
  consumoInterno Boolean @default(false) // "consumo interno"
  observations   String?

  // ── Subsanación SERFOR (corrección visible, no borrar) ─
  correctsLineNo Int? // esta línea corrige a la línea N
  correctionNote String?

  status         String    @default("registrado") // registrado | anulado
  annulledReason String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([tenantId, section, entryDate(sort: Desc)])
  @@index([tenantId, caratulaId, section, lineNo])
  @@index([tenantId, planId, section])
  @@index([tenantId, treeCode])
  @@index([tenantId, trozaCode])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Plan de Manejo Forestal + Censo + Especies autorizadas — ADR-126
// Base maestra que gobierna el LO-TH: el permiso aprobado, las especies y
// volúmenes autorizados, y el censo de árboles georreferenciados.
// ═══════════════════════════════════════════════════════════════════════════

/// Plan de Manejo / Permiso aprobado por la ARFFS (PMFI | PO | DEMA).
model ForestPlan {
  id         String  @id @default(cuid())
  tenantId   String
  caratulaId String? // vínculo a la carátula del libro (ref. app-level)

  planType          String    @default("PO") // PMFI | PO | DEMA
  planNumber        String?
  tituloHabilitante String?
  resolucionNumber  String?
  resolucionDate    DateTime?
  titularName       String
  arffs             String? // Autoridad Regional Forestal y de Fauna Silvestre
  region            String?
  parcelaCorta      String?
  areaHa            Decimal?  @db.Decimal(12, 2)
  uitRef            Decimal?  @db.Decimal(10, 2) // UIT vigente para cálculo de pago

  // Costeo (Batch 3 · frente D): costos operativos por m³ para calcular margen.
  costoExtraccionM3     Decimal? @db.Decimal(12, 2) // tala + arrastre + patio (S//m³)
  costoTransformacionM3 Decimal? @db.Decimal(12, 2) // aserrío / transformación (S//m³)
  costoFleteM3          Decimal? @db.Decimal(12, 2) // transporte a destino (S//m³)

  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  estado        String    @default("vigente") // vigente | vencido | cerrado | suspendido

  notes     String?
  isActive  Boolean   @default(true)
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, isActive])
  @@index([deletedAt])
}

/// Especie APROBADA en el plan, con volumen autorizado y datos comerciales.
model ForestPlanSpecies {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  speciesCommon     String
  speciesScientific String?
  cites             Boolean @default(false)
  categoria         String? // categoría SERFOR (1–4) para VEN

  volumenAutorizadoM3     Decimal  @db.Decimal(12, 4)
  arbolesAutorizados      Int?
  valorEstadoNaturalSoles Decimal? @db.Decimal(12, 2) // VEN S//m³ (pago derecho)
  precioVentaSoles        Decimal? @db.Decimal(12, 2) // precio de venta S//m³ (comercial)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, planId])
  @@index([deletedAt])
}

/// Árbol del censo forestal: georreferenciado, con volumen estimado.
model ForestCensusTree {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  treeCode          String // código único del árbol censado
  speciesCommon     String
  speciesScientific String?
  cites             Boolean @default(false)

  dapM              Decimal? @db.Decimal(8, 3) // diámetro a la altura del pecho (m)
  alturaComercialM  Decimal? @db.Decimal(8, 2) // altura comercial Hc (m)
  factorForma       Decimal? @db.Decimal(5, 3) // ff (default operativo ~0.65)
  volumenEstimadoM3 Decimal? @db.Decimal(12, 4) // 0.7854 × DAP² × Hc × ff

  utmZona      String?
  utmX         Decimal? @db.Decimal(12, 2)
  utmY         Decimal? @db.Decimal(12, 2)
  parcelaCorta String?
  calidad      String?

  estado String  @default("en_pie") // en_pie | talado | descartado
  notes  String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, planId])
  @@index([tenantId, treeCode])
  @@index([tenantId, estado])
  @@index([deletedAt])
}

/// Guía de Transporte Forestal (GTF) — ADR-126 Fase 4. Interna, no oficial.
model ForestGtf {
  id       String  @id @default(cuid())
  tenantId String
  planId   String?

  gtfNumber String
  gtfDate   DateTime?
  tipo      String    @default("trozas") // trozas | producto

  titularName       String?
  tituloHabilitante String?
  parcelaCorta      String?

  transportista     String?
  transportistaDoc  String?
  conductor         String?
  conductorLicencia String?
  placaVehiculo     String?
  origen            String?
  destino           String?

  items          Json? // lista de trozas/productos (snapshot)
  volumenTotalM3 Decimal? @db.Decimal(12, 4)
  piezasTotal    Int?
  observations   String?

  status         String    @default("emitida") // emitida | anulada
  annulledReason String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([tenantId, status])
  @@index([tenantId, gtfNumber])
  @@index([deletedAt])
}

/// Libro CTP — producción/transformación + despacho (ADR-127). Ingreso = WoodEntry.
model ForestCtpEntry {
  id       String @id @default(cuid())
  tenantId String

  section   String // produccion | despacho
  lineNo    Int
  entryDate DateTime @default(now())

  // Origen / materia prima
  gtfIngreso      String? // GTF con la que ingresó la materia prima
  materiaPrimaRef String? // referencia libre a la materia prima / lote

  speciesCommon     String?
  speciesScientific String?
  cites             Boolean @default(false)

  // Producción
  productType       String? // producto terminado
  /// "Forma de presentación" (ADR-314): PAQUETES, PIEZAS, TABLILLAS… Es lo que
  /// declara la GTF de salida; sin esto el despacho no reproduce su documento.
  /// Los reprocesos que CONSUMEN esta corrida (ADR-316) y los que la PRODUCEN.
  /// Descuentan stock igual que un despacho: el producto original deja de existir.
  reprocesosSalida  ForestCtpReproceso[] @relation("ReprocesoOrigen")
  reprocesosEntrada ForestCtpReproceso[] @relation("ReprocesoDestino")
  /// Los paquetes de producto que salieron de esta corrida (ADR-349).
  paquetes          ForestCtpPaquete[]   @relation("PaqueteDeCorrida")
  /// El código del paquete RAÍZ: sobrevive a los reprocesos encadenados, así que
  /// un tablón hecho tablillas sigue apuntando a la corrida de la que nació.
  codigoRaiz        String?

  presentacion    String?
  volumeInputM3   Decimal? @db.Decimal(12, 4) // materia prima consumida
  rendimientoPct  Decimal? @db.Decimal(5, 2) // output/input %
  /// Casillero 7 del Cuadro Resumen 3 del LO-CTP: LP = línea principal ·
  /// LRE = línea de recuperación (la que aprovecha los residuos). El balance
  /// oficial se presenta por lote Y por línea, así que sin esto la producción de
  /// la línea de recuperación no se puede declarar aparte (ADR-311).
  lineaProduccion String?  @default("LP")

  // Cantidad producida / despachada
  quantity Decimal? @db.Decimal(14, 4)
  unit     String? // m3 | kg | unidad | pt
  pieces   Int?

  // Despacho
  /// (3) "Tipo de documento" con el que sale el producto: GTF | GRR (ADR-311).
  docType              String?
  gtfNumber            String? // (4) "N° de documento" — GTF de salida del producto
  /// N° de constancia del SNIFFS de la GTF de salida, cuando se verificó contra
  /// la base de SERFOR (ADR-312). Que la salida esté amparada por una guía que
  /// existe y está vigente es lo primero que revisa una fiscalización; sin este
  /// dato la verificación se hacía y se perdía.
  serforNumeroRegistro String?
  /// Cuándo se verificó. Una guía activa hoy puede estar anulada mañana: sin la
  /// fecha, el sello no dice nada.
  serforVerificadoEn   DateTime?
  /// (9) "Código del producto" de la Sección 4: opcional en general, OBLIGATORIO
  /// para trozas y para lo que no se produjo en este centro.
  codigoProducto       String?
  destino              String?
  /// Cuerpo de la Guía de Transporte Forestal de salida: propietario del producto,
  /// destinatario, transportista/vehículo/conductor, títulos habilitantes y datos
  /// del traslado (RDE 122-2015-SERFOR-DE · RDE D000014-2024-MIDAGRI-SERFOR-DE).
  /// JSONB y no 15 columnas: es el cuerpo de un documento que se llena una vez y
  /// se imprime, no algo que se consulte por campo. La forma la valida Zod en
  /// `lib/forestal/ctp-gtf-datos.ts`.
  gtfDatos             Json?

  observations   String?
  status         String    @default("registrado") // registrado | anulado
  annulledReason String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  /// Aserrío / secado / mano de obra (ADR-134). Input genuino: sin esto no hay margen.
  /// costoMateriaPrima y costoTotal NO se almacenan — son derivados de `consumos` (D6).
  costoProceso Decimal? @db.Decimal(12, 2)
  moneda       String?  @default("PEN")

  /// Valor de VENTA del despacho (P&L, ADR-141). Solo aplica a section=despacho.
  /// Sin esto no hay margen: null ⇒ margen desconocido, NUNCA 0 (regla de oro).
  valorVenta Decimal? @db.Decimal(14, 2)

  /// Qué ingresos (y cuántos m³ de cada uno) alimentaron esta corrida (ADR-134 D5).
  consumos ForestCtpConsumo[]

  /// Qué PIEZAS entraron a la sierra en esta corrida (ADR-326). El volumen sigue
  /// viviendo en `consumos`; esto dice cuáles fueron, que es lo que se cuenta.
  trozasConsumidas WoodEntryTroza[] @relation("TrozasConsumidas")

  /// Las piezas que salieron SIN ASERRAR en esta línea de despacho (ADR-363).
  /// Es la cadena de custodia de una venta en rollo: el origen es el ingreso de
  /// cada troza, no una corrida de producción.
  trozasDespachadas WoodEntryTroza[] @relation("TrozasDespachadas")

  /// Dos back-relations porque la misma tabla es despacho en una punta de
  /// ForestCtpDespachoOrigen y corrida de producción en la otra (ADR-135).
  /// `origenes`  → si esta línea es un DESPACHO: de qué corridas salió.
  /// `salidas`   → si esta línea es una CORRIDA: en qué despachos se fue.
  origenes ForestCtpDespachoOrigen[] @relation("DespachoOrigenDespacho")
  salidas  ForestCtpDespachoOrigen[] @relation("DespachoOrigenProduccion")

  /// En qué lotes comerciales se empaquetó esta corrida (ADR-136).
  /// Invariante L1 (Σ miembros ≤ quantity) impide empaquetar más de lo producido.
  loteMiembros ForestProdLoteMiembro[] @relation("LoteMiembroProduccion")

  @@index([tenantId, section, entryDate(sort: Desc)])
  @@index([tenantId, gtfNumber])
  @@index([deletedAt])
}

/// ForestCtpDespachoOrigen — puente N:M entre una línea de DESPACHO y las
/// corridas de producción de las que salió el producto (ADR-135).
///
/// Cierra el último tramo de la cadena de custodia: con ForestCtpConsumo
/// (ingreso→producción) más esta tabla se puede responder de punta a punta
/// "¿de qué árbol salió esta tabla que despaché?" — lo que exige EUDR.
/// Un despacho real saca producto de varias corridas, y una corrida alimenta
/// varios despachos.
/// Reproceso: un producto ya terminado que vuelve a la sierra (ADR-316).
///
/// Una tabla que se re-asierra en tablillas, un cuartón que se parte. El
/// producto original **deja de existir como tal**, así que el puente descuenta
/// stock igual que un despacho — a diferencia del lote, que sólo agrupa.
///
/// Espeja a `ForestCtpDespachoOrigen`: mismo patrón, misma precisión, mismo
/// LOCK sobre la corrida de origen dentro de la transacción.
model ForestCtpReproceso {
  id       String @id @default(cuid())
  tenantId String // denormalizado — regla 3 + detección de fuga (ADR-134 D3)

  /// La corrida cuyo producto entra a la sierra otra vez.
  origenEntryId  String
  origen         ForestCtpEntry @relation("ReprocesoOrigen", fields: [origenEntryId], references: [id], onDelete: Restrict)
  /// La corrida nueva que sale del reproceso.
  destinoEntryId String
  destino        ForestCtpEntry @relation("ReprocesoDestino", fields: [destinoEntryId], references: [id], onDelete: Cascade)

  /// Hecho físico: cuánto de ESA corrida entró a ESE reproceso. NOT NULL, > 0.
  /// Decimal(14,4) — la precisión la copia de la columna que la ACOTA
  /// (ForestCtpEntry.quantity), igual que ForestCtpDespachoOrigen.
  quantity Decimal @db.Decimal(14, 4)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([destinoEntryId, origenEntryId]) // una corrida 1 vez por reproceso: se suma, no se duplica
  @@index([destinoEntryId])
  @@index([tenantId, origenEntryId])
}

/// Un PAQUETE de producto terminado (ADR-349).
///
/// El formato de producción del SNIFFS no declara "3.5 m³ de tablones": declara
/// paquetes, cada uno con su código, su producto, su presentación y —cuando se
/// dimensiona— espesor, ancho y largo. Ese código es el que después viaja en la
/// GTF de salida y el que un fiscalizador busca en la pila.
///
/// El volumen de la corrida (`ForestCtpEntry.quantity`) sigue siendo la única
/// cantidad que cuentan las invariantes: estos paquetes son su DETALLE, y su
/// suma tiene que dar ese total. Lo disponible se sigue leyendo del saldo de la
/// corrida (ADR-316) — no hay una segunda contabilidad por paquete.
model ForestCtpPaquete {
  id       String @id @default(cuid())
  tenantId String // denormalizado — regla 3 + detección de fuga (ADR-134 D3)

  /// La corrida de producción que lo produjo.
  ctpEntryId String
  entry      ForestCtpEntry @relation("PaqueteDeCorrida", fields: [ctpEntryId], references: [id], onDelete: Cascade)

  /// "Código Paquete" del formato: lo escribe el aserradero y va en la etiqueta.
  codigo       String
  productType  String? // producto terminado (madera aserrada, tablillas…)
  presentacion String? // PAQUETES | PIEZAS | TABLILLAS…
  /// Piezas del paquete. NOT NULL: un paquete sin piezas no es un paquete.
  cantidad     Int
  unit         String  @default("m3")
  /// Volumen del paquete. La suma de los paquetes es la cantidad de la corrida.
  volumenM3    Decimal @db.Decimal(14, 4)

  /// Dimensiones de la pieza tipo del paquete, cuando se dimensiona. Van en
  /// cm/m como las canta el aserradero y como las imprime la lista.
  espesorCm Decimal? @db.Decimal(8, 2)
  anchoCm   Decimal? @db.Decimal(8, 2)
  largoM    Decimal? @db.Decimal(8, 2)

  observations String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// El código de paquete no se repite en la planta: es lo que se busca en la
  /// pila y lo que se cita en la guía de salida.
  @@unique([tenantId, codigo])
  @@index([tenantId, ctpEntryId])
}

model ForestCtpDespachoOrigen {
  id       String @id @default(cuid())
  tenantId String // denormalizado — regla 3 + detección de fuga (ADR-134 D3)

  despachoEntryId   String
  despacho          ForestCtpEntry @relation("DespachoOrigenDespacho", fields: [despachoEntryId], references: [id], onDelete: Cascade)
  produccionEntryId String
  produccion        ForestCtpEntry @relation("DespachoOrigenProduccion", fields: [produccionEntryId], references: [id], onDelete: Restrict)

  /// Hecho físico: cuánto de ESA corrida salió en ESE despacho. NOT NULL, > 0.
  /// Decimal(14,4) — la precisión se copia de la columna que la ACOTA
  /// (ForestCtpEntry.quantity), no de la tabla que se parece (ForestCtpConsumo
  /// es 12,4 porque espeja WoodEntry.volumeM3). Con 12,4 una atribución no
  /// podría representar la cantidad de la línea que la contiene.
  quantity Decimal @db.Decimal(14, 4)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([despachoEntryId, produccionEntryId]) // una corrida 1 vez por despacho: se suma, no se duplica
  @@index([despachoEntryId])
  @@index([tenantId, produccionEntryId])
}

/// ForestCtpConsumo — puente N:M entre una línea del libro CTP y los ingresos de
/// materia prima que consumió (ADR-134 D5). Una corrida real mezcla varias guías,
/// y un ingreso puede alimentar varias corridas.
///
/// Sin soft-delete: el consumo es detalle editable, no acta. Mientras la línea no
/// esté congelada, quitar una atribución equivocada es corregir, no borrar historia.
/// El acta (`volumeInputM3`, `gtfIngreso`) nunca se toca. Congelado ⇒ inmutable.
model ForestCtpConsumo {
  id       String @id @default(cuid())
  tenantId String // denormalizado — regla 3 + detección de fuga (D3)

  ctpEntryId  String
  ctpEntry    ForestCtpEntry @relation(fields: [ctpEntryId], references: [id], onDelete: Cascade)
  woodEntryId String
  woodEntry   WoodEntry      @relation(fields: [woodEntryId], references: [id], onDelete: Restrict)

  /// Hecho físico: m³ de ESE ingreso que entraron en ESA corrida. NOT NULL, > 0.
  volumeM3 Decimal @db.Decimal(12, 4) // 4 dec = precisión forestal

  /// NULL = costo vivo (on-read). NOT NULL = congelado al cierre del período (D6).
  costoUnitarioSnap Decimal?  @db.Decimal(12, 2)
  congeladoAt       DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ctpEntryId, woodEntryId]) // un ingreso aparece 1 vez por línea: se suma, no se duplica
  @@index([ctpEntryId])
  @@index([tenantId, woodEntryId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Lotes de producción / comercialización forestal (ADR-136)
// Capa COMERCIAL sobre el CTP: agrupa corridas de producción ya hechas en un
// lote con código, grado de calidad y estado — la unidad que un comprador o
// exportador referencia. Hereda la cadena de custodia de sus corridas (cada
// corrida → sus guías de ingreso vía ForestCtpConsumo), así que un lote puede
// certificar su origen igual que un despacho.
//
// Frontera con el despacho (v1): el lote es organizativo/comercial; NO es un
// segundo sistema de stock que compita con ForestCtpDespachoOrigen. La única
// invariante es L1 (mirror de I5): Σ miembros(corrida) ≤ corrida.quantity — no
// se puede empaquetar más de lo que una corrida produjo. El "disponible para
// lote" descuenta lo ya puesto en OTROS lotes (no en despachos) — despacho por
// lote es un follow-up que unificaría ambos reclamos.
// ═══════════════════════════════════════════════════════════════════════════

/// Lote comercial de producto forestal terminado.
/// Lote de ASERRÍO (ADR-334): las trozas de una misma especie que van juntas a
/// la sierra.
///
/// No confundir con `ForestProdLote`, que es el lote COMERCIAL: ése agrupa
/// producción ya terminada para venderla. Éste es el de materia prima y vive
/// antes: se arma en el patio eligiendo piezas, se consume entero y de él salen
/// las corridas. Es el «Lote» de las columnas del LO-CTP.
model ForestLoteAserrio {
  id       String @id @default(cuid())
  tenantId String

  /// Correlativo legible: LA-2026-001. Único por tenant.
  code String

  /// UNA especie por lote: es la regla del aserradero (la sierra se calibra por
  /// especie) y lo que permite que la corrida declare su especie sin ambigüedad.
  speciesCommon     String
  speciesScientific String?

  /// abierto = se le pueden agregar o sacar piezas
  /// consumido = ya entró a la sierra (sus trozas están marcadas consumidas)
  /// cerrado = no se toca más (se produjo y despachó)
  status String @default("abierto")

  notes String?

  /// Los campos con los que el SNIFFS programa una producción (ADR-342): el
  /// lote se DECLARA antes de cargarlo, y las piezas se eligen después en
  /// Consumos filtradas por esta especie y este tipo de producto.
  ///
  /// N° de orden de producción del centro (texto libre: cada planta numera a su
  /// manera y el formulario oficial lo acepta así).
  ordenProduccion      String?
  /// Qué materia prima se va a consumir: rolliza, aserrada, tablones…
  tipoProductoConsumir String?
  /// La ventana del proceso — distinta de `fechaApertura` (cuándo se creó el
  /// registro) y de `fechaConsumo` (cuándo entró de verdad a la sierra).
  inicioProceso        DateTime?
  finProceso           DateTime?

  fechaApertura DateTime  @default(now())
  /// Cuándo entró a la sierra. NULL mientras está abierto.
  fechaConsumo  DateTime?

  /// La corrida que se hizo con este lote, cuando ya se produjo.
  produccionEntryId String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trozas WoodEntryTroza[] @relation("TrozasDelLote")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, speciesCommon])
  @@index([tenantId, ordenProduccion])
}

model ForestProdLote {
  id       String @id @default(cuid())
  tenantId String

  /// Correlativo legible por tenant: L-2026-001. Único por tenant.
  loteCode String

  productType       String? // producto terminado (Madera aserrada, etc.)
  speciesCommon     String?
  speciesScientific String?
  cites             Boolean @default(false)
  unit              String  @default("m3") // m3 | kg | pt | unidad

  /// Grado de calidad comercial (A/B/C/Exportación) — libre, opcional.
  grade   String?
  /// Comprador o destino comercial del lote.
  destino String?

  // ── Ventana de trabajo y dueño de la madera (ADR-327) ────────────────
  /// Cuándo la planta empieza y termina de trabajar este lote. Es otro eje que
  /// el `status` comercial: un lote puede estar abierto para agregar corridas y
  /// operativamente terminado, o programado para la semana que viene.
  fechaInicio DateTime?
  fechaFin    DateTime?

  /// De QUIÉN es la madera. En un aserradero que presta servicio de maquila el
  /// lote no es del centro: es del cliente que trajo la troza, y el certificado
  /// tiene que decirlo.
  titularId     String?
  titular       ForestParty? @relation("LotesDelTitular", fields: [titularId], references: [id], onDelete: SetNull)
  /// El nombre tal como se certificó. Se guarda ADEMÁS del id porque es acta: si
  /// mañana se corrige la ficha del directorio, lo ya emitido no cambia.
  titularNombre String?

  /// abierto = admite miembros · cerrado = congelado para comercializar ·
  /// despachado = ya salió · anulado = soft-cancel con motivo (no se borra).
  status         String    @default("abierto")
  annulledReason String?
  notes          String?
  closedAt       DateTime?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  miembros ForestProdLoteMiembro[]

  @@unique([tenantId, loteCode])
  @@index([tenantId, titularId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt(sort: Desc)])
}

/// Puente N:M lote ↔ corrida de producción. Cuánto de ESA corrida entró en ESE
/// lote. La invariante L1 (Σ miembros por corrida ≤ corrida.quantity) se valida
/// app-level con lock sobre la corrida (el recurso disputado), igual que I5.
model ForestProdLoteMiembro {
  id       String @id @default(cuid())
  tenantId String // denormalizado — regla 3 + detección de fuga

  loteId String
  lote   ForestProdLote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  produccionEntryId String
  produccion        ForestCtpEntry @relation("LoteMiembroProduccion", fields: [produccionEntryId], references: [id], onDelete: Restrict)

  /// Cantidad de la corrida empaquetada en el lote. NOT NULL, > 0.
  /// Decimal(14,4) = la precisión de ForestCtpEntry.quantity que la acota.
  quantity Decimal @db.Decimal(14, 4)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loteId, produccionEntryId]) // una corrida 1 vez por lote: se suma, no se duplica
  @@index([loteId])
  @@index([tenantId, produccionEntryId])
}

/// Directorio forestal (ADR-317) — las personas y empresas que intervienen en el
/// movimiento de la madera: proveedores (traen la materia prima), destinatarios
/// (reciben el despacho), transportistas y conductores.
///
/// Hasta acá cada guía re-tipeaba los mismos 20 campos y el proveedor vivía como
/// `WoodEntry.providerName` (texto libre): el mismo aserradero entraba escrito de
/// cinco formas y no había manera de cruzarlo. Un fiscalizador que pide "todo lo
/// que le compraste a X" necesita que X sea UNA fila, no cinco strings.
model ForestParty {
  id       String @id @default(cuid())
  tenantId String

  /// Qué papeles cumple: proveedor · destinatario · transportista · conductor.
  /// Array y no una columna: la misma empresa suele ser proveedor Y destinatario,
  /// y el dueño-chofer es transportista Y conductor. Forzar una fila por rol
  /// duplicaría el mismo RUC.
  roles String[]

  nombre    String
  docTipo   String? // RUC | DNI | CE | PASAPORTE
  docNumero String?
  direccion String?
  region    String?
  provincia String?
  distrito  String?
  /// Sector o caserío del formato oficial (ADR-373). En la selva identifica el
  /// punto de llegada cuando la dirección no tiene numeración, y es lo que
  /// cotejan los puestos de control.
  zona      String?
  ubigeo    String?
  telefono  String?
  email     String?

  /// Registro del MTC — sólo aplica al transportista que es empresa.
  registroMtc       String?
  /// Licencia de conducir — sólo aplica al conductor. Es lo que pide el control.
  licencia          String?
  /// Título habilitante con el que el proveedor extrae (permiso, concesión…).
  tituloHabilitante String?
  /// Resolución que aprueba el plan de manejo — casillero (8) de la GTF.
  resolucion        String?
  /// Tipo de plan de manejo declarado — casillero (9).
  planManejo        String?
  /// ARFFS competente del titular — casillero (2).
  arffs             String?
  /// Representante legal, el que firma. Cuelga del (7) en el formato.
  representante     String?
  notas             String?

  /// Logo del titular como data URL (PNG/JPG chico, ver `LOGO_MAX_BYTES`).
  ///
  /// Data URL y no una URL del storage a propósito: el PDF de la guía se arma
  /// fotografiando la hoja en el navegador, y una imagen remota sin CORS
  /// ensucia el canvas y sale en blanco. Embebida, el logo viaja con el
  /// documento y funciona igual en pantalla, en el PDF y sin señal.
  logo              String?

  /// Papeles del titular guardados en el Drive: [{ documentId, rotulo }].
  /// Es una lista de PUNTEROS — el archivo vive en el Drive con su versionado,
  /// acá sólo queda de qué titular es.
  adjuntos          Json?

  activo Boolean @default(true)

  /// Ranking de uso: la libreta se ordena por lo que se usa, no alfabéticamente.
  /// Es un contador de conveniencia, no un dato de compliance.
  usos      Int       @default(0)
  ultimoUso DateTime?

  vehiculos ForestVehiculo[]

  /// Los lotes cuya madera es de este titular (ADR-327) — el caso del aserradero
  /// que asierra por encargo.
  lotesComoTitular ForestProdLote[] @relation("LotesDelTitular")

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// El documento identifica a la parte: dos filas con el mismo RUC son la misma
  /// empresa escrita dos veces. Postgres trata los NULL como distintos, así que
  /// las partes sin documento (existen: un comprador informal) no chocan entre sí.
  @@unique([tenantId, docTipo, docNumero])
  @@index([tenantId, activo])
  @@index([tenantId, nombre])
  @@index([deletedAt])
}

/// Vehículo del directorio forestal (ADR-317). La PLACA es lo primero que compara
/// un puesto de control contra la guía, así que es la clave natural del tenant.
model ForestVehiculo {
  id       String @id @default(cuid())
  tenantId String

  placa         String
  /// Chapa del acoplado (ADR-373). Va aparte de `placa` porque son dos
  /// unidades y la guía declara las dos: un camión que siempre lleva el mismo
  /// remolque obligaba a re-tipearlo en cada guía.
  placaRemolque String?
  marca         String?
  tipo          String? // camión, tráiler, camioneta…
  /// Configuración vehicular del MTC (T3S3, C2…). Va en la guía cuando se declara.
  configuracion String?
  capacidadM3   Decimal? @db.Decimal(10, 3)

  /// De quién es el vehículo. SetNull: si se borra el transportista, la placa
  /// sigue existiendo — el vehículo viajó y las guías emitidas lo nombran.
  transportistaId String?
  transportista   ForestParty? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)

  notas  String?
  activo Boolean @default(true)

  usos      Int       @default(0)
  ultimoUso DateTime?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, placa])
  @@index([tenantId, activo])
  @@index([deletedAt])

  fletes ForestFlete[]
}

/// Flete forestal (ADR-318) — el viaje que trae la madera al CTP o se lleva el
/// producto.
///
/// En un aserradero de selva el transporte es el segundo costo después de la
/// madera, y hasta acá no se anotaba en ningún lado: quedaba en un cuaderno o en
/// la cabeza del dueño. Sin él, "cuánto me costó puesta en planta" no se puede
/// responder, y "a qué transportista le debo" tampoco.
///
/// **No toca el costeo del libro.** `WoodEntry.costoTotal` sigue siendo el costo
/// de la materia prima (ADR-134) y el margen se calcula igual que antes. Imputar
/// el flete al costo puesto en planta es un paso posterior y explícito.
model ForestFlete {
  id       String @id @default(cuid())
  tenantId String

  fecha DateTime
  /// `ingreso` (trajo materia prima) | `despacho` (se llevó producto).
  tipo  String   @default("ingreso")

  /// La guía que amparó el viaje: es el vínculo con el libro. Texto y no FK
  /// porque la GTF de ingreso vive como número en `WoodEntry.gtfNumber`.
  gtfNumber String?

  vehiculoId String?
  vehiculo   ForestVehiculo? @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  /// Snapshot de la placa: el vehículo puede darse de baja, pero la placa que
  /// viajó ese día no cambia nunca.
  placa      String?

  /// Quién transportó y quién manejó — del directorio (ADR-317).
  transportistaId     String?
  transportistaNombre String?
  conductorId         String?

  /// De quién era la carga. Sirve para saber qué fletes se le descuentan.
  proveedorId     String?
  proveedorNombre String?

  /// m³ que se movieron en el viaje.
  volumenM3 Decimal? @db.Decimal(12, 4)
  /// S/ del flete. NULL = todavía no se sabe — nunca 0, que fingiría gratis.
  monto     Decimal? @db.Decimal(12, 2)
  moneda    String?  @default("PEN")

  /// Quién lo paga: `ctp` | `proveedor` (se descuenta de su liquidación) | `destinatario`.
  pagaQuien  String    @default("ctp")
  /// `pendiente` | `pagado`.
  estadoPago String    @default("pendiente")
  fechaPago  DateTime?

  notas     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, fecha(sort: Desc)])
  @@index([tenantId, estadoPago])
  @@index([tenantId, gtfNumber])
  @@index([deletedAt])
}

/// Movimiento de cuenta corriente con una parte del directorio (ADR-322).
///
/// El aserradero no cierra cada trato al contado: le adelanta plata a un titular
/// contra la madera que va a traer, le presta aserrío a otro, le descuenta el
/// flete que pagó por él. Todo eso vivía en un cuaderno, y al liquidar nadie
/// coincidía en el número.
///
/// **Un movimiento, no un saldo.** El saldo se deriva sumando: guardar un
/// `saldo` mutable crea dos verdades y la primera corrección lo desincroniza.
/// Es la misma razón por la que los saldos del libro se derivan de ingresos y
/// consumos en vez de tener un contador propio.
model ForestCuentaMov {
  id       String @id @default(cuid())
  tenantId String

  /// Con quién es la cuenta. Snapshot del nombre además del id: la parte puede
  /// darse de baja y el movimiento de marzo sigue siendo con ese nombre.
  parteId     String
  parteNombre String

  fecha DateTime

  /// `cargo` = le debe al CTP (adelanto entregado, flete pagado por él,
  /// aserrío prestado). `abono` = el CTP le debe o él pagó (madera recibida,
  /// pago recibido). El saldo positivo significa que la parte debe.
  tipo String

  /// Qué originó el movimiento: adelanto · flete · aserrio_prestado ·
  /// aserrio_recibido · pago · madera · otro.
  concepto String

  monto  Decimal @db.Decimal(12, 2)
  moneda String? @default("PEN")

  /// De dónde salió: id del flete, N° de guía, N° de recibo. Lo que permite
  /// volver al documento en vez de creerle al número.
  referencia String?
  /// Si nació de un flete, su id — evita cargarlo dos veces.
  fleteId    String?

  notas     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, parteId, fecha(sort: Desc)])
  @@index([tenantId, fecha(sort: Desc)])
  @@unique([tenantId, fleteId])
  @@index([deletedAt])
}

// ─── Especialización AGRÍCOLA · Cacao (ADR-128) ────────────────────────────────
// Acopio & beneficio de cacao en grano. Alineado a NTP 208.040 (cosecha/beneficio),
// NTP-ISO 2451 (clasificación por defectos), NTP-ISO 1114 (prueba de corte),
// NTP-ISO 2291 (humedad). Spec: spec:agricola:cacao-acopio.

/// Productor de cacao (master). Base para trazabilidad y liquidación.
model CacaoProducer {
  id            String    @id @default(cuid())
  tenantId      String
  codigo        String? // P-001 (correlativo legible)
  nombre        String
  dni           String?
  sector        String? // caserío / sector / comunidad
  parcelaHa     Decimal?  @db.Decimal(10, 2) // hectáreas de cacao
  variedad      String? // CCN-51 | criollo | trinitario | forastero | nacional
  certificacion String? // organico | comercio_justo | convencional
  altitudMsnm   Int?
  latitud       Decimal?  @db.Decimal(10, 7) // ubicación de la parcela (mapa/trazabilidad)
  longitud      Decimal?  @db.Decimal(10, 7)
  telefono      String?
  observaciones String?
  status        String    @default("activo") // activo | inactivo
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, status])
  @@index([tenantId, nombre])
  @@index([deletedAt])
}

/// Sección / cuartel del campo de cacao — la "maqueta" de la chacra en grilla.
/// Cada sección (p. ej. una hectárea) tiene su código y posición en el tablero;
/// las labores (poda, fertilización, cosecha…) se registran contra ella para ver
/// en el mapa qué se hizo y qué falta. Ref. app-level (sin FK), como CacaoLote.
model CacaoParcela {
  id            String    @id @default(cuid())
  tenantId      String
  codigo        String // A-01 (único por tenant)
  nombre        String? // alias opcional
  areaHa        Decimal?  @db.Decimal(8, 2)
  variedad      String? // CCN-51 | criollo | trinitario | forastero | nacional
  anioSiembra   Int?
  nPlantas      Int?
  gridRow       Int       @default(0) // posición en la grilla (maqueta)
  gridCol       Int       @default(0)
  latitud       Decimal?  @db.Decimal(10, 7) // centro de la parcela (marcador)
  longitud      Decimal?  @db.Decimal(10, 7)
  poligono      String? // contorno dibujado en el mapa: JSON [[lat,lng],…]
  color         String? // color opcional del bloque en la grilla
  status        String    @default("activa") // activa | inactiva
  observaciones String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, codigo])
  @@index([tenantId, status])
  @@index([deletedAt])
}

/// Labor agrícola (poda, fertilización, deshierbe, control fitosanitario, riego,
/// cosecha) planificada o realizada en una sección. Estado + fechas para ver en
/// la grilla qué está al día, pendiente o vencido.
model CacaoParcelaLabor {
  id             String    @id @default(cuid())
  tenantId       String
  parcelaId      String // ref. app-level a CacaoParcela
  tipo           String // poda | fertilizacion | deshierbe | fitosanitario | riego | cosecha
  estado         String    @default("pendiente") // pendiente | hecho
  fechaPlan      DateTime? // planificada / programada
  fechaHecho     DateTime? // realizada
  responsable    String?
  detalle        String?
  cantidad       Decimal?  @db.Decimal(12, 2) // ej. kg cosechados, litros aplicados, jornales
  unidad         String? // kg | L | jornal | sacos
  insumo         String? // producto aplicado (fertilizante, fungicida, etc.)
  dosis          String? // ej. "2 kg/ha", "1 L/200L agua"
  costo          Decimal?  @db.Decimal(12, 2) // costo de la labor (mano de obra + insumo) → Finanzas
  recurrenteDias Int? // si se setea, al marcarla hecha se agenda la próxima a +N días
  loteId         String? // si es cosecha enviada a Acopio, el CacaoLote generado (evita doble envío)
  gastoId        String? // si tiene costo y está hecha, el Expense posteado en Finanzas (sync)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([tenantId, tipo])
  @@index([parcelaId, estado])
  @@index([deletedAt])
}

/// Monitoreo fitosanitario del campo (migración 309): focos de plaga/enfermedad
/// (monilia, escoba de bruja, phytophthora…) por sección, con severidad,
/// incidencia %, tratamiento y estado (activo → controlado → resuelto).
model CacaoSanidad {
  id            String    @id @default(cuid())
  tenantId      String
  parcelaId     String // ref. app-level a CacaoParcela
  plaga         String // monilia | escoba_bruja | phytophthora | mazorquero | chinche | otros
  severidad     String    @default("media") // baja | media | alta
  incidenciaPct Decimal?  @db.Decimal(5, 2) // % de mazorcas/plantas afectadas
  fecha         DateTime  @default(now())
  tratamiento   String? // qué se aplicó / plan de control
  responsable   String?
  notas         String?
  estado        String    @default("activo") // activo | controlado | resuelto
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, estado])
  @@index([parcelaId, estado])
  @@index([deletedAt])
}

/// Lote de acopio de cacao + control de calidad (prueba de corte) + liquidación.
model CacaoLote {
  id              String   @id @default(cuid())
  tenantId        String
  loteCode        String // L-2026-001
  productorId     String? // ref. app-level a CacaoProducer
  productorNombre String? // snapshot del nombre al momento del acopio
  parcelaId       String? // origen: sección del campo (trazabilidad Cosecha→Acopio)
  parcelaCodigo   String? // snapshot del código de la sección de origen
  fecha           DateTime @default(now())

  variedad   String?
  tipoGrano  String   @default("seco") // humedo | seco
  pesoKg     Decimal  @db.Decimal(12, 2)
  humedadPct Decimal? @db.Decimal(5, 2) // NTP-ISO 2291; meta ≤ 7%

  // Liquidación al productor
  precioPorKg Decimal? @db.Decimal(10, 2)
  premioPorKg Decimal? @db.Decimal(10, 2) // premio por calidad / fino de aroma
  totalPagado Decimal? @db.Decimal(14, 2) // monto DEBIDO al productor: (precio + premio) × pesoKg

  // Seguimiento de pago al productor (anticipo/saldo). totalPagado = lo debido;
  // montoPagado = lo efectivamente abonado; saldo = debido − pagado (computado).
  montoPagado Decimal? @db.Decimal(14, 2) // soles pagados al productor (adelanto + abonos)
  estadoPago  String   @default("pendiente") // pendiente | parcial | pagado

  // Prueba de corte (NTP-ISO 1114) — % sobre granos evaluados
  cutGranos          Int? // n° de granos evaluados
  pctBienFermentado  Decimal? @db.Decimal(5, 2) // marrón
  pctVioleta         Decimal? @db.Decimal(5, 2) // parcialmente fermentado
  pctPizarroso       Decimal? @db.Decimal(5, 2) // slaty / no fermentado
  pctMohoso          Decimal? @db.Decimal(5, 2) // moldy
  granosPor100g      Int?
  pctCascara         Decimal? @db.Decimal(5, 2)
  pctImpurezas       Decimal? @db.Decimal(5, 2)
  indiceFermentacion Decimal? @db.Decimal(5, 2) // computado
  grado              String? // computado: I | II | fuera_norma

  destino        String?
  observaciones  String?
  status         String    @default("registrado") // registrado | anulado
  annulledReason String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([tenantId, fecha(sort: Desc)])
  @@index([tenantId, productorId])
  @@index([tenantId, loteCode])
  @@index([deletedAt])
}

/// Beneficio (post-cosecha) de un lote: fermentación + secado (ADR-128 v2).
/// Determinante de la calidad/fino de aroma. NTP 208.040 buenas prácticas.
model CacaoBeneficio {
  id       String  @id @default(cuid())
  tenantId String
  loteId   String? // ref. app-level a CacaoLote
  loteCode String? // snapshot

  // Fermentación
  fermInicio      DateTime?
  fermDias        Int? // días en fermentación (típico 5-7)
  fermVolteos     Int? // n° de volteos
  fermTempMaxC    Decimal?  @db.Decimal(5, 2) // temperatura máxima alcanzada
  tipoFermentador String? // cajon | saco | monton | tina

  // Secado
  secInicio      DateTime?
  secDias        Int?
  metodoSecado   String? // solar | tunel | mecanico
  humedadInicial Decimal?  @db.Decimal(5, 2)
  humedadFinal   Decimal?  @db.Decimal(5, 2) // meta ≤ 7% (NTP 208.040)

  // Rendimiento (merma húmedo→seco, típico ~60%)
  pesoHumedoKg Decimal? @db.Decimal(12, 2)
  pesoSecoKg   Decimal? @db.Decimal(12, 2)
  mermaPct     Decimal? @db.Decimal(5, 2) // computado

  estado        String    @default("fermentando") // fermentando | secando | terminado
  observaciones String?
  status        String    @default("registrado") // registrado | anulado
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, estado])
  @@index([tenantId, loteId])
  @@index([deletedAt])
}

/// Venta de cacao seco (ADR-128 v3). Descuenta del inventario disponible.
/// Soporta venta local (PEN) y exportación FOB (USD + tipo de cambio).
model CacaoVenta {
  id              String    @id @default(cuid())
  tenantId        String
  ventaCode       String // V-2026-001 (correlativo)
  fecha           DateTime  @default(now())
  compradorNombre String?
  canal           String? // cooperativa | exportador | mercado_local | otro
  // Trazabilidad: lote(s) de origen de este cacao vendido (app-level, ADR-128 v4).
  loteId          String? // ref. app-level a CacaoLote (lote principal)
  loteCode        String? // snapshot del código de lote
  pesoKg          Decimal   @db.Decimal(12, 2) // kg seco vendido
  moneda          String    @default("PEN") // PEN | USD
  precioPorKg     Decimal?  @db.Decimal(10, 2) // en `moneda`
  tipoCambio      Decimal?  @db.Decimal(8, 4) // USD→PEN si moneda=USD
  totalPen        Decimal?  @db.Decimal(14, 2) // computado en soles
  // Seguimiento de pago (anticipo/saldo, ADR-128 v4)
  montoCobrado    Decimal?  @db.Decimal(14, 2) // soles cobrados hasta ahora (anticipo + abonos)
  estadoPago      String    @default("pendiente") // pendiente | parcial | pagado
  esFob           Boolean   @default(false) // exportación FOB
  variedad        String?
  grado           String?
  observaciones   String?
  status          String    @default("registrado") // registrado | anulado
  annulledReason  String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([tenantId, fecha(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, loteId])
  @@index([deletedAt])
}

/// Ajuste manual de inventario de cacao seco (ADR-128 v4): mermas físicas,
/// muestras, pérdidas o correcciones. Impacta el stock disponible en inventory().
/// `cantidadKg` siempre positivo; el signo lo determina `tipo`.
model CacaoAjusteInventario {
  id            String    @id @default(cuid())
  tenantId      String
  fecha         DateTime  @default(now())
  tipo          String // merma | muestra | perdida | ajuste_pos | ajuste_neg
  cantidadKg    Decimal   @db.Decimal(12, 2)
  variedad      String?
  grado         String?
  motivo        String
  observaciones String?
  status        String    @default("registrado") // registrado | anulado
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, fecha(sort: Desc)])
  @@index([deletedAt])
}

/// Bitácora diaria de fermentación de un beneficio (ADR-128 v4): temperatura,
/// volteo y (opcional) pH de la masa por día. Permite el control fino que pide
/// la NTP 208.040 más allá de los agregados guardados en CacaoBeneficio.
model CacaoFermentacionRegistro {
  id          String   @id @default(cuid())
  tenantId    String
  beneficioId String
  dia         Int // día 1, 2, 3… de fermentación
  fecha       DateTime @default(now())
  tempC       Decimal? @db.Decimal(5, 2)
  volteo      Boolean  @default(false)
  phMasa      Decimal? @db.Decimal(4, 2)
  notas       String?
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([tenantId, beneficioId])
}

/// Configuración de alertas del módulo Cacao por tenant (ADR-128 v4). Un registro
/// por tenant (tenantId = PK). Umbrales que disparan alertas en la UI + el cron.
model CacaoConfig {
  tenantId          String   @id
  precioAlertaPenKg Decimal? @db.Decimal(10, 2) // avisar si la ref. de mercado supera S//kg
  stockMinimoKg     Decimal? @db.Decimal(12, 2) // avisar si el stock disponible baja de esto
  fermDiasAlerta    Int      @default(7) // días en fermentación que disparan atención
  humedadMaxPct     Decimal  @default(7.5) @db.Decimal(5, 2) // humedad meta (NTP ≤ 7.5%)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

/// Libro de Reclamaciones Virtual (ADR-129). Platform-level: el Libro es de la
/// plataforma, no de un tenant (endpoint público sin tenantId). `numero` =
/// correlativo legal (D.S. 011-2011-PCM); `codigo` = LR-AAAA-NNNNNN derivado.
model Reclamo {
  id     String  @id @default(cuid())
  numero Int     @unique @default(autoincrement())
  codigo String? @unique

  // ── Identificación del consumidor ──
  nombre          String
  tipoDocumento   String
  numeroDocumento String
  domicilio       String
  telefono        String
  email           String
  esMenor         Boolean @default(false)
  apoderado       String?

  // ── Identificación del bien contratado ──
  tipoBien        String
  montoReclamado  Decimal? @db.Decimal(12, 2)
  descripcionBien String
  numeroPedido    String?
  tienda          String?
  tenantId        String?

  // ── Detalle de la reclamación ──
  tipoReclamo      String
  detalle          String
  pedidoConsumidor String

  // ── Gestión / respuesta del proveedor ──
  estado       String    @default("pendiente")
  respuesta    String?
  respondidoEn DateTime?

  // ── Auditoría / retención (>= 2 años) ──
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([estado])
  @@index([email])
  @@index([tenantId])
}

// ── Activos & Maquinaria (MVP — Brandon 2026-06-06) ──────────────────────────
// Para negocios que ALQUILAN equipos (forestal: cargador, oruga, camión,
// excavadora). Cada activo genera renta (AssetIncome) y acumula costos
// (AssetExpense: combustible, mantenimiento). La rentabilidad por máquina =
// SUM(incomes) - SUM(expenses), calculada en la DB class. Sin FK a Tenant
// (solo tenantId + índice) — mismo patrón que ProviderComplaint.
model Asset {
  id                String             @id @default(cuid())
  tenantId          String
  name              String // "Cargador frontal CAT 938"
  type              String // cargador|oruga|camion|excavadora|tractor|otro
  plate             String? // placa o número de serie
  imageUrl          String?
  purchaseValue     Decimal?           @db.Decimal(14, 2)
  status            String             @default("operativo") // operativo|mantenimiento|parado
  hourlyRate        Decimal?           @db.Decimal(12, 2) // tarifa de alquiler
  rateUnit          String             @default("hora") // hora|dia|m3|viaje
  // Capacidad operativa por día (horas/unidades disponibles) — denominador de
  // la UTILIZACIÓN. Default 8 (jornada típica). Brandon 2026-06-06.
  capacityPerDay    Int?               @default(8)
  // Horómetro actual del equipo (lectura más reciente) — utilización exacta.
  currentHours      Decimal?           @db.Decimal(12, 1)
  // Meta de consumo de combustible (galones por unidad) — base de la alerta.
  fuelTargetPerUnit Decimal?           @db.Decimal(12, 3)
  notes             String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  incomes           AssetIncome[]
  expenses          AssetExpense[]
  maintenances      AssetMaintenance[]
  inspections       AssetInspection[]

  @@index([tenantId, active])
  @@index([tenantId, status])
}

model AssetIncome {
  id        String    @id @default(cuid())
  tenantId  String
  assetId   String
  date      DateTime  @default(now())
  client    String? // cliente que alquiló
  quantity  Decimal?  @db.Decimal(10, 2) // horas/días/m³/viajes
  unit      String    @default("hora")
  rate      Decimal   @db.Decimal(12, 2) // tarifa aplicada
  amount    Decimal   @db.Decimal(14, 2) // total
  hourStart Decimal?  @db.Decimal(12, 1) // horómetro inicial
  hourEnd   Decimal?  @db.Decimal(12, 1) // horómetro final
  // Cobranza (cuentas por cobrar) — pagado/pendiente + vencimiento.
  paid      Boolean   @default(true)
  paidAt    DateTime?
  dueDate   DateTime?
  // Rango del alquiler (calendario de disponibilidad). Si null, usa `date`.
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, paid])
  @@index([assetId])
}

model AssetExpense {
  id        String   @id @default(cuid())
  tenantId  String
  assetId   String
  date      DateTime @default(now())
  category  String   @default("combustible") // combustible|mantenimiento|repuesto|operador|peaje|otro
  gallons   Decimal? @db.Decimal(10, 2) // si es combustible
  unitPrice Decimal? @db.Decimal(10, 2) // precio por galón
  amount    Decimal  @db.Decimal(14, 2) // total del gasto
  notes     String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([assetId, category])
}

// Mantenimiento preventivo programado por máquina (por horas o por fecha).
// Brandon 2026-06-06 — feature reforzada Activos.
model AssetMaintenance {
  id            String    @id @default(cuid())
  tenantId      String
  assetId       String
  title         String // "Cambio de aceite", "Engrase", "Filtros"
  intervalHours Int? // cada N horas de horómetro
  intervalDays  Int? // o cada N días
  lastDoneHours Decimal?  @db.Decimal(12, 1) // horómetro del último servicio
  lastDoneAt    DateTime? // fecha del último servicio
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId])
}

// Checklist de inspección pre/post alquiler (salida|retorno). itemsJson guarda
// los ítems marcados. Brandon 2026-06-06.
model AssetInspection {
  id        String   @id @default(cuid())
  tenantId  String
  assetId   String
  kind      String   @default("salida") // salida|retorno
  client    String?
  hours     Decimal? @db.Decimal(12, 1) // horómetro al momento de la inspección
  itemsJson String? // JSON: [{ label, ok }]
  notes     String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId])
}

// ─── La Junta del Barrio (compra colaborativa vecinal) ───────────────────────
// Fase A1: fundación social. Los vecinos de una zona juntan pedidos; al llegar
// a la meta, en Fase A2 desbloquean envío gratis. El estado EXPIRED se infiere
// on-read en A1 (sin cron). Ver docs/superpowers/plans/2026-06-18-junta-del-barrio-a1.md
enum JuntaStatus {
  OPEN
  COMPLETE
  EXPIRED
}

model Junta {
  id            String        @id @default(cuid())
  tenantId      String
  code          String // slug corto compartible (ej. "BARRIO-7F3X")
  initiatorId   String // customerId (phone normalizado) que la abrió
  productLabel  String? // contexto opcional ("Arroz 5kg", etc.)
  zoneLabel     String // zona de entrega (label, NO FK en A1)
  windowEnd     DateTime // cutoff: cuándo deja de aceptar miembros
  targetMembers Int           @default(4)
  status        JuntaStatus   @default(OPEN)
  couponCode    String? // cupón emitido al completar la junta (Fase A2)
  createdAt     DateTime      @default(now())
  members       JuntaMember[]

  @@unique([tenantId, code])
  @@index([tenantId, status, zoneLabel])
}

model JuntaMember {
  id         String   @id @default(cuid())
  juntaId    String
  customerId String // phone normalizado
  orderId    String? // se liga en checkout (Fase A2)
  joinedAt   DateTime @default(now())
  junta      Junta    @relation(fields: [juntaId], references: [id], onDelete: Cascade)

  @@unique([juntaId, customerId])
  @@index([juntaId])
}

// Estado de contacto de activación por tienda (Activación v2 #10 — Brandon
// 2026-06-19). Persiste "marcar contactada / posponer" para no re-empujar.
// PK = slug del tenant. Plataforma (no tenant-scoped).
model OnboardingContact {
  tenantSlug   String    @id
  status       String    @default("none") // none | contacted | snoozed
  snoozedUntil DateTime?
  note         String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Estado por alerta del superadmin (Centro de alertas v2 — Brandon 2026-06-19).
// Persiste reconocer/posponer/resolver. La PK es el id ESTABLE de la alerta que
// genera el motor (lib/superadmin/alert-rules): trial-<slug>, sla, churn-<slug>,
// ticket-<id>, payments-pending, etc. Plataforma (no tenant-scoped).
model AlertState {
  alertId      String    @id
  status       String    @default("open") // open | snoozed | resolved
  snoozedUntil DateTime?
  note         String?
  updatedBy    String? // username del superadmin
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}
