// ─── AI Assistant — Conversation Memory ──────────────────
// Multi-turn conversation history for AI assistant (support + coaching).
// Allows the AI to remember context across multiple messages.
model AIConversation {
  id        String      @id @default(cuid())
  tenantId  String // Required — multi-tenant isolation
  user      String // Username of the user who started this conversation
  channel   String      @default("assistant") // "assistant", "coach", "whatsapp"
  title     String      @default("") // Auto-generated from first message or user-provided
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
