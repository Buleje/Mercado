  puntoLlegada          String
  status                GuiaStatus         @default(BORRADOR)
  pesoTotal             Decimal?           @db.Decimal(10, 3)
  pesoBruto             Decimal?           @db.Decimal(10, 3)
  notas                 String?
  createdBy             String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
