# ─── Preview / Staging Environment Variables ───────────────────────────────
# Copy to Vercel → Settings → Environment Variables → Preview
# These override production values for preview deployments (PR branches)

# ── App ──
NEXT_PUBLIC_BASE_URL=https://preview.bodegasanmartin.cl
NEXT_PUBLIC_ENV=preview

# ── Database (use a separate staging DB or branch) ──
# DATABASE_URL=postgresql://user:pass@host:6543/staging_db?pgbouncer=true
# DIRECT_URL=postgresql://user:pass@host:5432/staging_db

# ── Stripe (use TEST mode keys) ──
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...
# STRIPE_PRICE_PRO=price_test_...
# STRIPE_PRICE_BUSINESS=price_test_...
# STRIPE_PRICE_ENTERPRISE=price_test_...

# ── Auth ──
# SUPERADMIN_USER=(same as prod or separate)
# SUPERADMIN_PASS=(separate password for preview)

# ── Email (disable in preview or use test SMTP) ──
# SMTP_USER=
# SMTP_PASS=

# ── Sentry (optional separate DSN for preview) ──
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ── Feature flags for preview ──
# ENABLE_CRONS=false
