#!/usr/bin/env sh
# post-commit — (opcional) dispara vitest en background tras cada commit.
#
# Desde 2026-04-17: vitest post-commit es OPT-IN, no default.
# Razón: los tests ya corren en CI al push/PR. Correrlos también local en
# background gasta memoria/CPU y enlentece el commit (5-15s por commit,
# peor con bulk commits). Activar solo para sesiones que lo necesiten.
#
# Habilitar: `HUSKY_RUN_POSTCOMMIT_TESTS=1 git commit ...`
# o export HUSKY_RUN_POSTCOMMIT_TESTS=1 en la shell.
# Bypass global (emergencia): `HUSKY=0 git commit ...`

if [ "${HUSKY_SKIP_POSTCOMMIT:-0}" = "1" ]; then
  exit 0
fi

if [ "${HUSKY_RUN_POSTCOMMIT_TESTS:-0}" != "1" ]; then
  # Default: skip vitest. CI se encarga.
  exit 0
fi

# El hook puede correr desde el parent repo o desde adentro del proyecto.
# Igual que el pre-commit: intenta entrar y sigue sin error si ya estamos
# dentro (bodega-san-martin es su propio git repo).
cd bodega-san-martin 2>/dev/null || true

# Solo correr si hay archivos TS/TSX tocados en el último commit.
CHANGED_TS=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -E '\.(ts|tsx)$' || true)
if [ -z "$CHANGED_TS" ]; then
  echo "ℹ️  post-commit: sin cambios TS — skip de vitest"
  exit 0
fi

LOG=".husky/.last-test-run.log"
FAIL_MARK=".husky/.last-test-run.FAILED"
rm -f "$FAIL_MARK"

echo "🧪 post-commit: corriendo vitest en background (log: bodega-san-martin/$LOG)"

# Nohup + disown para que sobreviva al cierre del shell de git.
# Si vitest termina con !=0, dejamos el marcador de fallo.
(
  if npm run test -- --reporter=dot >"$LOG" 2>&1; then
    echo "✅ post-commit: vitest OK ($(date '+%H:%M:%S'))" >> "$LOG"
  else
    echo "❌ post-commit: vitest FALLÓ ($(date '+%H:%M:%S'))" >> "$LOG"
    touch "$FAIL_MARK"
  fi
) >/dev/null 2>&1 &

disown 2>/dev/null || true

# Showcase auto — generar contenido para commits feat: o BREAKING CHANGE
COMMIT_MSG=$(git log -1 --format="%s" HEAD 2>/dev/null || true)
if echo "$COMMIT_MSG" | grep -qE '^feat:|BREAKING CHANGE'; then
  echo "🎯 post-commit: commit califica para showcase-auto (feat/BREAKING)"
  # El skill se dispara en la próxima sesión Claude, no en el hook
  touch ".husky/.showcase-auto-pending"
fi

exit 0
