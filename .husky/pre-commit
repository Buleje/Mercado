#!/usr/bin/env sh
cd bodega-san-martin 2>/dev/null || true

# 1. Lint-staged: ESLint fix on staged .ts/.tsx files
npx lint-staged || exit 1

# 2. Type gate (closes TD-026): fail fast if tsc has any errors.
#    Only runs when TypeScript-related files are staged. Doc-only or
#    config-only commits skip this entirely (instant commit).
#    Uses incremental cache (tsconfig.tsbuildinfo) — warm run ~10s,
#    cold run ~85s (first time after clone or after nuking .tsbuildinfo).
#    Emergency bypass: `HUSKY=0 git commit` for true hotfixes only.
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|mts|cts)$' || true)
if [ -z "$STAGED_TS" ]; then
  echo "✅ No TypeScript files staged — skipping tsc gate"
  exit 0
fi

echo "🔎 Running tsc --noEmit (TD-026 gate)..."
echo "   Staged TS files: $(echo "$STAGED_TS" | wc -l | tr -d ' ')"
npx tsc --noEmit || {
  echo ""
  echo "❌ TypeScript errors detected. Fix them before committing."
  echo "   Run \`npx tsc --noEmit\` locally to see the full list."
  echo "   Emergency bypass: HUSKY=0 git commit ..."
  exit 1
}
echo "✅ tsc clean"

# 3. Delta check: block NEW empty .catch() in staged files.
#    Existing ones are being cleaned up — this gate prevents adding more.
EMPTY_CATCHES=$(git diff --cached --diff-filter=ACMR -U0 -- '*.ts' '*.tsx' | grep -E '^\+.*\.catch\(\s*(\(\s*\w*\s*\))?\s*=>\s*\{\s*\}\s*\)' || true)
if [ -n "$EMPTY_CATCHES" ]; then
  echo ""
  echo "❌ New empty .catch(() => {}) detected in staged changes:"
  echo "$EMPTY_CATCHES"
  echo ""
  echo "   Use: .catch((err) => logger.error('[ctx] failed', { error: String(err) }))"
  echo "   Emergency bypass: HUSKY=0 git commit ..."
  exit 1
fi
echo "✅ No new empty .catch()"
