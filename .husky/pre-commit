#!/usr/bin/env sh
cd bodega-san-martin 2>/dev/null || true

# Aumentar heap de Node para que eslint-workers no disparen SIGKILL en bulk
# commits (>100 archivos staged). Sin esto, lint-staged muere con OOM y
# forza a usar --no-verify. Default 4GB → 8GB resuelve hasta ~500 archivos
# simultáneos. Fuente del problema: ADR-075 Sprint A/B/C bulk migrations.
export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=8192"

# 0. Empty-file gate: block commits that stage 0-byte source/content files.
#    Prevents regressions like QuickAddDrawer.tsx (empty stub pushed a layout
#    import that crashed /marketplace/explorar with "Element type is invalid").
#    Cubre: código (ts/tsx/js/mjs/cjs), data (json/yml/yaml), docs (md),
#    estilos (css) y schemas (prisma).
#    Emergency bypass: HUSKY=0 git commit ...
EMPTY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|md|mdx|yml|yaml|css|scss|prisma)$' | while read -r f; do
  if [ -f "$f" ] && [ ! -s "$f" ]; then echo "$f"; fi
done)
if [ -n "$EMPTY_FILES" ]; then
  echo ""
  echo "❌ Empty source files staged (0 bytes) — commit blocked:"
  echo "$EMPTY_FILES" | sed 's/^/   - /'
  echo ""
  echo "   Either implement them or \`git rm\` before committing."
  echo "   Emergency bypass: HUSKY=0 git commit ..."
  exit 1
fi

# 1. Lint-staged: ESLint fix on staged .ts/.tsx files
npx lint-staged || exit 1

# 2. Type gate (closes TD-026): fail fast if tsc has any errors.
#    Only runs when TypeScript-related files are staged. Doc-only or
#    config-only commits skip this entirely (instant commit).
#    Uses incremental cache (tsconfig.tsbuildinfo) — warm run ~10s,
#    cold run ~85s (first time after clone or after nuking .tsbuildinfo).
#    Emergency bypass: `HUSKY=0 git commit` for true hotfixes only.
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|mts|cts)$' || true)
if [ -z "$STAGED_TS" ]; then
  echo "✅ No TypeScript files staged — skipping tsc gate"
  exit 0
fi

echo "🔎 Running tsc --noEmit (TD-026 gate)..."
echo "   Staged TS files: $(echo "$STAGED_TS" | wc -l | tr -d ' ')"
npx tsc --noEmit || {
  echo ""
  echo "❌ TypeScript errors detected. Fix them before committing."
  echo "   Run \`npx tsc --noEmit\` locally to see the full list."
  echo "   Emergency bypass: HUSKY=0 git commit ..."
  exit 1
}
echo "✅ tsc clean"

# 2a. Danger-zone skills integrity: si algún skill referenciado en el hook
#     danger-zone.mjs no existe como .instructions.md, el gate falla. Evita
#     que el hook bloquee edits con "skill path not found" en otra sesión.
node scripts/check-zone-skills.mjs || {
  echo ""
  echo "❌ Falta algún skill .instructions.md referenciado por danger-zone.mjs."
  echo "   Corre \`npm run dev:dangers:check\` para ver cuál."
  exit 1
}

# 2b. Vitest --changed: corre SOLO los tests afectados por archivos staged.
#     Usa resolución de dependencias de Vitest — si tocas `hooks/x.ts`, corre
#     los tests que importan ese archivo (directa o transitivamente).
#     Ventana <5s cuando no hay cambios que afecten tests. Escape válvula:
#     SKIP_VITEST_GATE=1 para tests conocidamente flakey en un commit puntual.
#     Atrapa bugs que tsc NO captura: lógica runtime, React state, etc.
if [ "${SKIP_VITEST_GATE:-0}" != "1" ]; then
  echo "🧪 Running vitest --changed (fast related-tests gate)..."
  npx vitest run --changed HEAD --passWithNoTests || {
    echo ""
    echo "❌ Tests related to staged changes failed."
    echo "   Run \`npx vitest run --changed HEAD\` locally to debug."
    echo "   Skip gate for this commit: SKIP_VITEST_GATE=1 git commit ..."
    exit 1
  }
  echo "✅ related tests pass"
fi

# 3. Delta check: block NEW empty .catch() in staged files.
#    Existing ones are being cleaned up — this gate prevents adding more.
EMPTY_CATCHES=$(git diff --cached --diff-filter=ACMR -U0 -- '*.ts' '*.tsx' | grep -E '^\+.*\.catch\(\s*(\(\s*\w*\s*\))?\s*=>\s*\{\s*\}\s*\)' || true)
if [ -n "$EMPTY_CATCHES" ]; then
  echo ""
  echo "❌ New empty .catch(() => {}) detected in staged changes:"
  echo "$EMPTY_CATCHES"
  echo ""
  echo "   Use: .catch((err) => logger.error('[ctx] failed', { error: String(err) }))"
  echo "   Emergency bypass: HUSKY=0 git commit ..."
  exit 1
fi
echo "✅ No new empty .catch()"

# 4. Design tokens gate (ADR-068): block decorative gradients/shadows in admin + store.
#    Only scans staged files — fast (<2s). Whitelist in scripts/lint-design-tokens.ts.
#    Emergency bypass: HUSKY=0 git commit ...
STAGED_UI=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(components/(admin|store)|app/t)/' | grep -E '\.(tsx|ts)$' || true)
if [ -n "$STAGED_UI" ]; then
  echo "🎨 Running design-tokens gate (ADR-068)..."
  npx tsx scripts/lint-design-tokens.ts --staged || {
    echo ""
    echo "❌ Design token violations detected (ADR-068 armonia)."
    echo "   Fix or add to whitelist in scripts/lint-design-tokens.ts."
    echo "   Emergency bypass: HUSKY=0 git commit ..."
    exit 1
  }
  echo "✅ Design tokens clean"

  # 5. Design-strict preview (ADR-075 Sprint D6): show warnings for DS adoption.
  #    Non-blocking — purely informational. Cuando el residuo global baje de
  #    100 warnings (Sprint E+), promoveremos a `|| exit 1`.
  echo "🎨 Running design-strict preview (ADR-075 Sprint D6 — warnings only)..."
  npx tsx scripts/lint-design-tokens.ts --staged --design-strict || true
fi
